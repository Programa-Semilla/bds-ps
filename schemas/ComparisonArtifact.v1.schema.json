{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capital-semilla.local/schemas/ComparisonArtifact.v1.json",
  "title": "ComparisonArtifact",
  "description": "Versioned output of the AI quote-comparison pipeline. Validated server-side by the comparator stage; invalid responses fail the run.",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "v1"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Item" }
    }
  },
  "$defs": {
    "Item": {
      "type": "object",
      "required": ["header", "suppliers", "attributeRows", "narrativeSections"],
      "additionalProperties": false,
      "properties": {
        "header": {
          "type": "string",
          "minLength": 1,
          "description": "Item label rendered above the table, e.g. 'Ficha 3'."
        },
        "suppliers": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/SupplierColumn" }
        },
        "attributeRows": {
          "type": "array",
          "items": { "$ref": "#/$defs/AttributeRow" }
        },
        "narrativeSections": {
          "type": "array",
          "items": { "$ref": "#/$defs/NarrativeSection" }
        }
      }
    },
    "SupplierColumn": {
      "type": "object",
      "required": ["supplierId", "supplierName"],
      "additionalProperties": false,
      "properties": {
        "supplierId": { "type": "string", "format": "uuid" },
        "supplierName": { "type": "string", "minLength": 1 },
        "branchName": { "type": ["string", "null"] },
        "verificationStatus": {
          "type": "string",
          "enum": ["Draft", "PendingReview", "Verified", "Rejected"]
        }
      }
    },
    "AttributeRow": {
      "type": "object",
      "required": ["label", "cells"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "cells": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/AttributeCell" }
        }
      }
    },
    "AttributeCell": {
      "type": "object",
      "required": ["supplierIdx", "value"],
      "additionalProperties": false,
      "properties": {
        "supplierIdx": {
          "type": "integer",
          "minimum": 0,
          "description": "Index into the parent item's `suppliers` array."
        },
        "value": {
          "type": ["string", "null"],
          "description": "Rendered value. Empty string is allowed; null means no data."
        },
        "discrepancy": {
          "type": ["object", "null"],
          "required": ["dbValue", "fileValue"],
          "additionalProperties": false,
          "properties": {
            "dbValue": { "type": ["string", "null"] },
            "fileValue": { "type": ["string", "null"] }
          },
          "description": "Set when structured DB and extracted file values diverge. Both are surfaced; comparator narrative explains."
        },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/SourceRef" }
        }
      }
    },
    "NarrativeSection": {
      "type": "object",
      "required": ["title", "body"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "body": { "type": "string", "minLength": 1 },
        "sourceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/SourceRef" }
        }
      }
    },
    "SourceRef": {
      "type": "object",
      "required": ["supplierIdx", "blobId"],
      "additionalProperties": false,
      "properties": {
        "supplierIdx": {
          "type": "integer",
          "minimum": 0
        },
        "blobId": {
          "type": "string",
          "format": "uuid",
          "description": "Object-storage blob identifier; resolved to a signed URL by GET /Review/Citations/{artifactId}/{sourceRefId}."
        },
        "page": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "label": {
          "type": ["string", "null"],
          "description": "Short label rendered in citation tooltip (typically 'Supplier — file.pdf')."
        }
      }
    }
  }
}
