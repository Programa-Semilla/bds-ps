# Copy to .env on the VM and fill in. NEVER commit the real .env.
#   cp .env.example .env && nano .env

# Domain Caddy serves + the app's CTA base URL.
APP_DOMAIN=capitalsemilla-dev.programasemilla.com

# Let's Encrypt registration/recovery email.
ACME_EMAIL=danny.perez.u@gmail.com

# --- Attachments storage ---
# AzureBlob (default, durable, cheap) or LocalFilesystem (files on the VM disk).
STORAGE_PROVIDER=AzureBlob
# Managed identity (recommended — no secret): the blob endpoint URI that
# provision-storage.sh prints.
#   BLOB_CONNECTION=https://<account>.blob.core.windows.net
# Or account key (simpler, no role setup): a full connection string.
#   BLOB_CONNECTION=DefaultEndpointsProtocol=https;AccountName=<acct>;AccountKey=<key>;EndpointSuffix=core.windows.net
BLOB_CONNECTION=

# SQL Server SA password. Must satisfy SQL complexity (>=8 chars, upper+lower+digit+symbol).
MSSQL_SA_PASSWORD=ChangeMe_Strong1!

# App admin sentinel password (Admin:DefaultPassword).
ADMIN_DEFAULT_PASSWORD=ChangeMe_Admin1!

# Syncfusion license key (required for PDF generation at runtime).
SYNCFUSION_LICENSE_KEY=Ngo9BigBOggjHTQxAR8/V1JHaF1cXmhMYVJpR2NbeU5xdF9DZVZURGY/P1ZhSXxVdkFhXX1cdXFQRmJVU019XEE=

# --- Optional: email notifications (default off = NoOp) ---
# NOTIFICATIONS_PROVIDER=Mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# NOTIFICATIONS_SENDER_EMAIL=no-reply@programa-semilla.cr

# --- AI quote comparison (spec 020) ---
# Provider defaults to Stub (no key, fake comparison output) so the app runs
# keyless. For REAL comparisons set both:
#   AI_PROVIDER=Anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=Stub
# ANTHROPIC_API_KEY=

# --- Optional: Aspire Dashboard telemetry export ---
# Empty = no export (default). To view logs/traces in the dashboard, set this
# and start it: docker compose --profile debug up -d aspire-dashboard
# OTEL_ENDPOINT=http://aspire-dashboard:18889
