# Copy to .env on the VM and fill in. NEVER commit the real .env.
#   cp .env.example .env && nano .env

# Domain Caddy serves + the app's CTA base URL.
APP_DOMAIN=capitalsemilla-dev.programasemilla.com

# Let's Encrypt registration/recovery email.
ACME_EMAIL=danny.perez.u@gmail.com

# SQL Server SA password. Must satisfy SQL complexity (>=8 chars, upper+lower+digit+symbol).
MSSQL_SA_PASSWORD=ChangeMe_Strong1!

# App admin sentinel password (Admin:DefaultPassword).
ADMIN_DEFAULT_PASSWORD=ChangeMe_Admin1!

# Syncfusion license key (required for PDF generation at runtime).
SYNCFUSION_LICENSE_KEY=Ngo9BigBOggjHTQxAR8/V1JHaF1cXmhMYVJpR2NbeU5xdF9DZVZURGY/P1ZhSXxVdkFhXX1cdXFQRmJVU019XEE=

# --- Optional: email notifications (default off = NoOp) ---
# NOTIFICATIONS_PROVIDER=Mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# NOTIFICATIONS_SENDER_EMAIL=no-reply@programa-semilla.cr

