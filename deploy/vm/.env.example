# Copy to .env on the VM and fill in. NEVER commit the real .env.
#   cp .env.example .env && nano .env

# Domain Caddy serves + the app's CTA base URL.
APP_DOMAIN=capitalsemilla-dev.programasemilla.com

# Let's Encrypt registration/recovery email.
ACME_EMAIL=danny.perez.u@gmail.com

# --- Attachments storage ---
# AzureBlob (default, durable, cheap) or LocalFilesystem (files on the VM disk).
STORAGE_PROVIDER=AzureBlob
# Managed identity (recommended — no secret): the blob endpoint URI that
# provision-storage.sh prints.
#   BLOB_CONNECTION=https://<account>.blob.core.windows.net
# Or account key (simpler, no role setup): a full connection string.
#   BLOB_CONNECTION=DefaultEndpointsProtocol=https;AccountName=<acct>;AccountKey=<key>;EndpointSuffix=core.windows.net
BLOB_CONNECTION=

# SQL Server SA password. Must satisfy SQL complexity (>=8 chars, upper+lower+digit+symbol).
MSSQL_SA_PASSWORD=ChangeMe_Strong1!

# App admin sentinel password (Admin:DefaultPassword).
ADMIN_DEFAULT_PASSWORD=ChangeMe_Admin1!

# Syncfusion license key (required for PDF generation at runtime).
SYNCFUSION_LICENSE_KEY=Ngo9BigBOggjHTQxAR8/V1JHaF1cXmhMYVJpR2NbeU5xdF9DZVZURGY/P1ZhSXxVdkFhXX1cdXFQRmJVU019XEE=

# --- Optional: email notifications (default off = NoOp) ---
# Sending domain is mg.capitalsemilla.info (SPF + DKIM + MX + tracking CNAME
# verified in Mailgun). Pick ONE of the two transports below.
#
# (a) SMTP — uses the domain's SMTP login/password from the Mailgun dashboard
#     (Sending > Domain settings > SMTP credentials). "Mailtrap" is the spec-021
#     switch value for the generic MailKit SMTP sender, not a Mailtrap account.
# NOTIFICATIONS_PROVIDER=Mailtrap
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=info@mg.capitalsemilla.info
# SMTP_PASSWORD=
#
# (b) Mailgun HTTP API — needs a *Sending API key* (Mailgun dashboard >
#     API keys). NOT the SMTP password; the API rejects it with 401.
#     Preferred long-term: richer error classification and no SMTP egress.
# NOTIFICATIONS_PROVIDER=Mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.capitalsemilla.info
# MAILGUN_BASE_URL=https://api.mailgun.net/v3   # EU accounts: https://api.eu.mailgun.net/v3
#
# Shared by both transports. Sender email must be on the verified domain.
# NOTIFICATIONS_SENDER_EMAIL=no-reply@mg.capitalsemilla.info
# NOTIFICATIONS_SENDER_NAME=Programa Semilla / Sistema de Banca para el Desarrollo
#
# NOTE: this VM runs ASPNETCORE_ENVIRONMENT=Production, so the non-prod
# recipient allowlist is bypassed — every notification reaches its real
# recipient as soon as the provider is switched on.

# --- AI quote comparison (spec 020) ---
# Provider defaults to Stub, which is a TEST-ONLY provider: it replays canned
# fixtures from tests/Fixtures/AiComparison/, and that tree is deliberately not
# shipped in the image. On a deployed VM the Stub therefore cannot produce
# output — every generation fails with provider_hard:stub_fixture_missing and
# the reviewer sees "Generación falló. Contacte un administrador."
# Deployed environments MUST set both:
#   AI_PROVIDER=Anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
# AI_PROVIDER=Stub
# ANTHROPIC_API_KEY=

# --- Ybug feedback widget (temporary) ---
# Rendered only on deployed environments (the view also requires
# ASPNETCORE_ENVIRONMENT != Development, so local + E2E runs never load it).
# Defaults to the project's widget id in docker-compose.yml; set this to an empty
# value to switch the widget off without a code change, then redeploy.
# YBUG_ID=

# --- Optional: Aspire Dashboard telemetry export ---
# Empty = no export (default). To view logs/traces in the dashboard, set this
# and start it: docker compose --profile debug up -d aspire-dashboard
# OTEL_ENDPOINT=http://aspire-dashboard:18889
