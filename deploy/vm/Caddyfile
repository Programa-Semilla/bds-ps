# Automatic HTTPS via Let's Encrypt. Caddy obtains + renews the cert for the
# domain below as long as the public DNS A record points at this VM and ports
# 80/443 are open. No manual certs, no Azure managed-cert dance.

{
	email {$ACME_EMAIL}
}

capitalsemilla-dev.programasemilla.com {
	encode zstd gzip
	# Caddy terminates TLS and forwards plain HTTP to the app on the compose network.
	# The app trusts X-Forwarded-* because ASPNETCORE_FORWARDEDHEADERS_ENABLED=true.
	reverse_proxy webapp:8080
}
