@model FundingPlatform.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_AuthLayout";
}

<h1 class="fl-auth-headline">Iniciar sesión</h1>
@* Spec 021 / FR-030 — replaced "Bienvenido —" with neutral copy. *@
<p class="fl-text-secondary mb-4">Ingresa tus datos para continuar.</p>

<form asp-action="Login" asp-controller="Account" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="fl-text-danger mb-3"></div>

    <div class="mb-3" data-testid="form-section" data-field="Email">
        <label asp-for="Email" class="form-label fl-type-meta"></label>
        <input asp-for="Email" class="fl-input" autocomplete="username" />
        <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
    </div>

    <div class="mb-3" data-testid="form-section" data-field="Password">
        <label asp-for="Password" class="form-label fl-type-meta"></label>
        <div class="input-group">
            <input asp-for="Password" type="password" class="fl-input form-control"
                   id="login-password"
                   autocomplete="current-password" />
            @await Html.PartialAsync("_PasswordEyeToggle",
                new ViewDataDictionary(ViewData) { { "EyeTarget", "#login-password" } })
        </div>
        <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
    </div>

    <div class="form-footer">
        <button type="submit" class="fl-btn w-100" data-variant="primary">Iniciar sesión</button>
    </div>
</form>

<div class="text-center fl-text-secondary mt-4">
    @* Spec 021 / US5 / T131 / FR-028 — forgot-password entry point on the login surface. *@
    <a asp-action="ForgotPassword" asp-controller="Account" class="fl-text-brand"
       data-testid="forgot-password-link">¿Olvidó su contraseña?</a>
</div>
<div class="text-center fl-text-secondary mt-2">
    ¿Aún no tienes cuenta? <a asp-action="Register" asp-controller="Account" class="fl-text-brand">Crea una aquí</a>
</div>

@section Scripts {
    <script type="module" src="~/js/password-eye-toggle.js" asp-append-version="true" defer></script>
}
