@using FundingPlatform.Domain.Enums
@using FundingPlatform.Web.ViewModels
@model FundingPlatform.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_AuthLayout";
}

<h1 class="fl-auth-headline">Crea tu cuenta</h1>
@* Spec 021 / FR-030 — replaced "Bienvenido —" with neutral copy. *@
<p class="fl-text-secondary mb-4">Solo necesitamos algunos datos para empezar.</p>

<form asp-action="Register" asp-controller="Account" method="post" novalidate>
    <div asp-validation-summary="ModelOnly" class="fl-text-danger mb-3"></div>

    <div class="mb-3" data-testid="form-section" data-field="Email">
        <label asp-for="Email" class="form-label fl-type-meta"></label> @await Html.PartialAsync("_RequiredMark") @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(ResourceKeyOverride: "Register.Email"))
        <input asp-for="Email" class="fl-input" autocomplete="email" />
        <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
    </div>

    <div class="mb-3" data-testid="form-section" data-field="Password">
        <label asp-for="Password" class="form-label fl-type-meta"></label> @await Html.PartialAsync("_RequiredMark") @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(ResourceKeyOverride: "Register.Password"))
        <div class="input-group">
            <input asp-for="Password" type="password" class="fl-input form-control"
                   id="register-password"
                   autocomplete="new-password"
                   data-strength-legend="#register-strength-legend" />
            @await Html.PartialAsync("_PasswordEyeToggle",
                new ViewDataDictionary(ViewData) { { "EyeTarget", "#register-password" } })
        </div>
        <span asp-validation-for="Password" class="invalid-feedback d-block"></span>
        @await Html.PartialAsync("_PasswordStrengthLegend",
            new ViewDataDictionary(ViewData) { { "LegendId", "register-strength-legend" } })
    </div>

    <div class="mb-3" data-testid="form-section" data-field="ConfirmPassword">
        <label asp-for="ConfirmPassword" class="form-label fl-type-meta"></label> @await Html.PartialAsync("_RequiredMark")
        <div class="input-group">
            <input asp-for="ConfirmPassword" type="password" class="fl-input form-control"
                   id="register-confirm-password"
                   autocomplete="new-password" />
            @await Html.PartialAsync("_PasswordEyeToggle",
                new ViewDataDictionary(ViewData) { { "EyeTarget", "#register-confirm-password" } })
        </div>
        <span asp-validation-for="ConfirmPassword" class="invalid-feedback d-block"></span>
    </div>

    <div class="row g-2">
        <div class="col-md-6">
            <div class="mb-3" data-testid="form-section" data-field="FirstName">
                <label asp-for="FirstName" class="form-label fl-type-meta"></label> @await Html.PartialAsync("_RequiredMark") @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(ResourceKeyOverride: "Register.FirstName"))
                <input asp-for="FirstName" class="fl-input" autocomplete="given-name" />
                <span asp-validation-for="FirstName" class="invalid-feedback d-block"></span>
            </div>
        </div>
        <div class="col-md-6">
            <div class="mb-3" data-testid="form-section" data-field="LastName">
                <label asp-for="LastName" class="form-label fl-type-meta"></label> @await Html.PartialAsync("_RequiredMark") @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(ResourceKeyOverride: "Register.LastName"))
                <input asp-for="LastName" class="fl-input" autocomplete="family-name" />
                <span asp-validation-for="LastName" class="invalid-feedback d-block"></span>
            </div>
        </div>
    </div>

    @* Spec 026 — type-aware masked identification (replaces the plain LegalId input). *@
    <div class="mb-3" data-testid="form-section" data-field="LegalId">
        @await Html.PartialAsync("_LegalIdField", new LegalIdFieldModel
        {
            TypeFieldName = nameof(Model.IdentificationType),
            ValueFieldName = nameof(Model.LegalId),
            SelectedType = Model.IdentificationType,
            Value = Model.LegalId,
            AllowedTypes = new[]
            {
                IdentificationType.CedulaFisica,
                IdentificationType.Dimex,
                IdentificationType.Nite,
                IdentificationType.Pasaporte,
            },
            GroupId = "register-legal-id",
            InputCssClass = "fl-input",
            SelectCssClass = "fl-input",
            ValidationCssClass = "invalid-feedback",
        })
    </div>

    <div class="form-footer">
        <button type="submit" class="fl-btn w-100" data-variant="primary">Crear cuenta</button>
    </div>
</form>

<div class="text-center fl-text-secondary mt-4">
    ¿Ya tienes cuenta? <a asp-action="Login" asp-controller="Account" class="fl-text-brand">Inicia sesión</a>
</div>

@section Scripts {
    <script type="module" src="~/js/password-eye-toggle.js" asp-append-version="true" defer></script>
    <script type="module" src="~/js/password-strength-legend.js" asp-append-version="true" defer></script>
    <script src="~/js/input-masks.js" asp-append-version="true" defer></script>
}
