@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
}

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: "Cambiar contraseña",
        Subtitle: "Debe cambiar su contraseña antes de continuar."))

<div class="row mt-3">
    <div class="col-md-6">
        <form asp-action="ChangePassword" asp-controller="Account" method="post" data-testid="change-password-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="OldPassword">Contraseña actual @await Html.PartialAsync("_RequiredMark")</label>
                <div class="input-group">
                    <input asp-for="OldPassword" type="password" class="form-control"
                           id="cp-old-password"
                           autocomplete="current-password" />
                    @await Html.PartialAsync("_PasswordEyeToggle",
                        new ViewDataDictionary(ViewData) { { "EyeTarget", "#cp-old-password" } })
                </div>
                <span asp-validation-for="OldPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="NewPassword">Nueva contraseña @await Html.PartialAsync("_RequiredMark")</label>
                <div class="input-group">
                    <input asp-for="NewPassword" type="password" class="form-control"
                           id="cp-new-password"
                           autocomplete="new-password"
                           data-strength-legend="#cp-strength-legend" />
                    @await Html.PartialAsync("_PasswordEyeToggle",
                        new ViewDataDictionary(ViewData) { { "EyeTarget", "#cp-new-password" } })
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
                @await Html.PartialAsync("_PasswordStrengthLegend",
                    new ViewDataDictionary(ViewData) { { "LegendId", "cp-strength-legend" } })
            </div>
            <div class="mb-3">
                <label class="form-label" asp-for="ConfirmPassword">Confirmar nueva contraseña @await Html.PartialAsync("_RequiredMark")</label>
                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password" class="form-control"
                           id="cp-confirm-password"
                           autocomplete="new-password" />
                    @await Html.PartialAsync("_PasswordEyeToggle",
                        new ViewDataDictionary(ViewData) { { "EyeTarget", "#cp-confirm-password" } })
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary" data-testid="change-password-submit">
                    Cambiar contraseña
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script type="module" src="~/js/password-eye-toggle.js" asp-append-version="true" defer></script>
    <script type="module" src="~/js/password-strength-legend.js" asp-append-version="true" defer></script>
}
