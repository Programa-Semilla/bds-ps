@model FundingPlatform.Web.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "¿Olvidó su contraseña?";
    Layout = "_AuthLayout";
}

@* Spec 021 / US5 / T128 / FR-028 — forgot-password form. POST always returns
   the same neutral view + TempData success banner regardless of whether the
   email is on file (no enumeration). *@

<h1 class="fl-auth-headline">¿Olvidó su contraseña?</h1>
<p class="fl-text-secondary mb-4">
    Ingrese su correo electrónico y, si la dirección está registrada, le
    enviaremos un enlace de un solo uso para restablecer su contraseña.
</p>

<form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate
      data-testid="forgot-password-form">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="fl-text-danger mb-3"></div>

    <div class="mb-3" data-testid="form-section" data-field="Email">
        <label asp-for="Email" class="form-label fl-type-meta"></label>
        <input asp-for="Email" class="fl-input" autocomplete="email"
               data-testid="forgot-password-email" />
        <span asp-validation-for="Email" class="invalid-feedback d-block"></span>
    </div>

    <div class="form-footer">
        <button type="submit" class="fl-btn w-100" data-variant="primary"
                data-testid="forgot-password-submit">
            Enviar enlace
        </button>
    </div>
</form>

<div class="text-center fl-text-secondary mt-4">
    <a asp-action="Login" asp-controller="Account" class="fl-text-brand">Volver al inicio de sesión</a>
</div>
