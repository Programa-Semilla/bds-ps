@model FundingPlatform.Web.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
    Layout = "_AuthLayout";
    var invalidLink = ViewData["InvalidLink"] as bool? ?? false;
}

@* Spec 021 / US5 / T128 / FR-028 — reset-password form.
   Renders the invalid-link message when the GET arrived without a usable
   userId/token pair (single-use + 60-min TTL rejections also surface here
   via ModelState validation messages on POST). *@

@if (invalidLink)
{
    <h1 class="fl-auth-headline">Enlace inválido o expirado</h1>
    <p class="fl-text-secondary mb-4" data-testid="reset-password-invalid">
        Enlace inválido o expirado. Solicite uno nuevo.
    </p>
    <div class="text-center mt-4">
        <a asp-action="ForgotPassword" asp-controller="Account" class="fl-btn" data-variant="primary">
            Solicitar nuevo enlace
        </a>
    </div>
}
else
{
    <h1 class="fl-auth-headline">Restablecer contraseña</h1>
    <p class="fl-text-secondary mb-4">Escoja una nueva contraseña para su cuenta.</p>

    <form asp-action="ResetPassword" asp-controller="Account" method="post" novalidate
          data-testid="reset-password-form">
        @Html.AntiForgeryToken()
        <input asp-for="UserId" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="fl-text-danger mb-3"
             data-testid="reset-password-summary"></div>

        <div class="mb-3" data-testid="form-section" data-field="NewPassword">
            <label asp-for="NewPassword" class="form-label fl-type-meta"></label>
            <div class="input-group">
                <input asp-for="NewPassword" type="password" class="fl-input form-control"
                       id="new-password"
                       autocomplete="new-password"
                       data-testid="reset-password-new"
                       data-strength-legend="#reset-strength-legend" />
                @await Html.PartialAsync("_PasswordEyeToggle",
                    new ViewDataDictionary(ViewData) { { "EyeTarget", "#new-password" } })
            </div>
            <span asp-validation-for="NewPassword" class="invalid-feedback d-block"></span>
            @await Html.PartialAsync("_PasswordStrengthLegend",
                new ViewDataDictionary(ViewData) { { "LegendId", "reset-strength-legend" } })
        </div>

        <div class="mb-3" data-testid="form-section" data-field="ConfirmPassword">
            <label asp-for="ConfirmPassword" class="form-label fl-type-meta"></label>
            <div class="input-group">
                <input asp-for="ConfirmPassword" type="password" class="fl-input form-control"
                       id="confirm-password"
                       autocomplete="new-password"
                       data-testid="reset-password-confirm" />
                @await Html.PartialAsync("_PasswordEyeToggle",
                    new ViewDataDictionary(ViewData) { { "EyeTarget", "#confirm-password" } })
            </div>
            <span asp-validation-for="ConfirmPassword" class="invalid-feedback d-block"></span>
        </div>

        <div class="form-footer">
            <button type="submit" class="fl-btn w-100" data-variant="primary"
                    data-testid="reset-password-submit">
                Restablecer contraseña
            </button>
        </div>
    </form>
}

@section Scripts {
    <script type="module" src="~/js/password-eye-toggle.js" asp-append-version="true" defer></script>
    <script type="module" src="~/js/password-strength-legend.js" asp-append-version="true" defer></script>
}
