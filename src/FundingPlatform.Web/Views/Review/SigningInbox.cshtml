@using FundingPlatform.Domain.Enums
@using FundingPlatform.Web.ViewModels
@model IReadOnlyList<FundingPlatform.Web.ViewModels.SigningInboxRowViewModel>

@{
    ViewData["Title"] = "Bandeja de firmas";
    ViewData["ActiveTab"] = "Signing";
    var page = (int)(ViewData["SigningInbox.Page"] ?? 1);
    var pageSize = (int)(ViewData["SigningInbox.PageSize"] ?? 25);
    var totalCount = (int)(ViewData["SigningInbox.TotalCount"] ?? 0);
    var totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
    // Spec 021 / T119 / FR-024 — per-row stage banner lookup.
    var stageBanners = ViewData["StageBanners"] as Dictionary<int, StageCountdownBannerViewModel>
        ?? new Dictionary<int, StageCountdownBannerViewModel>();
}

@await Html.PartialAsync("_ReviewTabs")

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: "Bandeja de firmas",
        Subtitle: $"{totalCount} convenio(s) firmado(s) pendiente(s) de revisión"))

@if (Model.Count == 0)
{
    <div data-testid="signing-inbox-empty">
        @await Html.PartialAsync("Components/_EmptyState",
            new EmptyStateViewModel(
                Headline: "No hay cargas firmadas pendientes",
                Body: "Los convenios firmados pendientes de aprobación del revisor aparecerán aquí.",
                Icon: "ti ti-signature"))
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="fl-table" data-density="reviewer" data-testid="signing-inbox-table">
                <thead>
                    <tr>
                        <th>Solicitud</th>
                        <th>Solicitante</th>
                        <th>Cargado</th>
                        <th>Coincidencia de versión</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model)
                    {
                        StageCountdownBannerViewModel? stageBanner = null;
                        if (stageBanners.TryGetValue(row.ApplicationId, out var entry))
                        {
                            stageBanner = entry;
                        }
                        <tr data-testid="signing-inbox-row" data-application-id="@row.ApplicationId">
                            <td>
                                N.º @row.ApplicationId
                                @if (stageBanner is not null)
                                {
                                    var remaining = stageBanner.Remaining;
                                    var stageClass = stageBanner.Closed || stageBanner.IsDanger ? "badge bg-danger-lt" : "badge bg-warning-lt";
                                    <div class="mt-1" data-testid="stage-countdown-badge" data-stage-closed="@(stageBanner.Closed ? "true" : "false")">
                                        <span class="@stageClass" data-testid="stage-countdown-text">
                                            @if (stageBanner.Closed)
                                            {
                                                <text>Vencido (@stageBanner.ClosesAt.ToString("dd/MM/yyyy"))</text>
                                            }
                                            else if (remaining < TimeSpan.FromHours(24))
                                            {
                                                <text>Cierra en @remaining.Hours h @remaining.Minutes m</text>
                                            }
                                            else
                                            {
                                                <text>Cierra en @((int)remaining.TotalDays) d @remaining.Hours h</text>
                                            }
                                        </span>
                                    </div>
                                }
                            </td>
                            <td>@row.ApplicantDisplayName</td>
                            <td>@row.UploadedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC</td>
                            <td>
                                @if (row.VersionMatchesCurrent)
                                {
                                    <span class="status status-green"><i class="ti ti-check"></i> Coincide con la actual</span>
                                }
                                else
                                {
                                    <span class="status status-yellow"><i class="ti ti-alert-triangle"></i> Desactualizada (v@row.GeneratedVersionAtUpload)</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-sm btn-outline-primary"
                                   href="@Url.RouteUrl(new { controller = "FundingAgreement", action = "Details", applicationId = row.ApplicationId })">
                                    Abrir
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination">
                @for (var p = 1; p <= totalPages; p++)
                {
                    var classes = p == page ? "page-item active" : "page-item";
                    <li class="@classes">
                        <a class="page-link" href="@Url.Action("SigningInbox", "Review", new { page = p, pageSize })">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
