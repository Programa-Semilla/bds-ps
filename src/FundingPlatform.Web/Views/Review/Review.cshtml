@using FundingPlatform.Domain.Enums
@using FundingPlatform.Domain.ValueObjects
@model FundingPlatform.Web.ViewModels.ReviewApplicationViewModel

@{
    ViewData["Title"] = $"Revisar solicitud N.º {Model.ApplicationId}";
    var appState = Enum.Parse<ApplicationState>(Model.State);
}

<link rel="stylesheet" href="~/css/comparison.css" />

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: $"Revisar solicitud N.º {Model.ApplicationId}",
        Subtitle: Model.ApplicantName))

@* Spec 043 / US4 / FR-010 — non-blocking regulatory-freshness warning (early heads-up before audit). *@
@await Component.InvokeAsync("RegulatoryFreshnessWarning", new { applicationId = Model.ApplicationId })

@if (TempData["ReviewSuccess"] is string reviewOk)
{
    <div class="alert alert-success" data-testid="review-toast-success">@reviewOk</div>
}
@if (TempData["ReviewError"] is string reviewErr)
{
    <div class="alert alert-danger" data-testid="review-toast-error">@reviewErr</div>
}

@if (Model.ShowReviewerChecklist || Model.ShowReturnedFromAudit)
{
    @await Html.PartialAsync("_ReviewerChecklist", Model)
}

@* Spec 046 / US1 — tranche (funding-phase) editor, pre-audit only. *@
@if (Model.TrancheEditor is not null)
{
    @await Html.PartialAsync("_TrancheEditor", Model.TrancheEditor)
}

@if (Model.RejectedSupplierCount > 0)
{
    <div class="alert alert-danger" role="alert" data-testid="rejected-suppliers-banner">
        <i class="ti ti-alert-circle"></i>
        Esta postulación referencia <strong>@Model.RejectedSupplierCount</strong> proveedor(es) rechazado(s) por administración.
    </div>
}

@if (Model.UnresolvedItemWarnings is not null)
{
    <div class="alert alert-warning unresolved-warning" role="alert">
        <strong>Advertencia:</strong> Los siguientes ítems están sin resolver:
        <ul class="mb-2">
            @foreach (var item in Model.UnresolvedItemWarnings)
            {
                <li>@item</li>
            }
        </ul>
        <p class="mb-2">Confirmar rechazará implícitamente todos los ítems sin resolver.</p>
        <form asp-action="Finalize" asp-route-id="@Model.ApplicationId" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="force" value="true" />
            <button type="submit" id="forceFinalizationConfirm" class="btn btn-danger btn-sm me-2">Confirmar finalización</button>
        </form>
        <a asp-action="Review" asp-route-id="@Model.ApplicationId" class="btn btn-secondary btn-sm">Cancelar</a>
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <strong>Solicitante:</strong>
                <span class="applicant-name">@Model.ApplicantName</span>
            </div>
            <div class="col-md-3">
                <strong>Puntaje de desempeño:</strong>
                <span class="performance-score">
                    @if (Model.ApplicantPerformanceScore.HasValue)
                    {
                        @Model.ApplicantPerformanceScore.Value.ToString("F2")
                    }
                    else
                    {
                        <span class="text-secondary">N/D</span>
                    }
                </span>
            </div>
            <div class="col-md-3">
                <strong>Estado:</strong>
                <span class="application-state">
                    @await Html.PartialAsync("Components/_StatusPill", new StatusPillViewModel(appState))
                </span>
            </div>
            @if (Model.SubmittedAt.HasValue)
            {
                <div class="col-md-3">
                    <strong>Enviada:</strong> @Model.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")
                </div>
            }
        </div>
    </div>
</div>

@* Spec 027 / US5 — reviewer/admin write surface for the applicant's código.
   Read-only on the applicant profile (unchanged). *@
<div class="card mb-4" data-testid="applicant-code-card">
    <div class="card-body">
        <form method="post" asp-controller="Review" asp-action="ApplicantCode"
              asp-route-id="@Model.ApplicationId" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label" for="applicant-codigo">
                    Código del solicitante @await Html.PartialAsync("_RequiredMark")
                </label>
                <input type="text" id="applicant-codigo" name="CodigoPersonal" class="form-control"
                       maxlength="40" value="@Model.ApplicantCodigoPersonal"
                       data-testid="applicant-code-input" />
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary" data-testid="applicant-code-save">
                    Guardar código
                </button>
            </div>
        </form>
    </div>
</div>

@* Spec 027 / US4 — the shared read-only decision summary, identical to the
   applicant and funding-agreement surfaces. The interactive capture controls
   below are unchanged. *@
<div class="card mb-4" data-testid="review-decision-summary">
    <div class="card-header">
        <strong>Resumen de decisiones</strong>
        <span class="text-muted ms-2 small">Misma vista que ven el solicitante y la página del convenio.</span>
    </div>
    <div class="card-body">
        @await Html.PartialAsync("_DecisionSummary", Model.DecisionSummary)
    </div>
</div>

@* Spec 035 (evolved 2026-06-16, D16) — the application's declared impacts (app level). *@
@if (Model.Impacts.Count > 0)
{
    <div class="card mb-4" data-testid="reviewer-impacts-card">
        <div class="card-header"><h4 class="card-title mb-0">Impactos de la solicitud</h4></div>
        <div class="card-body">
            @foreach (var impact in Model.Impacts)
            {
                <div class="mb-2">
                    <strong>@impact.TemplateName</strong>
                    @if (impact.Parameters.Count > 0)
                    {
                        <table class="fl-table mt-1" data-density="reviewer">
                            <thead><tr><th>Parámetro</th><th>Valor</th></tr></thead>
                            <tbody>
                                @foreach (var p in impact.Parameters)
                                {
                                    <tr><td>@p.DisplayLabel</td><td>@p.Value</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="mb-0">Ítems (@Model.Items.Count)</h4>
    @if (appState == ApplicationState.UnderReview && Model.Items.Any(i => i.Quotations.Count >= 2))
    {
        <div class="comparison-app-actions" data-app-id="@Model.ApplicationId">
            <button type="button" class="btn btn-sm btn-outline-primary comparison-generate-all-btn"
                    data-testid="comparison-generate-all-btn"
                    data-app-id="@Model.ApplicationId">
                Generar todo
            </button>
            @if (Model.IsAdmin)
            {
                <label class="form-check form-check-inline ms-2 comparison-bypass-app-toggle"
                       data-testid="comparison-bypass-app-toggle">
                    <input type="checkbox" class="form-check-input" />
                    <span class="form-check-label">Anular límites</span>
                </label>
                <button type="button" class="btn btn-sm btn-outline-warning comparison-force-all-btn ms-1"
                        data-testid="comparison-force-all-btn"
                        data-app-id="@Model.ApplicationId"
                        disabled>
                    Forzar regeneración total
                </button>
            }
        </div>
    }
</div>

@foreach (var item in Model.Items)
{
    var itemReviewStatus = Enum.Parse<ItemReviewStatus>(item.ReviewStatus);
    <div class="card mb-3 review-item" data-item-id="@item.ItemId">
        <div class="card-header d-flex justify-content-between align-items-center">
            <div>
                <strong>@item.ProductName</strong>
                <span class="text-secondary ms-2">(@item.CategoryName)</span>
            </div>
            <span class="review-status-badge">
                @await Html.PartialAsync("Components/_StatusPill", new StatusPillViewModel(itemReviewStatus))
            </span>
        </div>
        <div class="card-body">
            @* Spec 040 / FR-007 — the read-only per-item detail is shared with the auditor
               surface via _ItemReviewDetails. The interactive reviewer forms below stay here. *@
            @await Html.PartialAsync("_ItemReviewDetails", item)

            @if (Model.State == nameof(ApplicationState.UnderReview))
            {
                <hr />
                <div class="row">
                    <div class="col-md-6">
                        <h6>Equivalencia técnica</h6>
                        <form asp-action="FlagEquivalence" asp-route-id="@Model.ApplicationId" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ItemId" value="@item.ItemId" />
                            @if (item.IsNotTechnicallyEquivalent)
                            {
                                <input type="hidden" name="IsNotEquivalent" value="false" />
                                <button type="submit" data-item-id="@item.ItemId" class="btn btn-sm btn-outline-success submit-equivalence">
                                    Eliminar marca de no equivalencia
                                </button>
                            }
                            else
                            {
                                <input type="hidden" name="IsNotEquivalent" value="true" />
                                <button type="submit" data-item-id="@item.ItemId" class="btn btn-sm btn-outline-warning submit-equivalence">
                                    Marcar como no técnicamente equivalente
                                </button>
                            }
                        </form>
                    </div>

                    @if (!item.IsNotTechnicallyEquivalent)
                    {
                        <div class="col-md-6">
                            <h6>Decisión del ítem</h6>
                            <form asp-action="ReviewItem" asp-route-id="@Model.ApplicationId" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="ItemId" value="@item.ItemId" />

                                @* Spec 018 / FR-012 — line code is required for Approve/Reject;
                                   the input stays in the form so a re-render after a validation
                                   error preserves the reviewer's input. *@
                                <div class="mb-2">
                                    <label for="lineCode_@item.ItemId" class="form-label">Código de línea</label>
                                    <input type="text"
                                           class="form-control form-control-sm"
                                           id="lineCode_@item.ItemId"
                                           name="LineCode"
                                           value="@item.LineCode"
                                           maxlength="16"
                                           placeholder="p. ej. T1-1"
                                           data-testid="review-item-line-code"
                                           data-item-id="@item.ItemId" />
                                    <small class="text-secondary">Máx. 16 caracteres. Único dentro de la solicitud.</small>
                                </div>

                                <div class="mb-2">
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input decision-radio" type="radio" name="Decision" value="Approve"
                                               id="approve_@item.ItemId" data-item-id="@item.ItemId"
                                               @(item.ReviewStatus == "Approved" ? "checked" : "")>
                                        <label class="form-check-label" for="approve_@item.ItemId">Aprobar</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input decision-radio" type="radio" name="Decision" value="Reject"
                                               id="reject_@item.ItemId" data-item-id="@item.ItemId"
                                               @(item.ReviewStatus == "Rejected" ? "checked" : "")>
                                        <label class="form-check-label" for="reject_@item.ItemId">Rechazar</label>
                                    </div>
                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input decision-radio" type="radio" name="Decision" value="RequestMoreInfo"
                                               id="moreinfo_@item.ItemId" data-item-id="@item.ItemId"
                                               @(item.ReviewStatus == "NeedsInfo" ? "checked" : "")>
                                        <label class="form-check-label" for="moreinfo_@item.ItemId">Solicitar más información</label>
                                    </div>
                                </div>

                                <div class="mb-2 supplier-select-wrapper @(item.ReviewStatus == "Approved" ? "" : "d-none")" id="supplierSelect_@item.ItemId">
                                    <label class="form-label">Seleccionar proveedor:</label>
                                    <select name="SelectedSupplierId" class="form-select form-select-sm">
                                        <option value="">-- Seleccione un proveedor --</option>
                                        @foreach (var q in item.Quotations)
                                        {
                                            var isSelected = item.SelectedSupplierId.HasValue
                                                ? item.SelectedSupplierId == q.SupplierId
                                                : q.IsRecommended;
                                            // Spec 015 / T415 — show currency and (when non-CRC) converted CRC
                                            // in the dropdown label so the reviewer sees the comparison context.
                                            var priceLabel = q.Currency == "CRC" || string.IsNullOrEmpty(q.Currency)
                                                ? $"₡{q.Price.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-CR"))} CRC"
                                                : $"{q.Price.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))} {q.Currency}"
                                                  + (q.ConvertedCrcAmount.HasValue
                                                      ? $" (≈₡{q.ConvertedCrcAmount.Value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-CR"))})"
                                                      : string.Empty);
                                            var label = q.IsEligible
                                                ? $"{q.SupplierName} - {priceLabel} ({q.Total}/14)"
                                                : $"{q.SupplierName} - {priceLabel} — Bloqueado (CCSS)";
                                            if (q.IsRecommended)
                                            {
                                                label += " (Recomendada)";
                                            }
                                            if (isSelected)
                                            {
                                                <option value="@q.SupplierId" selected>@label</option>
                                            }
                                            else
                                            {
                                                <option value="@q.SupplierId">@label</option>
                                            }
                                        }
                                    </select>
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">Comentario (opcional):</label>
                                    <textarea name="Comment" class="form-control form-control-sm" rows="2"
                                              maxlength="2000">@item.ReviewComment</textarea>
                                </div>

                                <button type="submit" data-item-id="@item.ItemId" class="btn btn-sm btn-primary submit-decision">
                                    Guardar decisión
                                </button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@if (Model.State == nameof(ApplicationState.UnderReview))
{
    <div class="mt-4 d-flex gap-2">
        <form asp-action="SendBack" asp-route-id="@Model.ApplicationId" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning"
                    data-confirm
                    data-confirm-variant="statelocking"
                    data-confirm-title="Devolver solicitud"
                    data-confirm-body="¿Devolver esta solicitud al solicitante?"
                    data-confirm-label="Devolver"
                    onclick="return confirm('¿Devolver esta solicitud al solicitante?')">
                <i class="ti ti-arrow-back-up me-1"></i>Devolver
            </button>
        </form>

        <form asp-action="Finalize" asp-route-id="@Model.ApplicationId" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">
                <i class="ti ti-check me-1"></i>Finalizar revisión
            </button>
        </form>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-link">&larr; Volver a la cola de revisión</a>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.decision-radio').forEach(radio => {
            radio.addEventListener('change', function() {
                const itemId = this.dataset.itemId;
                const wrapper = document.getElementById('supplierSelect_' + itemId);
                if (wrapper) {
                    wrapper.classList.toggle('d-none', this.value !== 'Approve');
                }
            });
        });
    </script>
    @{
        var afTokens = ViewContext.HttpContext.RequestServices
            .GetRequiredService<Microsoft.AspNetCore.Antiforgery.IAntiforgery>()
            .GetAndStoreTokens(ViewContext.HttpContext);
    }
    <script>
        window.__fundingComparison = {
            applicationId: @Model.ApplicationId,
            pollIntervalMs: @(Model.PollIntervalSeconds * 1000),
            antiforgeryToken: '@afTokens.RequestToken',
            antiforgeryHeader: '@afTokens.HeaderName'
        };
    </script>
    <script src="~/js/comparison.js"></script>
}
