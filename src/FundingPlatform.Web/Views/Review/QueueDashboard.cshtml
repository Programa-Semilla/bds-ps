@using FundingPlatform.Application.DTOs
@using FundingPlatform.Application.Services
@using FundingPlatform.Web.Models
@using FundingPlatform.Web.Resources
@inject IReviewerCopyProvider Copy
@model ReviewerQueueDto
@{
    ViewData["Title"] = "Cola de revisión";
    // Spec 007 SC-007 wayfinding: Initial / Generate Agreement / Signing Inbox tabs must
    // remain reachable from /Review. The new spec-011 dashboard layered the hero on top
    // of (not in place of) the queue surface, so the tabs render above the hero.
    ViewData["ActiveTab"] = "Initial";
    bool isEmpty = Model.Rows.Count == 0
                   && Model.Kpis.AwaitingYourReview == 0
                   && Model.Kpis.InProgress == 0
                   && Model.Kpis.Aging == 0;
    // Spec 016 / FR-014 — round-trip the search term so the input keeps the value.
    var currentSearch = (ViewData["ReviewQueue.Search"] as string) ?? "";
}

<div class="container py-3" data-testid="reviewer-queue-dashboard">
    @await Html.PartialAsync("_ReviewTabs")

    @await Html.PartialAsync("../Shared/Components/_ReviewerHero", Model)

    @if (Model.RecentActivity.Count > 0)
    {
        var activityVm = new EventTimelineViewModel(
            Events: Model.RecentActivity.Select(e => new TimelineEvent(
                At: e.Occurred,
                Actor: e.ApplicantName,
                Action: e.Title,
                Detail: e.ApplicationNumber,
                Icon: "ti ti-point",
                Color: "secondary")).ToList(),
            ShowEmptyMessage: false,
            Scope: EventTimelineScope.ReviewerQueue);
        <section class="mt-4" data-testid="reviewer-recent-activity">
            <h2 class="fl-font-display fl-type-heading-md mb-3">Actividad reciente</h2>
            @await Html.PartialAsync("../Shared/Components/_EventTimeline", activityVm)
        </section>
    }

    @* Spec 016 / FR-014 — search input over applicant name + legal id. Composes
       with the existing chip filter (status) and the group-overlap predicate. *@
    <form method="get" asp-action="Index" class="mt-3 d-flex gap-2 flex-wrap"
          data-testid="reviewer-queue-search-form">
        <input type="search" name="search" value="@currentSearch"
               placeholder="@ReviewerQueueResources.SearchPlaceholder"
               class="form-control" style="max-width: 320px;"
               aria-label="@ReviewerQueueResources.SearchLabel"
               data-testid="reviewer-queue-search-input" />
        <button type="submit" class="btn btn-secondary"
                data-testid="reviewer-queue-search-submit">
            @ReviewerQueueResources.SearchSubmit
        </button>
        @if (!string.IsNullOrEmpty(currentSearch))
        {
            <a class="btn btn-link" href="@Url.Action("Index", "Review")"
               data-testid="reviewer-queue-search-clear">
                @ReviewerQueueResources.SearchClear
            </a>
        }
    </form>

    <section class="mt-4" data-testid="reviewer-queue">
        @if (isEmpty)
        {
            var emptyVm = new EmptyStateViewModel(
                Copy.EmptyHeadline(),
                Copy.EmptyBody(),
                IllustrationSceneKey: "calm-horizon",
                IllustrationAltText: "Todo en orden — no tiene revisiones pendientes.");
            @await Html.PartialAsync("../Shared/Components/_EmptyState", emptyVm)
        }
        else
        {
            <div class="card fl-surface fl-surface-shadow-sm">
                <div class="table-responsive">
                    <table class="table table-vcenter">
                        <thead>
                            <tr>
                                <th class="fl-type-meta fl-text-secondary text-uppercase">Solicitud</th>
                                <th class="fl-type-meta fl-text-secondary text-uppercase">Solicitante</th>
                                <th class="fl-type-meta fl-text-secondary text-uppercase">Trayecto</th>
                                <th class="fl-type-meta fl-text-secondary text-uppercase">Días</th>
                                <th class="fl-type-meta fl-text-secondary text-uppercase">Última actividad</th>
                                <th class="fl-type-meta fl-text-secondary text-uppercase">Acción</th>
                            </tr>
                        </thead>
                        <tbody data-testid="reviewer-queue-tbody">
                            @await Html.PartialAsync("_ReviewerQueueRows", Model.Rows)
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </section>
</div>
