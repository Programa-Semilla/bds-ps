@using FundingPlatform.Web.Resources
@model FundingPlatform.Web.ViewModels.Admin.CreateDocumentRuleViewModel
@{
    ViewData["Title"] = DocRuleResources.CreateTitle;
}

<div class="page-header"><h2 class="page-title">@DocRuleResources.CreateTitle</h2></div>

<div class="card mt-3">
    <div class="card-body">
        <form method="post" asp-action="CreateDocumentRule" data-testid="docrule-create-form">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">@DocRuleResources.Field_Category</label>
                <select name="CategoryId" class="form-select" data-testid="docrule-category" data-searchable>
                    <option value="0">@DocRuleResources.Field_UseGlobalDefault</option>
                    @foreach (var (id, name) in Model.CategoryOptions)
                    {
                        <option value="@id" selected="@(Model.CategoryId == id)">@name</option>
                    }
                </select>
                <div class="form-hint">@DocRuleResources.Field_CategoryHint</div>
            </div>

            @await Html.PartialAsync("_DocumentRuleItemsEditor", Model.Items)

            <div class="mt-3">
                <button type="submit" class="btn btn-primary" data-testid="docrule-save">@DocRuleResources.Action_Save</button>
                <a asp-action="DocumentRules" class="btn btn-link">@DocRuleResources.Action_Cancel</a>
            </div>
        </form>
    </div>
</div>
