@model FundingPlatform.Web.ViewModels.Admin.CreateCategoryViewModel

@{
    ViewData["Title"] = "Crear categoría";
}

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: "Crear categoría",
        Breadcrumbs: new[]
        {
            new BreadcrumbItem("Panel de administración", Url.Action("Index")),
            new BreadcrumbItem("Categorías", Url.Action("Categories")),
            new BreadcrumbItem("Crear nueva"),
        }))

<div class="row">
    <div class="col-md-10">
        <form asp-action="CreateCategory" method="post" id="categoryForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nombre @await Html.PartialAsync("_RequiredMark")</label>
                <input asp-for="Name" class="form-control" data-testid="admin-category-name-input" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Descripción</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <partial name="_CategoryFieldsEditor" model="Model.Fields" />

            <div>
                <button type="submit" class="btn btn-primary" data-testid="admin-category-save">Crear categoría</button>
                <a asp-action="Categories" class="btn btn-secondary ms-2">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_CategoryFieldsScript" model="Model.Fields.Count" />
}
