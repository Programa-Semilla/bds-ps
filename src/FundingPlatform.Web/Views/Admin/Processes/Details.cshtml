@*
    Spec 021 / US1 / T083 — Process detail view. Renders the ProcessPlantilla
    snapshot (expanded to ImpactTemplate names, not raw CSV), the list of
    groups attached to the Process, stage-window override controls, and a
    Close button gated on the no-active-Applications guard.
*@
@using FundingPlatform.Domain.Enums
@using FundingPlatform.Web.Models
@model FundingPlatform.Web.ViewModels.Admin.AdminProcessDetailsViewModel
@{
    var detail = Model.Detail;
    // Process names repeat across funds now (per-fund uniqueness), so the title is
    // compound — Fondo › Proceso — to keep the screen unambiguous.
    var compoundTitle = $"{detail.FundName} › {detail.Name}";
    ViewData["Title"] = compoundTitle;
    string StatusLabel(ProcessStatus s) => s switch
    {
        ProcessStatus.Active => "Activo",
        ProcessStatus.Closed => "Cerrado",
        _ => s.ToString(),
    };
}

<div data-testid="admin-process-details-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: compoundTitle,
            Subtitle: $"Estado: {StatusLabel(detail.Status)} · Creado {detail.CreatedAt:yyyy-MM-dd}",
            Breadcrumbs: new[]
            {
                new BreadcrumbItem("Procesos", Url.Action("Index", "AdminProcesses")),
                new BreadcrumbItem(detail.FundName),
                new BreadcrumbItem(detail.Name),
            }))

    @* Spec 024 — flash messages surface as toasts via _ToastContainer (success-banner / error-banner). *@
    @if (Model.CloseBlockingPublicCodes.Count > 0)
    {
        <div class="alert alert-warning" data-testid="admin-process-close-blockers">
            <strong>Solicitudes activas que impiden el cierre:</strong>
            <ul class="mb-0">
                @foreach (var code in Model.CloseBlockingPublicCodes)
                {
                    <li>@code</li>
                }
            </ul>
        </div>
    }

    <div class="row g-3">
        @* Spec 030 / FR-001 / FR-002 — inline rename of the Process Name. Rendered
           regardless of status (Active AND Closed can be renamed). *@
        <div class="col-12">
            <div class="card" data-testid="admin-process-name-card">
                <div class="card-header"><h3 class="card-title">Nombre del proceso</h3></div>
                <div class="card-body">
                    <form method="post" asp-action="Rename" asp-route-id="@detail.Id"
                          class="d-flex flex-wrap gap-2 align-items-end" data-testid="admin-process-rename-form">
                        @Html.AntiForgeryToken()
                        <div class="flex-grow-1">
                            <label class="form-label" for="admin-process-rename-input">Nombre</label>
                            <input name="newName" id="admin-process-rename-input" class="form-control"
                                   value="@detail.Name" maxlength="120" required
                                   data-testid="admin-process-rename-input" />
                            @{
                                var nameError = ViewData.ModelState["newName"]?.Errors.FirstOrDefault()?.ErrorMessage;
                            }
                            @if (!string.IsNullOrEmpty(nameError))
                            {
                                <div class="invalid-feedback d-block" data-testid="admin-process-rename-error">@nameError</div>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary" data-testid="admin-process-rename-submit">
                            <i class="ti ti-device-floppy"></i> Guardar nombre
                        </button>
                    </form>
                </div>
            </div>
        </div>

        @* Spec 029 / FR-002 / FR-009 — Fund the Process belongs to + reassignment. *@
        <div class="col-12">
            <div class="card" data-testid="admin-process-fund-card">
                <div class="card-header"><h3 class="card-title">Fondo</h3></div>
                <div class="card-body d-flex flex-wrap align-items-center gap-3">
                    <div>
                        <div class="text-secondary small">Fondo actual</div>
                        <a data-testid="admin-process-fund-current"
                           href="@Url.Action("Details", "AdminFunds", new { id = detail.FundId })">@detail.FundName</a>
                    </div>
                    @if (detail.Status != ProcessStatus.Closed)
                    {
                        <form method="post" asp-action="ChangeFund" asp-route-id="@detail.Id"
                              class="d-flex gap-2 align-items-end ms-auto" data-testid="admin-process-fund-reassign-form">
                            @Html.AntiForgeryToken()
                            <div>
                                <label class="form-label small mb-1">Reasignar a (fondos activos)</label>
                                <select name="fundId" class="form-select" data-testid="admin-process-fund-reassign-select" style="min-width: 220px;" data-searchable>
                                    @foreach (var f in Model.FundOptions)
                                    {
                                        <option value="@f.Value" selected="@(f.Value == detail.FundId.ToString())">@f.Text</option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-outline-primary" data-testid="admin-process-fund-reassign-submit">Reasignar</button>
                        </form>
                    }
                </div>
            </div>
        </div>

        @* Plantilla snapshot panel. *@
        <div class="col-md-6">
            <div class="card" data-testid="admin-process-plantilla-card">
                <div class="card-header">
                    <h3 class="card-title">Plantilla asignada</h3>
                </div>
                <div class="card-body">
                    @if (detail.Plantilla is { } snapshot)
                    {
                        <dl class="row" data-testid="admin-process-plantilla-snapshot">
                            <dt class="col-sm-5">Nombre base</dt>
                            <dd class="col-sm-7" data-testid="admin-process-plantilla-base-name">@snapshot.SourcePlantillaName</dd>
                            <dt class="col-sm-5">Mín. cotizaciones / ítem</dt>
                            <dd class="col-sm-7" data-testid="admin-process-plantilla-min-quotations">@snapshot.MinimumQuotationsPerItem</dd>
                            <dt class="col-sm-5">Asignada el</dt>
                            <dd class="col-sm-7">@snapshot.AssignedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                        </dl>
                        <p class="text-muted small mb-2">
                            <i class="ti ti-info-circle"></i>
                            Esta plantilla es una <strong>instantánea</strong>. Editar la plantilla base
                            no afecta a este proceso.
                        </p>
                        @* Spec 021 / US1 — the snapshot is immutable to base-Plantilla
                           edits (FR-004). To change a Process's values the admin
                           detaches the snapshot here, then assigns a different base
                           Plantilla. Detach lives on AdminPlantillasController. *@
                        @if (detail.Status == ProcessStatus.Active)
                        {
                            <hr class="my-2" />
                            <p class="text-muted small">
                                ¿Necesita otros valores para este proceso? Desasigne la plantilla
                                y asigne una plantilla base distinta.
                            </p>
                            <form method="post" asp-action="Detach" asp-controller="AdminPlantillas"
                                  asp-route-id="@snapshot.SourcePlantillaId" asp-route-processId="@detail.Id"
                                  data-testid="admin-process-detach-plantilla-form"
                                  onsubmit="return confirm('¿Desasignar la plantilla de este proceso? Después podrá asignar otra.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm"
                                        data-testid="admin-process-detach-plantilla-submit"
                                        data-confirm
                                        data-confirm-variant="destructive"
                                        data-confirm-title="Desasignar plantilla"
                                        data-confirm-body="¿Desasignar la plantilla de este proceso? Después podrá asignar otra."
                                        data-confirm-label="Desasignar plantilla">
                                    <i class="ti ti-unlink"></i> Desasignar plantilla
                                </button>
                            </form>
                            <details class="mt-2">
                                <summary class="text-muted small" style="cursor: pointer;">
                                    Forzar desasignación (proceso con solicitudes activas)
                                </summary>
                                <form method="post" asp-action="Detach" asp-controller="AdminPlantillas"
                                      asp-route-id="@snapshot.SourcePlantillaId" asp-route-processId="@detail.Id"
                                      class="mt-2" data-testid="admin-process-force-detach-form"
                                      onsubmit="return confirm('Forzar la desasignación afectará a las solicitudes activas. ¿Continuar?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="force" value="true" />
                                    <div class="mb-2">
                                        <label class="form-label" for="forceDetachReason">
                                            Razón de la desasignación forzada
                                        </label>
                                        <textarea name="reason" id="forceDetachReason" class="form-control"
                                                  rows="2" required
                                                  data-testid="admin-process-force-detach-reason"></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-danger btn-sm"
                                            data-testid="admin-process-force-detach-submit"
                                            data-confirm
                                            data-confirm-variant="destructive"
                                            data-confirm-title="Forzar desasignación"
                                            data-confirm-body="Forzar la desasignación afectará a las solicitudes activas. ¿Continuar?"
                                            data-confirm-label="Forzar desasignación">
                                        <i class="ti ti-alert-triangle"></i> Forzar desasignación
                                    </button>
                                </form>
                            </details>
                        }
                    }
                    else if (detail.Status == ProcessStatus.Active)
                    {
                        <p class="text-muted">Este proceso todavía no tiene una plantilla asignada.</p>
                        <form method="post" asp-action="AssignPlantilla" asp-controller="AdminProcesses"
                              asp-route-id="@detail.Id" data-testid="admin-process-assign-plantilla-form">
                            @Html.AntiForgeryToken()
                            <div class="input-group">
                                <select name="plantillaId" class="form-select" required
                                        data-testid="admin-process-assign-plantilla-select" data-searchable>
                                    <option value="">Seleccione una plantilla base</option>
                                    @foreach (var p in Model.AssignableBasePlantillas)
                                    {
                                        <option value="@p.Id">@p.Name (mín. @p.MinimumQuotationsPerItem cotizaciones)</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary"
                                        data-testid="admin-process-assign-plantilla-submit">
                                    Asignar
                                </button>
                            </div>
                            @if (Model.AssignableBasePlantillas.Count == 0)
                            {
                                <small class="form-hint text-danger">
                                    No hay plantillas activas con plantillas de impacto adjuntas.
                                    Cree una en <a href="@Url.Action("Create", "AdminPlantillas")">Plantillas</a>.
                                </small>
                            }
                        </form>
                    }
                    else
                    {
                        <p class="text-muted">El proceso está cerrado; no se puede asignar plantilla.</p>
                    }
                </div>
            </div>
        </div>

        @* Stage windows override panel. *@
        <div class="col-md-6">
            <div class="card" data-testid="admin-process-stage-overrides-card">
                <div class="card-header">
                    <h3 class="card-title">Ventanas de etapa</h3>
                </div>
                <div class="card-body">
                    @if (detail.Status == ProcessStatus.Closed)
                    {
                        <p class="text-muted">Proceso cerrado.</p>
                    }
                    else
                    {
                        <form method="post" asp-action="StageOverride" asp-controller="AdminProcesses"
                              asp-route-id="@detail.Id" class="row g-2"
                              data-testid="admin-process-stage-override-form">
                            @Html.AntiForgeryToken()
                            <div class="col-md-5">
                                <label class="form-label" for="stageKind">Etapa</label>
                                <select name="stageKind" id="stageKind" class="form-select" required
                                        data-testid="admin-process-stage-kind">
                                    @* Spec 044 — Solicitud removed; reception windows gate submission timing. *@
                                    <option value="@StageKind.Revision">Revisión (def. @(detail.RevisionWindowDays ?? 10))</option>
                                    <option value="@StageKind.Facturacion">Facturación (def. @(detail.FacturacionWindowDays ?? 30))</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="days">Días</label>
                                <input name="days" id="days" type="number" min="1" class="form-control"
                                       placeholder="Vacío = valor por defecto"
                                       data-testid="admin-process-stage-days" />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100"
                                        data-testid="admin-process-stage-submit">Aplicar</button>
                            </div>
                        </form>
                        <hr />
                        <dl class="row mb-0">
                            <dt class="col-sm-6">Revisión</dt>
                            <dd class="col-sm-6" data-testid="admin-process-window-revision">
                                @(detail.RevisionWindowDays is null ? "por defecto" : $"{detail.RevisionWindowDays} día(s)")
                            </dd>
                            <dt class="col-sm-6">Facturación</dt>
                            <dd class="col-sm-6" data-testid="admin-process-window-facturacion">
                                @(detail.FacturacionWindowDays is null ? "por defecto" : $"{detail.FacturacionWindowDays} día(s)")
                            </dd>
                        </dl>
                    }
                </div>
            </div>
        </div>

        @* Groups panel. Spec 021 / FR-001 — Groups are created *here*, under the
           Process; the owning Process is implied by this page's route id. *@
        <div class="col-12">
            <div class="card" data-testid="admin-process-groups-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Grupos del proceso (@detail.Groups.Count)</h3>
                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", "AdminGroups")"
                       data-testid="admin-process-manage-groups">
                        <i class="ti ti-users-group"></i> Catálogo de grupos
                    </a>
                </div>
                @if (detail.Groups.Count == 0)
                {
                    <div class="card-body">
                        <p class="text-muted mb-0">Sin grupos en este proceso todavía.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="fl-table">
                            <thead>
                                <tr><th>Nombre</th><th class="w-1">Miembros</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var g in detail.Groups)
                                {
                                    <tr data-testid="admin-process-group-row-@g.Id">
                                        <td data-testid="admin-process-group-name">@g.Name</td>
                                        <td>@g.MemberCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (detail.Status == ProcessStatus.Active)
                {
                    <div class="card-body border-top">
                        <form method="post" asp-action="CreateGroup" asp-controller="AdminProcesses"
                              asp-route-id="@detail.Id" class="row g-2"
                              data-testid="admin-process-group-create-form">
                            @Html.AntiForgeryToken()
                            <div class="col-md-8">
                                <label class="form-label" for="groupName">Nuevo grupo</label>
                                <input name="groupName" id="groupName" class="form-control"
                                       maxlength="100" required
                                       placeholder="Nombre del grupo (p. ej. Norte)"
                                       data-testid="admin-process-group-name-input" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100"
                                        data-testid="admin-process-group-create-submit">
                                    <i class="ti ti-plus"></i> Crear grupo
                                </button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        @* Close action footer. *@
        @if (detail.Status == ProcessStatus.Active)
        {
            <div class="col-12">
                <div class="card" data-testid="admin-process-close-card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Cerrar proceso</strong>
                            <p class="text-muted mb-0 small">Solo se permite cuando no hay solicitudes activas.</p>
                        </div>
                        <form method="post" asp-action="Close" asp-controller="AdminProcesses"
                              asp-route-id="@detail.Id" onsubmit="return confirm('¿Cerrar definitivamente el proceso?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger" data-testid="admin-process-close-submit"
                                    data-confirm
                                    data-confirm-variant="destructive"
                                    data-confirm-title="Cerrar proceso"
                                    data-confirm-body="¿Cerrar definitivamente el proceso?"
                                    data-confirm-label="Cerrar proceso">
                                <i class="ti ti-lock"></i> Cerrar proceso
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
