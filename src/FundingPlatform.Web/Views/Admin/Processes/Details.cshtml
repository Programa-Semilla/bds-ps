@*
    Spec 021 / US1 / T083 — Process detail view. Renders the ProcessPlantilla
    snapshot (expanded to ImpactTemplate names, not raw CSV), the list of
    groups attached to the Process, stage-window override controls, and a
    Close button gated on the no-active-Applications guard.
*@
@using FundingPlatform.Domain.Enums
@using FundingPlatform.Web.Models
@model FundingPlatform.Web.ViewModels.Admin.AdminProcessDetailsViewModel
@{
    ViewData["Title"] = Model.Detail.Name;
    var detail = Model.Detail;
    string StatusLabel(ProcessStatus s) => s switch
    {
        ProcessStatus.Active => "Activo",
        ProcessStatus.Closed => "Cerrado",
        _ => s.ToString(),
    };
}

<div data-testid="admin-process-details-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: detail.Name,
            Subtitle: $"Estado: {StatusLabel(detail.Status)} · Creado {detail.CreatedAt:yyyy-MM-dd}",
            Breadcrumbs: new[]
            {
                new BreadcrumbItem("Procesos", Url.Action("Index", "AdminProcesses")),
                new BreadcrumbItem(detail.Name),
            }))

    @if (TempData["SuccessMessage"] is string flash && !string.IsNullOrEmpty(flash))
    {
        <div class="alert alert-success" data-testid="admin-process-flash">@flash</div>
    }
    @if (TempData["ErrorMessage"] is string err && !string.IsNullOrEmpty(err))
    {
        <div class="alert alert-danger" data-testid="admin-process-error">@err</div>
    }
    @if (Model.CloseBlockingPublicCodes.Count > 0)
    {
        <div class="alert alert-warning" data-testid="admin-process-close-blockers">
            <strong>Solicitudes activas que impiden el cierre:</strong>
            <ul class="mb-0">
                @foreach (var code in Model.CloseBlockingPublicCodes)
                {
                    <li>@code</li>
                }
            </ul>
        </div>
    }

    <div class="row g-3">
        @* Plantilla snapshot panel. *@
        <div class="col-md-6">
            <div class="card" data-testid="admin-process-plantilla-card">
                <div class="card-header">
                    <h3 class="card-title">Plantilla asignada</h3>
                </div>
                <div class="card-body">
                    @if (detail.Plantilla is { } snapshot)
                    {
                        <dl class="row" data-testid="admin-process-plantilla-snapshot">
                            <dt class="col-sm-5">Nombre base</dt>
                            <dd class="col-sm-7" data-testid="admin-process-plantilla-base-name">@snapshot.SourcePlantillaName</dd>
                            <dt class="col-sm-5">Mín. cotizaciones / ítem</dt>
                            <dd class="col-sm-7" data-testid="admin-process-plantilla-min-quotations">@snapshot.MinimumQuotationsPerItem</dd>
                            <dt class="col-sm-5">Plantillas de impacto</dt>
                            <dd class="col-sm-7" data-testid="admin-process-plantilla-impacts">
                                @if (snapshot.ImpactTemplateNames.Count == 0)
                                {
                                    <em>—</em>
                                }
                                else
                                {
                                    @string.Join(", ", snapshot.ImpactTemplateNames)
                                }
                            </dd>
                            <dt class="col-sm-5">Asignada el</dt>
                            <dd class="col-sm-7">@snapshot.AssignedAt.ToString("yyyy-MM-dd HH:mm")</dd>
                        </dl>
                        <p class="text-muted small mb-0">
                            <i class="ti ti-info-circle"></i>
                            Esta plantilla es una <strong>instantánea</strong>. Editar la plantilla base
                            no afecta a este proceso.
                        </p>
                    }
                    else if (detail.Status == ProcessStatus.Active)
                    {
                        <p class="text-muted">Este proceso todavía no tiene una plantilla asignada.</p>
                        <form method="post" asp-action="AssignPlantilla" asp-controller="AdminProcesses"
                              asp-route-id="@detail.Id" data-testid="admin-process-assign-plantilla-form">
                            @Html.AntiForgeryToken()
                            <div class="input-group">
                                <select name="plantillaId" class="form-select" required
                                        data-testid="admin-process-assign-plantilla-select">
                                    <option value="">Seleccione una plantilla base</option>
                                    @foreach (var p in Model.AssignableBasePlantillas)
                                    {
                                        <option value="@p.Id">@p.Name (mín. @p.MinimumQuotationsPerItem cotizaciones, @p.ImpactTemplateCount plantilla(s) de impacto)</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-primary"
                                        data-testid="admin-process-assign-plantilla-submit">
                                    Asignar
                                </button>
                            </div>
                            @if (Model.AssignableBasePlantillas.Count == 0)
                            {
                                <small class="form-hint text-danger">
                                    No hay plantillas activas con plantillas de impacto adjuntas.
                                    Cree una en <a href="@Url.Action("Create", "AdminPlantillas")">Plantillas</a>.
                                </small>
                            }
                        </form>
                    }
                    else
                    {
                        <p class="text-muted">El proceso está cerrado; no se puede asignar plantilla.</p>
                    }
                </div>
            </div>
        </div>

        @* Stage windows override panel. *@
        <div class="col-md-6">
            <div class="card" data-testid="admin-process-stage-overrides-card">
                <div class="card-header">
                    <h3 class="card-title">Ventanas de etapa</h3>
                </div>
                <div class="card-body">
                    @if (detail.Status == ProcessStatus.Closed)
                    {
                        <p class="text-muted">Proceso cerrado.</p>
                    }
                    else
                    {
                        <form method="post" asp-action="StageOverride" asp-controller="AdminProcesses"
                              asp-route-id="@detail.Id" class="row g-2"
                              data-testid="admin-process-stage-override-form">
                            @Html.AntiForgeryToken()
                            <div class="col-md-5">
                                <label class="form-label" for="stageKind">Etapa</label>
                                <select name="stageKind" id="stageKind" class="form-select" required
                                        data-testid="admin-process-stage-kind">
                                    <option value="@StageKind.Solicitud">Solicitud (def. @(detail.SolicitudWindowDays ?? 14))</option>
                                    <option value="@StageKind.Revision">Revisión (def. @(detail.RevisionWindowDays ?? 10))</option>
                                    <option value="@StageKind.Facturacion">Facturación (def. @(detail.FacturacionWindowDays ?? 30))</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" for="days">Días</label>
                                <input name="days" id="days" type="number" min="1" class="form-control"
                                       placeholder="Vacío = valor por defecto"
                                       data-testid="admin-process-stage-days" />
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100"
                                        data-testid="admin-process-stage-submit">Aplicar</button>
                            </div>
                        </form>
                        <hr />
                        <dl class="row mb-0">
                            <dt class="col-sm-6">Solicitud</dt>
                            <dd class="col-sm-6" data-testid="admin-process-window-solicitud">
                                @(detail.SolicitudWindowDays is null ? "por defecto" : $"{detail.SolicitudWindowDays} día(s)")
                            </dd>
                            <dt class="col-sm-6">Revisión</dt>
                            <dd class="col-sm-6" data-testid="admin-process-window-revision">
                                @(detail.RevisionWindowDays is null ? "por defecto" : $"{detail.RevisionWindowDays} día(s)")
                            </dd>
                            <dt class="col-sm-6">Facturación</dt>
                            <dd class="col-sm-6" data-testid="admin-process-window-facturacion">
                                @(detail.FacturacionWindowDays is null ? "por defecto" : $"{detail.FacturacionWindowDays} día(s)")
                            </dd>
                        </dl>
                    }
                </div>
            </div>
        </div>

        @* Groups panel. Spec 021 / FR-001 — Groups are created *here*, under the
           Process; the owning Process is implied by this page's route id. *@
        <div class="col-12">
            <div class="card" data-testid="admin-process-groups-card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Grupos del proceso (@detail.Groups.Count)</h3>
                    <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("Index", "AdminGroups")"
                       data-testid="admin-process-manage-groups">
                        <i class="ti ti-users-group"></i> Catálogo de grupos
                    </a>
                </div>
                @if (detail.Groups.Count == 0)
                {
                    <div class="card-body">
                        <p class="text-muted mb-0">Sin grupos en este proceso todavía.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="fl-table">
                            <thead>
                                <tr><th>Nombre</th><th class="w-1">Miembros</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var g in detail.Groups)
                                {
                                    <tr data-testid="admin-process-group-row-@g.Id">
                                        <td data-testid="admin-process-group-name">@g.Name</td>
                                        <td>@g.MemberCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                @if (detail.Status == ProcessStatus.Active)
                {
                    <div class="card-body border-top">
                        <form method="post" asp-action="CreateGroup" asp-controller="AdminProcesses"
                              asp-route-id="@detail.Id" class="row g-2"
                              data-testid="admin-process-group-create-form">
                            @Html.AntiForgeryToken()
                            <div class="col-md-8">
                                <label class="form-label" for="groupName">Nuevo grupo</label>
                                <input name="groupName" id="groupName" class="form-control"
                                       maxlength="100" required
                                       placeholder="Nombre del grupo (p. ej. Norte)"
                                       data-testid="admin-process-group-name-input" />
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100"
                                        data-testid="admin-process-group-create-submit">
                                    <i class="ti ti-plus"></i> Crear grupo
                                </button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        </div>

        @* Close action footer. *@
        @if (detail.Status == ProcessStatus.Active)
        {
            <div class="col-12">
                <div class="card" data-testid="admin-process-close-card">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Cerrar proceso</strong>
                            <p class="text-muted mb-0 small">Solo se permite cuando no hay solicitudes activas.</p>
                        </div>
                        <form method="post" asp-action="Close" asp-controller="AdminProcesses"
                              asp-route-id="@detail.Id" onsubmit="return confirm('¿Cerrar definitivamente el proceso?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger" data-testid="admin-process-close-submit">
                                <i class="ti ti-lock"></i> Cerrar proceso
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
