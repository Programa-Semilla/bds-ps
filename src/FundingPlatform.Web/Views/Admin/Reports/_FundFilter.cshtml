@using FundingPlatform.Application.Admin.Filters
@using FundingPlatform.Web.ViewModels.Admin
@*
    Fondo → Proceso → Grupo cascading drill-down filter for the report filter
    forms. Reads ViewData["FundHierarchy"] (all Funds incl. Archived so admins can
    report on archived-Fund history) + the selected fund/process/group ids. Posts
    ?FundId=&ProcessId=&GroupId= via GET. The component's IdPrefix keeps the
    historical `report-filter-fund` testid.
*@
@{
    var funds = ViewData["FundHierarchy"] as IReadOnlyList<FundHierarchyNode>
        ?? Array.Empty<FundHierarchyNode>();
}
@await Html.PartialAsync("Components/_CascadingFundFilter", new CascadingFundFilterModel
{
    Funds = funds,
    Depth = CascadeFilterDepth.Group,
    FundFieldName = "FundId",
    ProcessFieldName = "ProcessId",
    GroupFieldName = "GroupId",
    SelectedFundId = ViewData["FundFilter"] as int?,
    SelectedProcessId = ViewData["ProcessFilter"] as int?,
    SelectedGroupId = ViewData["GroupFilter"] as int?,
    IdPrefix = "report-filter",
    ColumnClass = "col-md-3",
})
<script src="~/js/cascading-fund-filter.js" asp-append-version="true" defer></script>
