@using FundingPlatform.Web.Models
@using FundingPlatform.Web.Resources
@using FundingPlatform.Web.ViewModels.Admin
@model FundingPlatform.Web.ViewModels.Admin.AdminGroupEditViewModel
@{
    ViewData["Title"] = AdminGroupsResources.Breadcrumb_Edit;
    var deletePromptTitle = string.Format(AdminGroupsResources.Delete_ConfirmTitle, Model.Name);
    var deletePromptBody = string.Format(AdminGroupsResources.Delete_ConfirmBody, Model.MemberCount);
}

<div data-testid="admin-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: $"{AdminGroupsResources.Breadcrumb_Edit} — {Model.Name}",
            Breadcrumbs: new[]
            {
                new BreadcrumbItem(AdminGroupsResources.Breadcrumb_Index, Url.Action("Index", "AdminGroups")),
                new BreadcrumbItem(AdminGroupsResources.Breadcrumb_Edit),
            }))

    <form method="post" asp-action="Edit" asp-route-id="@Model.Id" class="row" data-testid="admin-group-edit-form">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="MemberCount" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" data-testid="admin-group-validation-summary"></div>

        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Name">@AdminGroupsResources.Label_Name @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="Name" class="form-control" data-testid="admin-group-name-input" />
            <span asp-validation-for="Name" class="text-danger" data-testid="admin-group-name-error"></span>
        </div>

        @* Spec 021 / FR-001 + spec 029 — owning Process via a Fondo → Proceso
           drill-down. Changing it reparents the group. The Fondo level narrows the
           Proceso options; the Proceso select posts ProcessId. Archived Funds are
           included so the current Process is always reachable. *@
        @await Html.PartialAsync("Components/_CascadingFundFilter", new CascadingFundFilterModel
        {
            Funds = Model.FundHierarchy,
            Depth = CascadeFilterDepth.Process,
            FundFieldName = "fundId",
            ProcessFieldName = nameof(Model.ProcessId),
            SelectedFundId = Model.SelectedFundId,
            SelectedProcessId = Model.ProcessId,
            IdPrefix = "admin-group-reparent",
            ColumnClass = "col-md-6",
            RequireSelection = true,
        })
        <div class="col-12 mb-3">
            <small class="form-hint">@AdminGroupsResources.Hint_Process</small>
            <span asp-validation-for="ProcessId" class="text-danger" data-testid="admin-group-process-error"></span>
        </div>

        <div class="d-flex justify-content-between mt-2">
            @* Spec 016 — confirm prompt copy is rendered as data-* attributes (HTML-encoded by
               Razor) and read by inline JS. This avoids interpolating Model.Name into a JS string
               literal, which Razor's HTML encoding does not protect against (browser HTML-decodes
               the attribute before the JS engine sees it, allowing apostrophe escapes from the
               group name to break out of confirm('...')). *@
            @* Spec 024 — styled confirm modal (data-confirm); onclick remains as the native fallback (NFR-004). *@
            <button type="submit"
                    formaction="@Url.Action("Delete", "AdminGroups", new { id = Model.Id })"
                    class="btn btn-outline-danger"
                    data-testid="admin-group-delete-submit"
                    data-confirm
                    data-confirm-variant="destructive"
                    data-confirm-label="@AdminGroupsResources.Delete_Submit"
                    data-confirm-title="@deletePromptTitle"
                    data-confirm-body="@deletePromptBody"
                    onclick="return (function(b){ return confirm(b.getAttribute('data-confirm-title') + '\n\n' + b.getAttribute('data-confirm-body')); })(this);">
                <i class="ti ti-trash"></i> @AdminGroupsResources.Delete_Submit
            </button>
            <div class="d-flex gap-2">
                <a class="btn btn-secondary" href="@Url.Action("Index", "AdminGroups")">@AdminGroupsResources.Action_Cancel</a>
                <button type="submit" class="btn btn-primary" data-testid="admin-group-edit-submit">
                    @AdminGroupsResources.Action_Save
                </button>
            </div>
        </div>
    </form>
</div>

<script src="~/js/cascading-fund-filter.js" asp-append-version="true" defer></script>
