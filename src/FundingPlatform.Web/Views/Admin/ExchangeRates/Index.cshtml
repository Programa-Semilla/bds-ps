@using System.Globalization
@using FundingPlatform.Web.Models
@model FundingPlatform.Web.ViewModels.Admin.AdminExchangeRatesListViewModel
@{
    ViewData["Title"] = "Tipos de cambio";
    var es = CultureInfo.GetCultureInfo("es-CR");
}

<div data-testid="admin-exchange-rates-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: "Tipos de cambio",
            Subtitle: "Histórico de tipos de cambio publicados; el más reciente es el activo.",
            PrimaryActions: new[]
            {
                new ActionItem(
                    Label: "Publicar nuevo tipo de cambio",
                    Class: ActionClass.Primary,
                    Url: Url.Action("Create", "AdminExchangeRates"),
                    Icon: "ti ti-plus")
            }))

    @if (Model.Rows.Count == 0)
    {
        <div data-testid="admin-exchange-rates-empty">
            @await Html.PartialAsync("Components/_EmptyState",
                new EmptyStateViewModel(
                    Headline: "Aún no hay tipos de cambio",
                    Body: "Registre el primer tipo de cambio para habilitar conversiones.",
                    Icon: "ti ti-arrows-exchange",
                    IllustrationSceneKey: "folders-stack",
                    PrimaryAction: new ActionItem(
                        Label: "Registrar tipo de cambio",
                        Class: ActionClass.Primary,
                        Url: "/Admin/ExchangeRates/Create",
                        Icon: "ti ti-plus")))
        </div>
    }
    else
    {
        <div class="card" data-testid="admin-exchange-rates-table">
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr>
                            <th>Origen</th>
                            <th>Destino</th>
                            <th class="text-end">Compra</th>
                            <th class="text-end">Venta</th>
                            <th>Vigente desde</th>
                            <th>Publicado por</th>
                            <th>Publicado el</th>
                            <th>Usado</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var rowClass = row.IsActive ? "table-success" : null;
                            <tr class="@rowClass" data-testid="admin-exchange-rate-row-@row.Id">
                                <td><code>@row.SourceCurrencyCode</code></td>
                                <td><code>@row.TargetCurrencyCode</code></td>
                                <td class="text-end" data-testid="rate-buy">@row.BuyRate.ToString("N4", es)</td>
                                <td class="text-end" data-testid="rate-sell">@row.SellRate.ToString("N4", es)</td>
                                <td data-testid="rate-effective">@row.EffectiveAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td data-testid="rate-created-by">@(row.CreatedByUserName ?? row.CreatedByUserId)</td>
                                <td>@row.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    @if (row.IsUsed)
                                    {
                                        <span class="badge bg-blue-lt">Usado</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    @if (row.IsActive)
                                    {
                                        <span class="badge bg-green-lt" data-testid="rate-active-badge">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-lt">Histórico</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
