@using FundingPlatform.Domain.Enums
@using FundingPlatform.Web.Resources
@using FundingPlatform.Web.ViewModels
@using FundingPlatform.Web.ViewModels.Admin
@model AdminUserEditViewModel
@{
    ViewData["Title"] = "Editar usuario";
    // Spec 021 / FR-007 — SupplierAdmin role exposed for assignment + editing
    // (matches the Create form). Label matches the profile-screen copy.
    var roles = new[] { "Applicant", "Reviewer", "Auditor", "Admin" };
    string RoleLabel(string r) => r switch
    {
        "Applicant" => "Solicitante",
        "Reviewer" => "Revisor",
        "Auditor" => "Auditor",
        "Admin" => "Administrador",
        _ => r,
    };
}

<div data-testid="admin-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: $"Editar usuario — {Model.Email}",
            Breadcrumbs: new[]
            {
                new BreadcrumbItem("Usuarios", Url.Action("Index", "AdminUsers")),
                new BreadcrumbItem("Editar"),
            }))

    <form method="post" asp-action="Edit" asp-route-id="@Model.UserId" class="row" data-testid="admin-user-edit-form">
        @Html.AntiForgeryToken()
        <input asp-for="UserId" type="hidden" />
        <input asp-for="ConcurrencyStamp" type="hidden" data-testid="admin-user-concurrency-stamp" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="FirstName">Nombre @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="LastName">Apellidos @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Email">Correo electrónico @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="Email" class="form-control" type="email" data-mask="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Phone">Teléfono (opcional)</label>
            <input asp-for="Phone" class="form-control" type="tel" data-mask="phone-cr" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Role">Rol @await Html.PartialAsync("_RequiredMark")</label>
            <select asp-for="Role" class="form-select" id="roleSelect" data-testid="admin-user-role">
                @foreach (var r in roles)
                {
                    <option value="@r" selected="@(Model.Role == r)">@RoleLabel(r)</option>
                }
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        @* Spec 026 — type-aware masked identification (shown only for the Applicant role via the JS below). *@
        <div class="col-md-6 mb-3" data-testid="legalid-field" id="legalIdField">
            @await Html.PartialAsync("_LegalIdField", new LegalIdFieldModel
            {
                TypeFieldName = nameof(Model.IdentificationType),
                ValueFieldName = nameof(Model.LegalId),
                SelectedType = Model.IdentificationType,
                Value = Model.LegalId,
                AllowedTypes = new[]
                {
                    IdentificationType.CedulaFisica,
                    IdentificationType.Dimex,
                    IdentificationType.Nite,
                    IdentificationType.Pasaporte,
                },
                GroupId = "admin-legal-id",
            })
        </div>

        @* Spec 032 — admin-assigned User Code (shown only for the Applicant role via the JS below). *@
        <div class="col-md-6 mb-3" data-testid="admin-user-usercode" id="userCodeField">
            <label class="form-label" asp-for="UserCode">@AdminUsersResources.UserCodeLabel @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="UserCode" class="form-control" maxlength="50" autocomplete="off" />
            <small class="form-text text-muted">@AdminUsersResources.UserCodeHelpText</small>
            <span asp-validation-for="UserCode" class="text-danger"></span>
        </div>

        <div class="col-md-12 mb-3" data-testid="admin-user-groups-field" id="groupsField">
            <label class="form-label" asp-for="GroupIds">@AdminUsersResources.GroupSelectorLabel</label>
            @await Html.PartialAsync("_GroupSelectorDrilldown", new GroupSelectorModel
            {
                FundCatalog = Model.FundCatalog,
                SelectedGroups = Model.AvailableGroups
                    .Where(g => (Model.GroupIds ?? Array.Empty<int>()).Contains(g.Id))
                    .ToList(),
                FieldName = nameof(Model.GroupIds),
            })
            <small class="form-text text-muted">@AdminUsersResources.GroupSelectorHelpText</small>
            <span asp-validation-for="GroupIds" class="text-danger" data-testid="admin-user-groups-error"></span>
        </div>

        <div class="d-flex justify-content-between mt-2">
            <a class="btn btn-outline-secondary"
               data-testid="admin-user-edit-reset-password-link"
               href="@Url.Action("ResetPassword", "AdminUsers", new { id = Model.UserId })">
                <i class="ti ti-key"></i> Restablecer contraseña
            </a>
            <div class="d-flex gap-2">
                <a class="btn btn-secondary" href="@Url.Action("Index", "AdminUsers")">Cancelar</a>
                <button type="submit" class="btn btn-primary" data-testid="admin-user-edit-submit">Guardar cambios</button>
            </div>
        </div>
    </form>
</div>

@* Spec 037 / US2 — applicant company management card (Solicitante only). Each action
   posts to its own sub-route, so this lives outside the user-edit form. *@
@if (string.Equals(Model.Role, "Applicant", StringComparison.Ordinal))
{
    <div class="card mt-4" data-testid="admin-user-companies-card">
        <div class="card-header">
            <h3 class="card-title mb-0">@AdminCompaniesResources.CardTitle</h3>
        </div>
        <div class="card-body">
            <p class="text-muted">@AdminCompaniesResources.CardHelp</p>

            <ul class="list-group mb-3" data-testid="admin-user-companies-rows">
                @if (Model.Companies.Count == 0)
                {
                    <li class="list-group-item text-muted" data-testid="admin-user-companies-empty">
                        @AdminCompaniesResources.NoCompanies
                    </li>
                }
                @foreach (var company in Model.Companies)
                {
                    <li class="list-group-item" data-testid="admin-user-company-row" data-company-id="@company.Id">
                        <form method="post"
                              asp-controller="AdminUsers" asp-action="RenameCompany"
                              asp-route-id="@Model.UserId" asp-route-companyId="@company.Id"
                              class="d-flex align-items-center gap-2 flex-wrap">
                            @Html.AntiForgeryToken()
                            <input type="text" name="newName" value="@company.Name" maxlength="200"
                                   class="form-control" style="max-width: 22rem;"
                                   data-testid="admin-user-company-name-input" />
                            @if (company.IsArchived)
                            {
                                <span class="badge bg-secondary" data-testid="admin-user-company-archived">@AdminCompaniesResources.ArchivedBadge</span>
                            }
                            else
                            {
                                <span class="badge bg-success" data-testid="admin-user-company-active">@AdminCompaniesResources.ActiveBadge</span>
                            }
                            <button type="submit" class="btn btn-sm btn-outline-primary"
                                    data-testid="admin-user-company-rename">@AdminCompaniesResources.RenameButton</button>
                        </form>
                        <div class="mt-2">
                            @if (company.IsArchived)
                            {
                                <form method="post" class="d-inline"
                                      asp-controller="AdminUsers" asp-action="UnarchiveCompany"
                                      asp-route-id="@Model.UserId" asp-route-companyId="@company.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                            data-confirm data-confirm-variant="primary"
                                            data-confirm-body="@AdminCompaniesResources.UnarchiveConfirm"
                                            data-testid="admin-user-company-unarchive">@AdminCompaniesResources.UnarchiveButton</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" class="d-inline"
                                      asp-controller="AdminUsers" asp-action="ArchiveCompany"
                                      asp-route-id="@Model.UserId" asp-route-companyId="@company.Id">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            data-confirm data-confirm-variant="destructive"
                                            data-confirm-body="@AdminCompaniesResources.ArchiveConfirm"
                                            data-testid="admin-user-company-archive">@AdminCompaniesResources.ArchiveButton</button>
                                </form>
                            }
                        </div>
                    </li>
                }
            </ul>

            <form method="post" asp-controller="AdminUsers" asp-action="AddCompany"
                  asp-route-id="@Model.UserId" class="d-flex gap-2 flex-wrap"
                  data-testid="admin-user-company-add-form">
                @Html.AntiForgeryToken()
                <input type="text" name="name" maxlength="200" class="form-control" style="max-width: 22rem;"
                       placeholder="@AdminCompaniesResources.NameLabel" data-testid="admin-user-company-add-name" />
                <button type="submit" class="btn btn-primary" data-testid="admin-user-company-add-submit">
                    <i class="ti ti-plus me-1"></i>@AdminCompaniesResources.AddButton
                </button>
            </form>
        </div>
    </div>
}

<script>
    (function () {
        var roleSelect = document.getElementById('roleSelect');
        var legalField = document.getElementById('legalIdField');
        var userCodeField = document.getElementById('userCodeField');
        var groupsField = document.getElementById('groupsField');
        function updateVisibility() {
            if (!roleSelect) return;
            var role = roleSelect.value;
            if (legalField) {
                legalField.style.display = role === 'Applicant' ? '' : 'none';
            }
            if (userCodeField) {
                // Spec 032 — User Code is requested only for the Solicitante role.
                userCodeField.style.display = role === 'Applicant' ? '' : 'none';
            }
            if (groupsField) {
                // Spec 016 / FR-009 + spec 021 / FR-007 — Admin AND SupplierAdmin
                // both bypass Process/Group scope.
                var isGroupless = role === 'Admin' || role === 'Auditor';
                groupsField.style.display = isGroupless ? 'none' : '';
            }
        }
        if (roleSelect) {
            roleSelect.addEventListener('change', updateVisibility);
            updateVisibility();
        }
    })();
</script>
<script src="~/js/input-masks.js" asp-append-version="true" defer></script>
<script src="~/js/group-drilldown-selector.js" asp-append-version="true" defer></script>
