@using FundingPlatform.Web.ViewModels.Admin
@using FundingPlatform.Web.Models
@using FundingPlatform.Web.Resources
@model AdminUsersListViewModel
@{
    ViewData["Title"] = "Usuarios";
    // Spec 021 / FR-007 — SupplierAdmin included in the role filter so admins can
    // narrow the list to supplier-catalog admins.
    var roles = new[] { "Applicant", "Reviewer", "Auditor", "Admin" };
    var statuses = new[] { "Active", "Disabled" };
    string RoleLabel(string r) => r switch
    {
        "Applicant" => "Solicitante",
        "Reviewer" => "Revisor",
        "Auditor" => "Auditor",
        "Admin" => "Administrador",
        _ => r,
    };
    string StatusLabel(string s) => s switch
    {
        "Active" => "Activo",
        "Disabled" => "Inhabilitado",
        _ => s,
    };
}

<div data-testid="admin-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: "Usuarios",
            Subtitle: "Administre las cuentas de usuarios de la plataforma.",
            PrimaryActions: new[]
            {
                new ActionItem(
                    Label: "Crear usuario",
                    Class: ActionClass.Primary,
                    Url: Url.Action("Create", "AdminUsers"),
                    Icon: "ti ti-user-plus"),
                // Spec 034 — entry point to the CSV bulk-provisioning page.
                new ActionItem(
                    Label: AdminUsersResources.BatchListEntry,
                    Class: ActionClass.Secondary,
                    Url: Url.Action("Batch", "AdminUsers"),
                    Icon: "ti ti-upload")
            }))

    @* Spec 037 D9 / FR-018 — filters in a white card with Aplicar + Limpiar filtros
       (the clear link is a param-less GET to the same route — no new endpoint). *@
    <div class="fl-filter-card">
        <form method="get" asp-action="Index" class="d-flex gap-2 flex-wrap align-items-center" data-testid="admin-users-filter-form">
            <input type="search" name="search" value="@Model.Search" placeholder="@AdminUsersResources.SearchPlaceholder"
                   class="form-control admin-users-filter-search" data-testid="admin-users-search" />
            <select name="roleFilter" class="form-select admin-users-filter-select" data-testid="admin-users-role-filter">
                <option value="">Todos los roles</option>
                @foreach (var r in roles)
                {
                    <option value="@r" selected="@(Model.RoleFilter == r)">@RoleLabel(r)</option>
                }
            </select>
            <select name="statusFilter" class="form-select admin-users-filter-select" data-testid="admin-users-status-filter">
                <option value="">Todos los estados</option>
                @foreach (var s in statuses)
                {
                    <option value="@s" selected="@(Model.StatusFilter == s)">@StatusLabel(s)</option>
                }
            </select>

            @* Fondo → Proceso → Grupo cascading drill-down filter (active Funds only). *@
            @await Html.PartialAsync("Components/_CascadingFundFilter", new CascadingFundFilterModel
            {
                Funds = Model.FundHierarchy,
                Depth = CascadeFilterDepth.Group,
                FundFieldName = "fundFilter",
                ProcessFieldName = "processFilter",
                GroupFieldName = "groupFilter",
                SelectedFundId = Model.FundFilter,
                SelectedProcessId = Model.ProcessFilter,
                SelectedGroupId = Model.GroupFilter,
                IdPrefix = "admin-users-cascade",
            })

            <button type="submit" class="btn btn-secondary" data-testid="admin-users-filter-submit">Aplicar</button>
            <a class="btn btn-link" href="@Url.Action("Index", "AdminUsers")" data-testid="admin-users-filter-clear">Limpiar filtros</a>
        </form>
    </div>

    <script src="~/js/cascading-fund-filter.js" asp-append-version="true"></script>

    @if (Model.Rows.Count == 0)
    {
        // Spec 017 / FR-014 — distinguish unfiltered-empty (no users yet) from
        // filtered-no-results (filters yielded nothing).
        var hasFilter = !string.IsNullOrWhiteSpace(Model.Search)
            || !string.IsNullOrWhiteSpace(Model.RoleFilter)
            || !string.IsNullOrWhiteSpace(Model.StatusFilter);
        if (hasFilter)
        {
            @await Html.PartialAsync("Components/_EmptyState",
                new EmptyStateViewModel(
                    Headline: "Sin coincidencias",
                    Body: "Pruebe con otros filtros o quite los aplicados.",
                    Icon: "ti ti-search",
                    IllustrationSceneKey: "magnifier-on-empty"))
        }
        else
        {
            @await Html.PartialAsync("Components/_EmptyState",
                new EmptyStateViewModel(
                    Headline: "Aún no hay usuarios",
                    Body: "Cree el primer usuario para empezar a administrar el acceso.",
                    Icon: "ti ti-users",
                    IllustrationSceneKey: "folders-stack",
                    PrimaryAction: new ActionItem(
                        Label: "Crear usuario",
                        Class: ActionClass.Primary,
                        Url: Url.Action("Create", "AdminUsers"),
                        Icon: "ti ti-user-plus")))
        }
    }
    else
    {
        <div class="card" data-testid="admin-users-table">
            <div class="table-responsive">
                <table class="fl-table" data-density="reviewer">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo electrónico</th>
                            <th>@AdminUsersResources.UserCodeColumnHeader</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var roleEnum = Enum.TryParse<AdminUserRole>(row.Role, out var rE) ? rE : AdminUserRole.Applicant;
                            var statusEnum = string.Equals(row.Status, "Disabled", StringComparison.OrdinalIgnoreCase)
                                ? AdminUserStatus.Disabled : AdminUserStatus.Active;
                            <tr data-testid="admin-user-row-@row.Email">
                                <td>@row.FullName @(row.IsSelf ? Html.Raw("<span class=\"badge bg-purple-lt ms-1\">Usted</span>") : null)</td>
                                <td>@row.Email</td>
                                <td data-testid="admin-user-row-usercode">@(string.IsNullOrEmpty(row.UserCode) ? AdminUsersResources.UserCodeEmptyPlaceholder : row.UserCode)</td>
                                <td>@await Html.PartialAsync("Components/_StatusPill", new StatusPillViewModel(roleEnum))</td>
                                <td>@await Html.PartialAsync("Components/_StatusPill", new StatusPillViewModel(statusEnum))</td>
                                <td class="text-end">
                                    @{
                                        // Spec 037 D8 / FR-020 — Editar stays visible; the remaining
                                        // actions move into the "⋯" kebab with their exact routes/verbs/
                                        // antiforgery/testids/data-confirm wiring preserved.
                                        var rowActions = new List<RowActionItem>();
                                        if (!row.IsSelf)
                                        {
                                            rowActions.Add(new RowActionItem(
                                                Label: AdminUsersResources.ResendInvitationLabel,
                                                TestId: "row-action-resend-invite",
                                                FormController: "AdminUsers",
                                                FormAction: "ResendInvitation",
                                                FormRouteValues: new Dictionary<string, string> { ["id"] = row.Id.ToString() },
                                                Icon: "ti ti-mail-forward"));
                                            rowActions.Add(new RowActionItem(
                                                Label: "Restablecer",
                                                TestId: "row-action-reset-password",
                                                Url: Url.Action("ResetPassword", "AdminUsers", new { id = row.Id }),
                                                Icon: "ti ti-key"));
                                            if (statusEnum == AdminUserStatus.Active)
                                            {
                                                rowActions.Add(new RowActionItem(
                                                    Label: "Inhabilitar",
                                                    TestId: "row-action-disable",
                                                    FormController: "AdminUsers",
                                                    FormAction: "Disable",
                                                    FormRouteValues: new Dictionary<string, string> { ["id"] = row.Id.ToString() },
                                                    Icon: "ti ti-ban",
                                                    IsDanger: true,
                                                    ConfirmTitle: "Inhabilitar usuario",
                                                    ConfirmBody: $"¿Inhabilitar a {row.Email}? Esto cierra la sesión del usuario.",
                                                    ConfirmLabel: "Inhabilitar",
                                                    FormOnSubmit: $"return confirm('¿Inhabilitar a {row.Email}? Esto cierra la sesión del usuario.');"));
                                            }
                                            else
                                            {
                                                rowActions.Add(new RowActionItem(
                                                    Label: "Habilitar",
                                                    TestId: "row-action-enable",
                                                    FormController: "AdminUsers",
                                                    FormAction: "Enable",
                                                    FormRouteValues: new Dictionary<string, string> { ["id"] = row.Id.ToString() },
                                                    Icon: "ti ti-circle-check"));
                                            }
                                        }
                                    }
                                    @await Html.PartialAsync("Components/_RowActionsMenu", new RowActionsMenuViewModel(
                                        MenuId: row.Id.ToString(),
                                        Items: rowActions,
                                        EditUrl: Url.Action("Edit", "AdminUsers", new { id = row.Id })))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" data-testid="admin-users-pagination" aria-label="Paginación">
                <ul class="pagination">
                    <li class="page-item @(Model.HasPreviousPage ? null : "disabled")">
                        <a class="page-link"
                           href="@Url.Action("Index", new { roleFilter = Model.RoleFilter, statusFilter = Model.StatusFilter, search = Model.Search, fundFilter = Model.FundFilter, processFilter = Model.ProcessFilter, groupFilter = Model.GroupFilter, page = Model.Page - 1, pageSize = Model.PageSize })">
                            Anterior
                        </a>
                    </li>
                    <li class="page-item active"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
                    <li class="page-item @(Model.HasNextPage ? null : "disabled")">
                        <a class="page-link"
                           href="@Url.Action("Index", new { roleFilter = Model.RoleFilter, statusFilter = Model.StatusFilter, search = Model.Search, fundFilter = Model.FundFilter, processFilter = Model.ProcessFilter, groupFilter = Model.GroupFilter, page = Model.Page + 1, pageSize = Model.PageSize })">
                            Siguiente
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
