@using FundingPlatform.Web.ViewModels.Admin
@using FundingPlatform.Web.Models
@model AdminUsersListViewModel
@{
    ViewData["Title"] = "Usuarios";
    var roles = new[] { "Applicant", "Reviewer", "Admin" };
    var statuses = new[] { "Active", "Disabled" };
    string RoleLabel(string r) => r switch
    {
        "Applicant" => "Solicitante",
        "Reviewer" => "Revisor",
        "Admin" => "Administrador",
        _ => r,
    };
    string StatusLabel(string s) => s switch
    {
        "Active" => "Activo",
        "Disabled" => "Inhabilitado",
        _ => s,
    };
}

<div data-testid="admin-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: "Usuarios",
            Subtitle: "Administre las cuentas de usuarios de la plataforma.",
            PrimaryActions: new[]
            {
                new ActionItem(
                    Label: "Crear usuario",
                    Class: ActionClass.Primary,
                    Url: Url.Action("Create", "AdminUsers"),
                    Icon: "ti ti-user-plus")
            }))

    @{
        // Spec 021 / FR-034 / T082 / T083 — Process → Group cascade catalog.
        // Emitted as a JSON blob the cascade JS consumes; the server side
        // already validated the catalog shape (no PII).
        var cascadeCatalog = System.Text.Json.JsonSerializer.Serialize(
            Model.Processes.Select(p => new
            {
                id = p.Id,
                name = p.Name,
                groups = p.Groups.Select(g => new { id = g.Id, name = g.Name })
            }));
    }

    <form method="get" asp-action="Index" class="mb-3 d-flex gap-2 flex-wrap" data-testid="admin-users-filter-form">
        <input type="search" name="search" value="@Model.Search" placeholder="Buscar por nombre o correo"
               class="form-control admin-users-filter-search" data-testid="admin-users-search" />
        <select name="roleFilter" class="form-select admin-users-filter-select" data-testid="admin-users-role-filter">
            <option value="">Todos los roles</option>
            @foreach (var r in roles)
            {
                <option value="@r" selected="@(Model.RoleFilter == r)">@RoleLabel(r)</option>
            }
        </select>
        <select name="statusFilter" class="form-select admin-users-filter-select" data-testid="admin-users-status-filter">
            <option value="">Todos los estados</option>
            @foreach (var s in statuses)
            {
                <option value="@s" selected="@(Model.StatusFilter == s)">@StatusLabel(s)</option>
            }
        </select>

        <div data-testid="admin-users-process-group-cascade"
             data-process-catalog="@cascadeCatalog"
             class="d-flex gap-2 flex-wrap">
            <select name="processFilter" id="admin-users-process-filter"
                    class="form-select admin-users-filter-select"
                    data-testid="admin-users-process-filter">
                <option value="">Todos los procesos</option>
                @foreach (var p in Model.Processes)
                {
                    <option value="@p.Id" selected="@(Model.ProcessFilter == p.Id)">@p.Name</option>
                }
            </select>
            <select name="groupFilter" id="admin-users-group-filter"
                    class="form-select admin-users-filter-select"
                    data-current-value="@(Model.GroupFilter?.ToString() ?? string.Empty)"
                    data-testid="admin-users-group-filter">
                <option value="">Todos los grupos</option>
                @* The cascade JS rebuilds these options client-side based on the
                   selected Process. The server still emits the catalog as JSON
                   on the wrapper element. *@
                @foreach (var p in Model.Processes)
                {
                    foreach (var g in p.Groups)
                    {
                        // Only render groups for the currently selected process (or all, when none chosen).
                        if (Model.ProcessFilter is null || Model.ProcessFilter == p.Id)
                        {
                            <option value="@g.Id" selected="@(Model.GroupFilter == g.Id)">@g.Name</option>
                        }
                    }
                }
            </select>
        </div>

        <button type="submit" class="btn btn-secondary" data-testid="admin-users-filter-submit">Aplicar</button>
    </form>

    <script src="~/js/process-group-cascade.js" asp-append-version="true"></script>

    @if (Model.Rows.Count == 0)
    {
        // Spec 017 / FR-014 — distinguish unfiltered-empty (no users yet) from
        // filtered-no-results (filters yielded nothing).
        var hasFilter = !string.IsNullOrWhiteSpace(Model.Search)
            || !string.IsNullOrWhiteSpace(Model.RoleFilter)
            || !string.IsNullOrWhiteSpace(Model.StatusFilter);
        if (hasFilter)
        {
            @await Html.PartialAsync("Components/_EmptyState",
                new EmptyStateViewModel(
                    Headline: "Sin coincidencias",
                    Body: "Pruebe con otros filtros o quite los aplicados.",
                    Icon: "ti ti-search",
                    IllustrationSceneKey: "magnifier-on-empty"))
        }
        else
        {
            @await Html.PartialAsync("Components/_EmptyState",
                new EmptyStateViewModel(
                    Headline: "Aún no hay usuarios",
                    Body: "Cree el primer usuario para empezar a administrar el acceso.",
                    Icon: "ti ti-users",
                    IllustrationSceneKey: "folders-stack",
                    PrimaryAction: new ActionItem(
                        Label: "Crear usuario",
                        Class: ActionClass.Primary,
                        Url: Url.Action("Create", "AdminUsers"),
                        Icon: "ti ti-user-plus")))
        }
    }
    else
    {
        <div class="card" data-testid="admin-users-table">
            <div class="table-responsive">
                <table class="fl-table" data-density="reviewer">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Correo electrónico</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            var roleEnum = Enum.TryParse<AdminUserRole>(row.Role, out var rE) ? rE : AdminUserRole.Applicant;
                            var statusEnum = string.Equals(row.Status, "Disabled", StringComparison.OrdinalIgnoreCase)
                                ? AdminUserStatus.Disabled : AdminUserStatus.Active;
                            <tr data-testid="admin-user-row-@row.Email">
                                <td>@row.FullName @(row.IsSelf ? Html.Raw("<span class=\"badge bg-purple-lt ms-1\">Usted</span>") : null)</td>
                                <td>@row.Email</td>
                                <td>@await Html.PartialAsync("Components/_StatusPill", new StatusPillViewModel(roleEnum))</td>
                                <td>@await Html.PartialAsync("Components/_StatusPill", new StatusPillViewModel(statusEnum))</td>
                                <td class="text-end">
                                    <div class="btn-list justify-content-end">
                                        <a class="btn btn-sm btn-outline-secondary"
                                           data-testid="row-action-edit"
                                           href="@Url.Action("Edit", "AdminUsers", new { id = row.Id })">
                                            <i class="ti ti-edit"></i> Editar
                                        </a>
                                        @if (!row.IsSelf)
                                        {
                                            <a class="btn btn-sm btn-outline-secondary"
                                               data-testid="row-action-reset-password"
                                               href="@Url.Action("ResetPassword", "AdminUsers", new { id = row.Id })">
                                                <i class="ti ti-key"></i> Restablecer
                                            </a>
                                            if (statusEnum == AdminUserStatus.Active)
                                            {
                                                <form method="post" asp-action="Disable" asp-controller="AdminUsers"
                                                      asp-route-id="@row.Id" class="d-inline"
                                                      onsubmit="return confirm('¿Inhabilitar a @row.Email? Esto cierra la sesión del usuario.');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                                            data-testid="row-action-disable"
                                                            data-confirm
                                                            data-confirm-variant="destructive"
                                                            data-confirm-title="Inhabilitar usuario"
                                                            data-confirm-body="¿Inhabilitar a @row.Email? Esto cierra la sesión del usuario."
                                                            data-confirm-label="Inhabilitar">
                                                        <i class="ti ti-ban"></i> Inhabilitar
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form method="post" asp-action="Enable" asp-controller="AdminUsers"
                                                      asp-route-id="@row.Id" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-success"
                                                            data-testid="row-action-enable">
                                                        <i class="ti ti-circle-check"></i> Habilitar
                                                    </button>
                                                </form>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" data-testid="admin-users-pagination" aria-label="Paginación">
                <ul class="pagination">
                    <li class="page-item @(Model.HasPreviousPage ? null : "disabled")">
                        <a class="page-link"
                           href="@Url.Action("Index", new { roleFilter = Model.RoleFilter, statusFilter = Model.StatusFilter, search = Model.Search, page = Model.Page - 1, pageSize = Model.PageSize })">
                            Anterior
                        </a>
                    </li>
                    <li class="page-item active"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
                    <li class="page-item @(Model.HasNextPage ? null : "disabled")">
                        <a class="page-link"
                           href="@Url.Action("Index", new { roleFilter = Model.RoleFilter, statusFilter = Model.StatusFilter, search = Model.Search, page = Model.Page + 1, pageSize = Model.PageSize })">
                            Siguiente
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
