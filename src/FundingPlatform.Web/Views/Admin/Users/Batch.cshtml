@*
    Spec 034 / US1 — admin CSV bulk-upload page for provisioning Solicitante accounts.
*@
@using FundingPlatform.Web.Models
@using FundingPlatform.Web.Resources
@model FundingPlatform.Web.ViewModels.Admin.AdminUserBatchUploadViewModel
@{
    ViewData["Title"] = AdminUsersResources.BatchTitle;
}

<div data-testid="admin-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: AdminUsersResources.BatchTitle,
            Subtitle: AdminUsersResources.BatchSubtitle,
            Breadcrumbs: new[]
            {
                new BreadcrumbItem("Usuarios", Url.Action("Index", "AdminUsers")),
                new BreadcrumbItem(AdminUsersResources.BatchTitle),
            }))

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert" data-testid="admin-users-batch-error">
            @Model.ErrorMessage
        </div>
    }

    <div class="card">
        <div class="card-body">
            <p class="text-muted" data-testid="admin-users-batch-help">@AdminUsersResources.BatchUploadHelp</p>

            <div class="mb-3">
                <a class="btn btn-outline-secondary" data-testid="admin-users-batch-template"
                   href="@Url.Action("BatchTemplate", "AdminUsers")">
                    <i class="ti ti-download"></i> @AdminUsersResources.BatchTemplateDownload
                </a>
            </div>

            <form method="post" asp-action="Batch" enctype="multipart/form-data"
                  data-testid="admin-users-batch-form">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label" for="csv">@AdminUsersResources.BatchFileLabel</label>
                    <input type="file" id="csv" name="csv" accept="text/csv,.csv" class="form-control"
                           data-testid="admin-users-batch-file" />
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-secondary" href="@Url.Action("Index", "AdminUsers")">Cancelar</a>
                    <button type="submit" class="btn btn-primary" data-testid="admin-users-batch-submit">
                        @AdminUsersResources.BatchSubmit
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
