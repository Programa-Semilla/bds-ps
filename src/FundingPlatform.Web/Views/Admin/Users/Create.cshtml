@using FundingPlatform.Domain.Enums
@using FundingPlatform.Web.Resources
@using FundingPlatform.Web.ViewModels
@using FundingPlatform.Web.ViewModels.Admin
@model AdminUserCreateViewModel
@{
    ViewData["Title"] = "Crear usuario";
    // Spec 021 / FR-007 — SupplierAdmin role included so admins can provision
    // a supplier-catalog-only user from this form (closes the impl gap that
    // forced dev-only `Account/AssignRole` use). The SupplierAdmin label
    // matches the profile-screen copy in AccountController.BuildProfileViewModelAsync.
    // Spec 045 — Financial Operator (group-scoped, like Reviewer/Auditor). The group
    // selector is shown for it (excluded from the JS isGroupless list below).
    var roles = new[] { "Applicant", "Reviewer", "Auditor", "Financial Operator", "Admin" };
    string RoleLabel(string r) => r switch
    {
        "Applicant" => "Solicitante",
        "Reviewer" => "Revisor",
        "Auditor" => "Auditor",
        "Financial Operator" => "Operador financiero",
        "Admin" => "Administrador",
        _ => r,
    };
}

<div data-testid="admin-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: "Crear usuario",
            Breadcrumbs: new[]
            {
                new BreadcrumbItem("Usuarios", Url.Action("Index", "AdminUsers")),
                new BreadcrumbItem("Crear usuario"),
            }))

    <form method="post" asp-action="Create" class="row" data-testid="admin-user-create-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="FirstName">Nombre @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="LastName">Apellidos @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Email">Correo electrónico @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="Email" class="form-control" type="email" data-mask="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Phone">Teléfono (opcional)</label>
            <input asp-for="Phone" class="form-control" type="tel" data-mask="phone-cr" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Role">Rol @await Html.PartialAsync("_RequiredMark")</label>
            <select asp-for="Role" class="form-select" id="roleSelect" data-testid="admin-user-role">
                @foreach (var r in roles)
                {
                    <option value="@r" selected="@(Model.Role == r)">@RoleLabel(r)</option>
                }
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        @* Spec 026 — type-aware masked identification (shown only for the Applicant role via the JS below). *@
        <div class="col-md-6 mb-3" data-testid="legalid-field" id="legalIdField">
            @await Html.PartialAsync("_LegalIdField", new LegalIdFieldModel
            {
                TypeFieldName = nameof(Model.IdentificationType),
                ValueFieldName = nameof(Model.LegalId),
                SelectedType = Model.IdentificationType,
                Value = Model.LegalId,
                ValueLabel = "Identificación (obligatoria para solicitantes)",
                AllowedTypes = new[]
                {
                    IdentificationType.CedulaFisica,
                    IdentificationType.Dimex,
                    IdentificationType.Nite,
                    IdentificationType.Pasaporte,
                },
                GroupId = "admin-legal-id",
            })
        </div>

        @* Spec 032 — admin-assigned User Code (shown only for the Applicant role via the JS below). *@
        <div class="col-md-6 mb-3" data-testid="admin-user-usercode" id="userCodeField">
            <label class="form-label" asp-for="UserCode">@AdminUsersResources.UserCodeLabel @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="UserCode" class="form-control" maxlength="50" autocomplete="off" />
            <small class="form-text text-muted">@AdminUsersResources.UserCodeHelpText</small>
            <span asp-validation-for="UserCode" class="text-danger"></span>
        </div>

        @* Spec 037 / FR-004 — at-creation companies (Solicitante only; repeatable, ≥1 required). *@
        <div class="col-md-12 mb-3" data-testid="admin-user-companies-field" id="companiesField">
            <label class="form-label">@AdminCompaniesResources.CreateFieldLabel @await Html.PartialAsync("_RequiredMark")</label>
            <div id="companiesList" data-testid="admin-user-companies-list">
                @{
                    var seedCompanies = (Model.Companies != null && Model.Companies.Length > 0)
                        ? Model.Companies
                        : new[] { "" };
                }
                @for (var i = 0; i < seedCompanies.Length; i++)
                {
                    <div class="input-group mb-2" data-company-row>
                        <input type="text" name="Companies" value="@seedCompanies[i]" class="form-control"
                               maxlength="200" placeholder="@AdminCompaniesResources.NameLabel"
                               data-testid="admin-user-company-name" />
                        <button type="button" class="btn btn-outline-danger" data-company-remove
                                data-testid="admin-user-company-remove">@AdminCompaniesResources.CreateRemoveButton</button>
                    </div>
                }
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="addCompanyBtn"
                    data-testid="admin-user-company-add">
                <i class="ti ti-plus me-1"></i>@AdminCompaniesResources.CreateAddButton
            </button>
            <span asp-validation-for="Companies" class="text-danger d-block" data-testid="admin-user-companies-error"></span>
        </div>

        <div class="col-md-12 mb-3" data-testid="admin-user-groups-field" id="groupsField">
            <label class="form-label" asp-for="GroupIds">@AdminUsersResources.GroupSelectorLabel</label>
            @await Html.PartialAsync("_GroupSelectorDrilldown", new GroupSelectorModel
            {
                FundCatalog = Model.FundCatalog,
                SelectedGroups = Model.AvailableGroups
                    .Where(g => (Model.GroupIds ?? Array.Empty<int>()).Contains(g.Id))
                    .ToList(),
                FieldName = nameof(Model.GroupIds),
            })
            <small class="form-text text-muted">@AdminUsersResources.GroupSelectorHelpText</small>
            <span asp-validation-for="GroupIds" class="text-danger" data-testid="admin-user-groups-error"></span>
        </div>

        @* Spec 033 — no password field. On submit, the account is created with no
           password and an emailed set-password invitation is sent; the next screen
           shows a copyable invite link. *@
        <div class="col-md-12 mb-3">
            <p class="text-muted mb-0" data-testid="admin-user-invite-note">
                Al crear el usuario se enviará una invitación por correo para que establezca su contraseña. No se asigna una contraseña inicial.
            </p>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
            <a class="btn btn-secondary" href="@Url.Action("Index", "AdminUsers")">Cancelar</a>
            <button type="submit" class="btn btn-primary" data-testid="admin-user-create-submit">Crear usuario</button>
        </div>
    </form>
</div>

<script>
    (function () {
        var roleSelect = document.getElementById('roleSelect');
        var legalField = document.getElementById('legalIdField');
        var userCodeField = document.getElementById('userCodeField');
        var groupsField = document.getElementById('groupsField');
        var companiesField = document.getElementById('companiesField');
        function updateVisibility() {
            if (!roleSelect) return;
            var role = roleSelect.value;
            if (legalField) {
                legalField.style.display = role === 'Applicant' ? '' : 'none';
            }
            if (userCodeField) {
                // Spec 032 — User Code is requested only for the Solicitante role.
                userCodeField.style.display = role === 'Applicant' ? '' : 'none';
            }
            if (companiesField) {
                // Spec 037 — companies are requested only for the Solicitante role.
                companiesField.style.display = role === 'Applicant' ? '' : 'none';
            }
            if (groupsField) {
                // Spec 016 / FR-009 — hide the group selector when role is Admin.
                // Spec 021 / FR-007 — same for SupplierAdmin: scope is global supplier
                // catalog, Process/Group does not apply.
                var isGroupless = role === 'Admin' || role === 'Auditor';
                groupsField.style.display = isGroupless ? 'none' : '';
            }
        }
        if (roleSelect) {
            roleSelect.addEventListener('change', updateVisibility);
            updateVisibility();
        }

        // Spec 037 — repeatable company name inputs (add / remove).
        var companiesList = document.getElementById('companiesList');
        var addCompanyBtn = document.getElementById('addCompanyBtn');
        function newCompanyRow() {
            var row = document.createElement('div');
            row.className = 'input-group mb-2';
            row.setAttribute('data-company-row', '');
            var input = document.createElement('input');
            input.type = 'text';
            input.name = 'Companies';
            input.className = 'form-control';
            input.maxLength = 200;
            input.setAttribute('data-testid', 'admin-user-company-name');
            var btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'btn btn-outline-danger';
            btn.setAttribute('data-company-remove', '');
            btn.setAttribute('data-testid', 'admin-user-company-remove');
            btn.textContent = @Html.Raw(Json.Serialize(AdminCompaniesResources.CreateRemoveButton));
            row.appendChild(input);
            row.appendChild(btn);
            return row;
        }
        if (addCompanyBtn && companiesList) {
            addCompanyBtn.addEventListener('click', function () {
                companiesList.appendChild(newCompanyRow());
            });
            companiesList.addEventListener('click', function (e) {
                var btn = e.target.closest('[data-company-remove]');
                if (!btn) return;
                var rows = companiesList.querySelectorAll('[data-company-row]');
                if (rows.length > 1) {
                    btn.closest('[data-company-row]').remove();
                } else {
                    // Keep at least one row; just clear it.
                    var input = btn.closest('[data-company-row]').querySelector('input');
                    if (input) input.value = '';
                }
            });
        }
    })();
</script>
<script src="~/js/input-masks.js" asp-append-version="true" defer></script>
<script src="~/js/group-drilldown-selector.js" asp-append-version="true" defer></script>
