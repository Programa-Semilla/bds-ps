@using FundingPlatform.Domain.Enums
@using FundingPlatform.Web.Resources
@using FundingPlatform.Web.ViewModels
@using FundingPlatform.Web.ViewModels.Admin
@model AdminUserCreateViewModel
@{
    ViewData["Title"] = "Crear usuario";
    // Spec 021 / FR-007 — SupplierAdmin role included so admins can provision
    // a supplier-catalog-only user from this form (closes the impl gap that
    // forced dev-only `Account/AssignRole` use). The SupplierAdmin label
    // matches the profile-screen copy in AccountController.BuildProfileViewModelAsync.
    var roles = new[] { "Applicant", "Reviewer", "SupplierAdmin", "Admin" };
    string RoleLabel(string r) => r switch
    {
        "Applicant" => "Solicitante",
        "Reviewer" => "Revisor",
        "SupplierAdmin" => "Administrador de proveedores",
        "Admin" => "Administrador",
        _ => r,
    };
    var selectedIds = new HashSet<int>(Model.GroupIds ?? Array.Empty<int>());
}

<div data-testid="admin-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: "Crear usuario",
            Breadcrumbs: new[]
            {
                new BreadcrumbItem("Usuarios", Url.Action("Index", "AdminUsers")),
                new BreadcrumbItem("Crear usuario"),
            }))

    <form method="post" asp-action="Create" class="row" data-testid="admin-user-create-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="FirstName">Nombre @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="LastName">Apellidos @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Email">Correo electrónico @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="Email" class="form-control" type="email" data-mask="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Phone">Teléfono (opcional)</label>
            <input asp-for="Phone" class="form-control" type="tel" data-mask="phone-cr" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="Role">Rol @await Html.PartialAsync("_RequiredMark")</label>
            <select asp-for="Role" class="form-select" id="roleSelect" data-testid="admin-user-role">
                @foreach (var r in roles)
                {
                    <option value="@r" selected="@(Model.Role == r)">@RoleLabel(r)</option>
                }
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        @* Spec 026 — type-aware masked identification (shown only for the Applicant role via the JS below). *@
        <div class="col-md-6 mb-3" data-testid="legalid-field" id="legalIdField">
            @await Html.PartialAsync("_LegalIdField", new LegalIdFieldModel
            {
                TypeFieldName = nameof(Model.IdentificationType),
                ValueFieldName = nameof(Model.LegalId),
                SelectedType = Model.IdentificationType,
                Value = Model.LegalId,
                ValueLabel = "Identificación (obligatoria para solicitantes)",
                AllowedTypes = new[]
                {
                    IdentificationType.CedulaFisica,
                    IdentificationType.Dimex,
                    IdentificationType.Nite,
                    IdentificationType.Pasaporte,
                },
                GroupId = "admin-legal-id",
            })
        </div>

        <div class="col-md-12 mb-3" data-testid="admin-user-groups-field" id="groupsField">
            <label class="form-label" asp-for="GroupIds">@AdminUsersResources.GroupSelectorLabel</label>
            @if (Model.AvailableGroups.Count == 0)
            {
                <div class="text-muted" data-testid="admin-user-groups-empty">
                    @AdminUsersResources.GroupSelectorEmptyOption
                </div>
            }
            else
            {
                <select asp-for="GroupIds" class="form-select" multiple size="@Math.Min(8, Model.AvailableGroups.Count)"
                        data-testid="admin-user-groups-select">
                    @foreach (var opt in Model.AvailableGroups)
                    {
                        <option value="@opt.Id" selected="@selectedIds.Contains(opt.Id)">@opt.Name</option>
                    }
                </select>
            }
            <small class="form-text text-muted">@AdminUsersResources.GroupSelectorHelpText</small>
            <span asp-validation-for="GroupIds" class="text-danger" data-testid="admin-user-groups-error"></span>
        </div>

        <div class="col-md-6 mb-3">
            <label class="form-label" asp-for="InitialPassword">Contraseña inicial @await Html.PartialAsync("_RequiredMark")</label>
            <input asp-for="InitialPassword" class="form-control" type="password" />
            <span asp-validation-for="InitialPassword" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-2">
            <a class="btn btn-secondary" href="@Url.Action("Index", "AdminUsers")">Cancelar</a>
            <button type="submit" class="btn btn-primary" data-testid="admin-user-create-submit">Crear usuario</button>
        </div>
    </form>
</div>

<script>
    (function () {
        var roleSelect = document.getElementById('roleSelect');
        var legalField = document.getElementById('legalIdField');
        var groupsField = document.getElementById('groupsField');
        function updateVisibility() {
            if (!roleSelect) return;
            var role = roleSelect.value;
            if (legalField) {
                legalField.style.display = role === 'Applicant' ? '' : 'none';
            }
            if (groupsField) {
                // Spec 016 / FR-009 — hide the group selector when role is Admin.
                // Spec 021 / FR-007 — same for SupplierAdmin: scope is global supplier
                // catalog, Process/Group does not apply.
                var isGroupless = role === 'Admin' || role === 'SupplierAdmin';
                groupsField.style.display = isGroupless ? 'none' : '';
            }
        }
        if (roleSelect) {
            roleSelect.addEventListener('change', updateVisibility);
            updateVisibility();
        }
    })();
</script>
<script src="~/js/input-masks.js" asp-append-version="true" defer></script>
