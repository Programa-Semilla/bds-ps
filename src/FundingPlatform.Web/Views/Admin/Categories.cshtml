@model FundingPlatform.Web.ViewModels.Admin.CategoryAdminViewModel

@{
    ViewData["Title"] = "Categorías";
}

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: "Categorías",
        Breadcrumbs: new[]
        {
            new BreadcrumbItem("Panel de administración", Url.Action("Index")),
            new BreadcrumbItem("Categorías"),
        }))

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Categorías de adquisición</h3>
        <a asp-action="CreateCategory" class="btn btn-primary" data-testid="admin-category-create">
            <i class="ti ti-plus me-1"></i>Crear categoría
        </a>
    </div>
    <div class="table-responsive">
        <table class="table card-table table-vcenter">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th class="w-1">Campos</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Categories)
                {
                    <tr data-testid="admin-category-row-@c.Id">
                        <td data-testid="admin-category-name">@c.Name</td>
                        <td class="text-secondary">@c.Description</td>
                        <td>@c.FieldCount</td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-green-lt">Activa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactiva</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" data-testid="admin-category-edit"
                               asp-action="EditCategory" asp-route-id="@c.Id">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
