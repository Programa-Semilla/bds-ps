@*
    Spec 021 / US7 / T146 / FR-031 — admin upload surface for the public landing
    slot files (Reglamento + Ejemplo de cotización). The actual storage round-trips
    are owned by AdminPublicLandingFilesController; this view only renders the
    upload forms + current status indicator + "Eliminar" action per slot.

    Voice: formal usted (es-CR), aligned with spec 012.
*@
@using FundingPlatform.Web.Models
@model FundingPlatform.Web.ViewModels.Admin.AdminPublicLandingIndexViewModel
@{
    ViewData["Title"] = "Página pública";

    bool reglamentoConfigured = !string.IsNullOrWhiteSpace(Model.ReglamentoStorageKey);
    bool ejemploConfigured = !string.IsNullOrWhiteSpace(Model.EjemploStorageKey);
}

<div data-testid="admin-public-landing-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: "Página pública",
            Subtitle: "Administre los archivos visibles en la página de inicio anónima: Reglamento y Ejemplo de cotización."))

    @* Spec 024 — flash messages surface as toasts via _ToastContainer (success-banner / error-banner). *@

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <article class="card h-100" data-testid="admin-public-landing-slot-reglamento">
                <div class="card-body">
                    <h3 class="card-title fl-font-display">Reglamento</h3>
                    <p class="fl-text-secondary fl-type-body">
                        Documento PDF que se publica como descarga en la página de inicio.
                    </p>

                    @if (reglamentoConfigured)
                    {
                        <p class="mb-2" data-testid="admin-public-landing-reglamento-current">
                            <span class="badge bg-success">Publicado</span>
                            <code class="ms-2 small text-muted">@Model.ReglamentoStorageKey</code>
                        </p>
                    }
                    else
                    {
                        <p class="mb-2" data-testid="admin-public-landing-reglamento-empty">
                            <span class="badge bg-secondary">Sin publicar</span>
                        </p>
                    }

                    <form method="post"
                          enctype="multipart/form-data"
                          asp-controller="AdminPublicLandingFiles"
                          asp-action="UploadReglamento"
                          class="mb-2">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label">Archivo PDF</label>
                            <input type="file" name="file" accept="application/pdf" required
                                   data-testid="admin-public-landing-reglamento-file"
                                   class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-primary"
                                data-testid="admin-public-landing-reglamento-upload">
                            <i class="ti ti-upload me-1"></i>Publicar
                        </button>
                    </form>

                    @if (reglamentoConfigured)
                    {
                        <form method="post"
                              asp-controller="AdminPublicLandingFiles"
                              asp-action="Clear"
                              asp-route-slot="reglamento"
                              onsubmit="return confirm('¿Eliminar el Reglamento publicado?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    data-testid="admin-public-landing-reglamento-clear"
                                    data-confirm
                                    data-confirm-variant="destructive"
                                    data-confirm-title="Eliminar Reglamento"
                                    data-confirm-body="¿Eliminar el Reglamento publicado?"
                                    data-confirm-label="Eliminar">
                                <i class="ti ti-trash me-1"></i>Eliminar
                            </button>
                        </form>
                    }
                </div>
            </article>
        </div>

        <div class="col-12 col-lg-6">
            <article class="card h-100" data-testid="admin-public-landing-slot-ejemplo">
                <div class="card-body">
                    <h3 class="card-title fl-font-display">Ejemplo de cotización</h3>
                    <p class="fl-text-secondary fl-type-body">
                        Documento PDF de referencia para los solicitantes nuevos.
                    </p>

                    @if (ejemploConfigured)
                    {
                        <p class="mb-2" data-testid="admin-public-landing-ejemplo-current">
                            <span class="badge bg-success">Publicado</span>
                            <code class="ms-2 small text-muted">@Model.EjemploStorageKey</code>
                        </p>
                    }
                    else
                    {
                        <p class="mb-2" data-testid="admin-public-landing-ejemplo-empty">
                            <span class="badge bg-secondary">Sin publicar</span>
                        </p>
                    }

                    <form method="post"
                          enctype="multipart/form-data"
                          asp-controller="AdminPublicLandingFiles"
                          asp-action="UploadEjemplo"
                          class="mb-2">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label">Archivo PDF</label>
                            <input type="file" name="file" accept="application/pdf" required
                                   data-testid="admin-public-landing-ejemplo-file"
                                   class="form-control" />
                        </div>
                        <button type="submit" class="btn btn-primary"
                                data-testid="admin-public-landing-ejemplo-upload">
                            <i class="ti ti-upload me-1"></i>Publicar
                        </button>
                    </form>

                    @if (ejemploConfigured)
                    {
                        <form method="post"
                              asp-controller="AdminPublicLandingFiles"
                              asp-action="Clear"
                              asp-route-slot="ejemplo"
                              onsubmit="return confirm('¿Eliminar el Ejemplo de cotización publicado?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                    data-testid="admin-public-landing-ejemplo-clear"
                                    data-confirm
                                    data-confirm-variant="destructive"
                                    data-confirm-title="Eliminar Ejemplo de cotización"
                                    data-confirm-body="¿Eliminar el Ejemplo de cotización publicado?"
                                    data-confirm-label="Eliminar">
                                <i class="ti ti-trash me-1"></i>Eliminar
                            </button>
                        </form>
                    }
                </div>
            </article>
        </div>
    </div>
</div>
