@using FundingPlatform.Domain.Enums
@using FundingPlatform.Web.Helpers
@using FundingPlatform.Web.Resources
@using FundingPlatform.Web.ViewModels.Admin
@model FundingPlatform.Web.ViewModels.Admin.AdminSupplierDetailViewModel
@{
    var rowVersionB64 = Convert.ToBase64String(Model.RowVersion);
}
@{
    ViewData["Title"] = $"Proveedor — {Model.Name}";
    string StatusLabel(SupplierVerificationStatus s) => s switch
    {
        SupplierVerificationStatus.Draft => "Borrador",
        SupplierVerificationStatus.PendingReview => AdminSuppliersResources.FilterStatus_PendingReview,
        SupplierVerificationStatus.Verified => AdminSuppliersResources.FilterStatus_Verified,
        SupplierVerificationStatus.Rejected => AdminSuppliersResources.FilterStatus_Rejected,
        _ => s.ToString(),
    };
}

<div data-testid="admin-supplier-detail">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: Model.Name,
            Subtitle: $"Cédula: {Model.LegalId} · Estado: {StatusLabel(Model.Status)}"))

    @if (Model.Status == SupplierVerificationStatus.Rejected && !string.IsNullOrWhiteSpace(Model.RejectionReason))
    {
        <div class="alert alert-danger" role="alert" data-testid="rejection-reason-banner">
            <strong>Razón de rechazo:</strong> @Model.RejectionReason
        </div>
    }

    <div class="row row-cards">
        <div class="col-md-7">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Identidad y cumplimiento regulatorio</h4>
                    <form method="post" asp-action="Edit" asp-route-supplierId="@Model.Id" data-testid="admin-supplier-edit-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="SupplierId" value="@Model.Id" />
                        <input type="hidden" name="RowVersion" value="@rowVersionB64" />
                        <div class="mb-3">
                            <label class="form-label">Razón social</label>
                            <input class="form-control" name="Name" value="@Model.Name" required maxlength="300"
                                   data-testid="admin-supplier-name-input" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="ha-hacienda">Hacienda</label>
                            <select class="form-select" name="Hacienda" id="ha-hacienda" data-testid="admin-supplier-hacienda-select">
                                @foreach (var it in RegulatoryStatusLabels.HaciendaItems(Model.HaciendaStatus))
                                {
                                    <option value="@it.Value" selected="@(it.Selected ? "selected" : null)">@it.Text</option>
                                }
                            </select>
                            <div class="form-text" data-testid="hacienda-freshness">
                                @ReviewFreshness.Describe(Model.HaciendaReviewedAt, Model.HaciendaReviewedByName, Model.HaciendaReviewedSource)
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="ha-ccss">CCSS</label>
                            <select class="form-select" name="Ccss" id="ha-ccss" data-testid="admin-supplier-ccss-select">
                                @foreach (var it in RegulatoryStatusLabels.CcssItems(Model.CcssStatus))
                                {
                                    <option value="@it.Value" selected="@(it.Selected ? "selected" : null)">@it.Text</option>
                                }
                            </select>
                            <div class="form-text" data-testid="ccss-freshness">
                                @ReviewFreshness.Describe(Model.CcssReviewedAt, Model.CcssReviewedByName, Model.CcssReviewedSource)
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="ha-sicop">SICOP</label>
                            <select class="form-select" name="Sicop" id="ha-sicop" data-testid="admin-supplier-sicop-select">
                                @foreach (var it in RegulatoryStatusLabels.SicopItems(Model.SicopStatus))
                                {
                                    <option value="@it.Value" selected="@(it.Selected ? "selected" : null)">@it.Text</option>
                                }
                            </select>
                            <div class="form-text" data-testid="sicop-freshness">
                                @ReviewFreshness.Describe(Model.SicopReviewedAt, Model.SicopReviewedByName, Model.SicopReviewedSource)
                            </div>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="IsPmeOrPyme" value="true"
                                   id="ha-pme" @(Model.IsPmeOrPyme ? "checked" : "")
                                   data-testid="admin-supplier-pme-toggle" />
                            <label class="form-check-label" for="ha-pme">PYME / PME</label>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="HasWarning" value="true"
                                   id="ha-warning" @(Model.HasWarning ? "checked" : "")
                                   data-testid="admin-supplier-warning-toggle" />
                            <label class="form-check-label" for="ha-warning">Advertencia sobre el proveedor</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="ha-warning-note">Nota de advertencia</label>
                            <textarea class="form-control" name="WarningNote" id="ha-warning-note" rows="2" maxlength="1000"
                                      placeholder="Detalle de la advertencia (opcional)"
                                      data-testid="admin-supplier-warning-note">@Model.WarningNote</textarea>
                        </div>

                        <button type="submit" class="btn btn-primary mt-1" data-testid="admin-supplier-edit-submit">
                            <i class="ti ti-device-floppy"></i> Guardar cambios
                        </button>
                    </form>

                    @* Spec 038 (US2 / D9) — "reviewed — no change" re-authorization per
                       field; rendered only when the status has a value. Separate forms
                       (cannot nest inside the edit form). *@
                    @if (Model.HaciendaStatus is not null || Model.CcssStatus is not null || Model.SicopStatus is not null)
                    {
                        <hr />
                        <div class="text-muted small mb-2">Confirmar revisión sin cambios</div>
                        <div class="d-flex flex-wrap gap-2" data-testid="confirm-review-group">
                            @if (Model.HaciendaStatus is not null)
                            {
                                <form method="post" asp-action="ConfirmReviewed" asp-route-supplierId="@Model.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="field" value="@RegulatoryField.Hacienda" />
                                    <input type="hidden" name="rowVersion" value="@rowVersionB64" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" data-testid="confirm-review-hacienda">
                                        <i class="ti ti-checkup-list"></i> Hacienda
                                    </button>
                                </form>
                            }
                            @if (Model.CcssStatus is not null)
                            {
                                <form method="post" asp-action="ConfirmReviewed" asp-route-supplierId="@Model.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="field" value="@RegulatoryField.Ccss" />
                                    <input type="hidden" name="rowVersion" value="@rowVersionB64" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" data-testid="confirm-review-ccss">
                                        <i class="ti ti-checkup-list"></i> CCSS
                                    </button>
                                </form>
                            }
                            @if (Model.SicopStatus is not null)
                            {
                                <form method="post" asp-action="ConfirmReviewed" asp-route-supplierId="@Model.Id" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="field" value="@RegulatoryField.Sicop" />
                                    <input type="hidden" name="rowVersion" value="@rowVersionB64" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" data-testid="confirm-review-sicop">
                                        <i class="ti ti-checkup-list"></i> SICOP
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h4 class="card-title">Estado</h4>
                    <p class="text-muted small">
                        Aplicaciones que referencian este proveedor: <strong>@Model.ReferencingApplicationCount</strong>
                    </p>

                    @if (Model.VerifiedByUserId is not null)
                    {
                        <p class="text-muted small">Verificado el @Model.VerifiedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</p>
                    }

                    @if (Model.Status != SupplierVerificationStatus.Draft)
                    {
                        <div class="d-grid gap-2">
                            @if (Model.Status != SupplierVerificationStatus.Verified)
                            {
                                <form method="post" asp-action="Verify" asp-route-supplierId="@Model.Id"
                                      onsubmit="return confirm('@AdminSuppliersResources.Verify_Confirm');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success w-100" data-testid="admin-supplier-verify-button"
                                            data-confirm
                                            data-confirm-variant="primary"
                                            data-confirm-title="Verificar proveedor"
                                            data-confirm-body="@AdminSuppliersResources.Verify_Confirm"
                                            data-confirm-label="Verificar proveedor">
                                        <i class="ti ti-circle-check"></i> Verificar proveedor
                                    </button>
                                </form>
                            }

                            <form method="post" asp-action="Reject" asp-route-supplierId="@Model.Id" data-testid="admin-supplier-reject-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="SupplierId" value="@Model.Id" />
                                <div class="mb-2">
                                    <label class="form-label">Razón de rechazo</label>
                                    <textarea class="form-control" name="Reason" rows="3" maxlength="1000"
                                              data-testid="admin-supplier-reject-reason"></textarea>
                                </div>
                                <button type="submit" class="btn btn-outline-danger w-100" data-testid="admin-supplier-reject-button">
                                    <i class="ti ti-x"></i> Rechazar proveedor
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-body">
            <h4 class="card-title">Sucursales</h4>
            @if (Model.Branches.Count == 0)
            {
                <p class="text-muted">No hay sucursales registradas.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="fl-table" data-density="reviewer" data-testid="admin-supplier-branches-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Contacto</th>
                                <th>Correo</th>
                                <th>Teléfono</th>
                                <th>Provincia</th>
                                <th>Predeterminada</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.Branches)
                            {
                                <tr data-testid="admin-branch-row-@b.Id">
                                    <td><strong>@b.BranchName</strong></td>
                                    <td>@b.ContactName</td>
                                    <td>@b.Email</td>
                                    <td>@b.Phone</td>
                                    <td>@b.Province</td>
                                    <td>
                                        @if (b.IsDefault) { <span class="badge bg-blue-lt">Sí</span> }
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                data-testid="admin-branch-edit-toggle-@b.Id"
                                                onclick="document.getElementById('branch-edit-@b.Id').classList.toggle('d-none');">
                                            <i class="ti ti-edit"></i> Editar
                                        </button>
                                    </td>
                                </tr>
                                <tr id="branch-edit-@b.Id" class="d-none">
                                    <td colspan="7">
                                        <form method="post" asp-action="EditBranch"
                                              asp-route-supplierId="@Model.Id" asp-route-branchId="@b.Id"
                                              data-testid="admin-branch-edit-form-@b.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="SupplierId" value="@Model.Id" />
                                            <input type="hidden" name="BranchId" value="@b.Id" />
                                            <div class="row">
                                                <div class="col-md-6 mb-2">
                                                    <label class="form-label">Nombre de la sucursal</label>
                                                    <input class="form-control" name="BranchName" value="@b.BranchName" required maxlength="200" />
                                                </div>
                                                <div class="col-md-6 mb-2">
                                                    <label class="form-label">Contacto</label>
                                                    <input class="form-control" name="ContactName" value="@b.ContactName" maxlength="200" />
                                                </div>
                                                <div class="col-md-6 mb-2">
                                                    <label class="form-label">Correo</label>
                                                    <input class="form-control" type="email" name="Email" value="@b.Email" maxlength="256" data-mask="email" />
                                                </div>
                                                <div class="col-md-6 mb-2">
                                                    <label class="form-label">Teléfono</label>
                                                    <input class="form-control" type="tel" name="Phone" value="@b.Phone" maxlength="20" data-mask="phone-cr" />
                                                </div>
                                                <div class="col-md-12 mb-2">
                                                    <label class="form-label">Dirección</label>
                                                    <input class="form-control" name="AddressLine" value="@b.AddressLine" maxlength="500" />
                                                </div>
                                                @* Spec 025 — Provincia → Cantón → Distrito cascade, pre-selected to current values. *@
                                                <div class="col-md-12 mb-2" data-testid="admin-branch-location-@b.Id">
                                                    <partial name="_LocationCascade" model="b.Location" />
                                                </div>
                                                <div class="col-md-12 mb-2">
                                                    <label class="form-label">Detalles de envío</label>
                                                    <textarea class="form-control" name="ShippingDetails" rows="2" maxlength="500">@b.ShippingDetails</textarea>
                                                </div>
                                                <div class="col-md-12 mb-2">
                                                    <label class="form-label">Garantía</label>
                                                    <textarea class="form-control" name="WarrantyInfo" rows="2" maxlength="500">@b.WarrantyInfo</textarea>
                                                </div>
                                            </div>
                                            <button type="submit" class="btn btn-primary btn-sm" data-testid="admin-branch-save-@b.Id">
                                                <i class="ti ti-device-floppy"></i> Guardar sucursal
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <a class="btn btn-secondary" href="@Url.Action("Index", "AdminSuppliers")">
            <i class="ti ti-arrow-left"></i> Volver al listado
        </a>
    </div>
</div>

@section Scripts {
    @* Spec 025 — Provincia → Cantón → Distrito cascade for the per-branch edit forms. *@
    <script src="~/js/location-cascade.js" asp-append-version="true"></script>
    @* Spec 026 — email/phone masks on the per-branch edit forms. *@
    <script src="~/js/input-masks.js" asp-append-version="true" defer></script>
}
