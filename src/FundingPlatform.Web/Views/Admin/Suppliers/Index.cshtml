@using FundingPlatform.Domain.Enums
@using FundingPlatform.Web.Resources
@model FundingPlatform.Web.ViewModels.Admin.AdminSupplierListViewModel
@{
    ViewData["Title"] = AdminSuppliersResources.Page_Title;
    string StatusLabel(SupplierVerificationStatus s) => s switch
    {
        SupplierVerificationStatus.Draft => "Borrador",
        SupplierVerificationStatus.PendingReview => AdminSuppliersResources.FilterStatus_PendingReview,
        SupplierVerificationStatus.Verified => AdminSuppliersResources.FilterStatus_Verified,
        SupplierVerificationStatus.Rejected => AdminSuppliersResources.FilterStatus_Rejected,
        _ => s.ToString(),
    };
    string StatusBadge(SupplierVerificationStatus s) => s switch
    {
        SupplierVerificationStatus.PendingReview => "bg-yellow-lt",
        SupplierVerificationStatus.Verified => "bg-green-lt",
        SupplierVerificationStatus.Rejected => "bg-red-lt",
        _ => "bg-secondary-lt",
    };
}

<div data-testid="admin-suppliers-area">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: AdminSuppliersResources.Page_Title,
            Subtitle: "Verifique, edite o rechace proveedores propuestos por los postulantes."))

    <form method="get" class="mb-3 d-flex gap-2 flex-wrap" data-testid="admin-suppliers-filter-form">
        <select name="status" class="form-select admin-suppliers-filter-control" data-testid="admin-suppliers-status-filter">
            <option value="">@AdminSuppliersResources.FilterStatus_All</option>
            @foreach (var s in new[] {
                SupplierVerificationStatus.PendingReview,
                SupplierVerificationStatus.Verified,
                SupplierVerificationStatus.Rejected,
                SupplierVerificationStatus.Draft })
            {
                <option value="@((int)s)" selected="@(Model.StatusFilter == s)">@StatusLabel(s)</option>
            }
        </select>
        <input type="search" name="legalId" value="@Model.LegalIdFilter" placeholder="Buscar por cédula"
               class="form-control admin-suppliers-filter-control" data-testid="admin-suppliers-legalid-filter" />
        <input type="search" name="name" value="@Model.NameFilter" placeholder="Buscar por nombre"
               class="form-control admin-suppliers-filter-control" data-testid="admin-suppliers-name-filter" />
        <div class="form-check form-check-inline align-self-center">
            <input class="form-check-input" type="checkbox" name="hasIncompleteCompliance" value="true"
                   id="ha-inc-comp" @(Model.HasIncompleteCompliance ? "checked" : "")
                   data-testid="admin-suppliers-incomplete-filter" />
            <label class="form-check-label" for="ha-inc-comp">Cumplimiento incompleto</label>
        </div>
        <button type="submit" class="btn btn-secondary">Aplicar</button>
    </form>

    @if (Model.Items.Count == 0)
    {
        // Spec 017 / FR-014 — distinguish unfiltered-empty from filtered-no-results.
        var supplierHasFilter = !string.IsNullOrWhiteSpace(Model.LegalIdFilter)
            || !string.IsNullOrWhiteSpace(Model.NameFilter)
            || Model.HasIncompleteCompliance;
        <div data-testid="admin-suppliers-empty">
            @if (supplierHasFilter)
            {
                @await Html.PartialAsync("Components/_EmptyState",
                    new EmptyStateViewModel(
                        Headline: "Sin coincidencias",
                        Body: "Pruebe con otros filtros o quite los aplicados.",
                        Icon: "ti ti-search",
                        IllustrationSceneKey: "magnifier-on-empty"))
            }
            else
            {
                @await Html.PartialAsync("Components/_EmptyState",
                    new EmptyStateViewModel(
                        Headline: "Sin proveedores pendientes",
                        Body: "Cuando un postulante envíe un proveedor para revisión, aparecerá acá.",
                        Icon: "ti ti-building-store",
                        IllustrationSceneKey: "folders-stack"))
            }
        </div>
    }
    else
    {
        <div class="card" data-testid="admin-suppliers-table">
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr>
                            <th>Cédula jurídica</th>
                            <th>Nombre</th>
                            <th>Estado</th>
                            <th>Sucursales</th>
                            <th>Cumplimiento</th>
                            <th>Última actualización</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Items)
                        {
                            <tr data-testid="admin-supplier-row-@row.Id">
                                <td><code>@row.LegalId</code></td>
                                <td>@row.Name</td>
                                <td>
                                    <span class="badge @StatusBadge(row.Status)">@StatusLabel(row.Status)</span>
                                </td>
                                <td>@row.BranchCount</td>
                                <td>
                                    @if (row.HasIncompleteCompliance)
                                    {
                                        <span class="badge bg-orange-lt"><i class="ti ti-alert-triangle"></i> Incompleto</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-green-lt"><i class="ti ti-check"></i> Completo</span>
                                    }
                                </td>
                                <td>@row.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       data-testid="row-action-detail"
                                       href="@Url.Action("Detail", "AdminSuppliers", new { supplierId = row.Id })">
                                        <i class="ti ti-eye"></i> Detalle
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-3" aria-label="Paginación" data-testid="admin-suppliers-pagination">
                <ul class="pagination">
                    <li class="page-item @(Model.HasPreviousPage ? null : "disabled")">
                        <a class="page-link" href="@Url.Action("Index", new {
                            status = (int?)Model.StatusFilter,
                            legalId = Model.LegalIdFilter,
                            name = Model.NameFilter,
                            hasIncompleteCompliance = Model.HasIncompleteCompliance,
                            page = Model.Page - 1, pageSize = Model.PageSize })">Anterior</a>
                    </li>
                    <li class="page-item active"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
                    <li class="page-item @(Model.HasNextPage ? null : "disabled")">
                        <a class="page-link" href="@Url.Action("Index", new {
                            status = (int?)Model.StatusFilter,
                            legalId = Model.LegalIdFilter,
                            name = Model.NameFilter,
                            hasIncompleteCompliance = Model.HasIncompleteCompliance,
                            page = Model.Page + 1, pageSize = Model.PageSize })">Siguiente</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
