@using FundingPlatform.Domain.Enums
@model FundingPlatform.Web.ViewModels.SigningStagePanelViewModel

@* Spec 021 / US7 / T149 / FR-029 — this partial is included on both the
   applicant Application/Details page (in scope for the sweep) AND the
   FundingAgreement/Details surface (legal carve-out). To keep the partial
   safe on the applicant surface, the header drops the word "financiamiento".
   The Funding Agreement PDF still renders the full legal name (separate view
   FundingAgreement/Document.cshtml). *@
<div class="card mb-4" id="funding-agreement-panel" data-application-id="@Model.ApplicationId">
    <div class="card-header">
        <strong>Convenio</strong>
    </div>
    <div class="card-body">
        @* Spec 024 — FundingAgreementSuccess/Error now surface as toasts via the TempData→toast bridge (_NotificationToasts). *@
        @if (Model.IsExecuted)
        {
            <div class="alert alert-success" role="alert" data-testid="funding-agreement-executed-badge">
                Convenio ejecutado.
            </div>

            @* Spec 036 / D7 / FR-001 — funds-usage evidence stage. Reviewer/admin-only
               (this partial is also shown to applicants), rendered only once the
               convenio is executed. *@
            @if (User.IsInRole("Reviewer") || User.IsInRole("Admin"))
            {
                <a class="btn btn-outline-primary mb-2"
                   data-testid="evidence-stage-link"
                   asp-controller="FundsUsageEvidence" asp-action="Index"
                   asp-route-applicationId="@Model.ApplicationId">
                    <i class="ti ti-folder"></i> @FundingPlatform.Web.Resources.FundsUsageEvidenceResources.Stage_CardLink
                </a>
            }
        }

        @if (Model.AgreementExists)
        {
            <p class="mb-2" data-testid="funding-agreement-metadata">
                <strong>Estado:</strong> @(Model.IsExecuted ? "Ejecutado" : "Generado")
                @if (Model.GeneratedAtUtc.HasValue)
                {
                    <text> &mdash; @Model.GeneratedAtUtc.Value.ToString("dd/MM/yyyy HH:mm") UTC</text>
                }
                @if (!string.IsNullOrWhiteSpace(Model.GeneratedByDisplayName))
                {
                    <text> por @Model.GeneratedByDisplayName</text>
                }
                <span class="text-muted"> &middot; versión @Model.GeneratedVersion</span>
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.AgreementDownloadUrl))
            {
                <a class="btn btn-primary" data-testid="funding-agreement-download"
                   href="@Model.AgreementDownloadUrl"
                   title="La descarga registra una entrada de auditoría AgreementDownloaded.">Descargar convenio</a>
            }

            @if (Model.ShowActions)
            {
                if (Model.CanRegenerate)
                {
                    <form method="post" class="d-inline ms-2"
                          action="@Url.RouteUrl(new { controller = "FundingAgreement", action = "Generate", applicationId = Model.ApplicationId })"
                          onsubmit="return confirm('Esta acción sobrescribirá el convenio actual. ¿Continuar?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-warning"
                                data-testid="funding-agreement-regenerate"
                                data-confirm
                                data-confirm-variant="statelocking"
                                data-confirm-title="Regenerar convenio"
                                data-confirm-body="Esta acción sobrescribirá el convenio actual. ¿Continuar?"
                                data-confirm-label="Regenerar">
                            Regenerar
                        </button>
                    </form>
                }
                else if (!string.IsNullOrWhiteSpace(Model.DisabledReason))
                {
                    <span class="text-muted ms-2" data-testid="funding-agreement-regenerate-disabled">
                        Regenerar deshabilitado: @Model.DisabledReason
                    </span>
                }
            }

            <hr />
            <h5 class="mt-3">Convenio firmado</h5>

            @if (Model.IsExecuted && !string.IsNullOrWhiteSpace(Model.ApprovedSignedDownloadUrl))
            {
                <a class="btn btn-outline-primary"
                   data-testid="signed-agreement-download"
                   href="@Model.ApprovedSignedDownloadUrl">Descargar convenio firmado</a>
            }
            else if (Model.PendingUpload is not null)
            {
                <div class="card border-info mb-3" data-testid="signed-upload-pending">
                    <div class="card-body">
                        <p class="mb-1"><strong>Pendiente de la decisión del revisor.</strong></p>
                        <p class="mb-1 small">
                            @Model.PendingUpload.FileName
                            &middot; @Model.PendingUpload.Size bytes
                            &middot; cargado el @Model.PendingUpload.UploadedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC
                        </p>
                        @if (Model.PendingUpload.GeneratedVersionAtUpload != Model.GeneratedVersion)
                        {
                            <p class="text-warning small mb-0" data-testid="signed-upload-version-mismatch">
                                Esta carga hace referencia a la versión @Model.PendingUpload.GeneratedVersionAtUpload;
                                la versión actual es la @Model.GeneratedVersion.
                            </p>
                        }

                        @if (Model.CanApplicantReplaceOrWithdraw)
                        {
                            <div class="mt-2 d-flex gap-2 flex-wrap">
                                <form method="post"
                                      enctype="multipart/form-data"
                                      action="@Url.Action("ReplaceUpload", "FundingAgreement", new { applicationId = Model.ApplicationId, signedUploadId = Model.PendingUpload.SignedUploadId })">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="GeneratedVersion" value="@Model.GeneratedVersion" />
                                    <input type="file" name="File" accept="application/pdf" required
                                           data-testid="signed-upload-replace-file" />
                                    <button type="submit" class="btn btn-outline-warning btn-sm"
                                            data-testid="signed-upload-replace">Reemplazar carga pendiente</button>
                                </form>
                                <form method="post"
                                      action="@Url.Action("WithdrawUpload", "FundingAgreement", new { applicationId = Model.ApplicationId, signedUploadId = Model.PendingUpload.SignedUploadId })"
                                      onsubmit="return confirm('¿Retirar la carga pendiente?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm"
                                            data-testid="signed-upload-withdraw"
                                            data-confirm
                                            data-confirm-variant="destructive"
                                            data-confirm-title="Retirar carga pendiente"
                                            data-confirm-body="¿Retirar la carga pendiente?"
                                            data-confirm-label="Retirar">Retirar carga pendiente</button>
                                </form>
                            </div>
                        }

                        @if (Model.CanReviewerAct)
                        {
                            <div class="mt-3 d-flex gap-2 flex-wrap align-items-start">
                                <form method="post"
                                      action="@Url.Action("Approve", "FundingAgreement", new { applicationId = Model.ApplicationId })">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="signedUploadId" value="@Model.PendingUpload.SignedUploadId" />
                                    <input type="text" name="comment" class="form-control form-control-sm d-inline-block signed-comment-input"
                                           placeholder="Comentario opcional"
                                           data-testid="signed-upload-approve-comment" />
                                    @* Spec 027 / US2 / FR-003 — execute is consequential; route the click
                                       through the spec-024 confirm dialog before committing. *@
                                    <button type="submit" class="btn btn-success btn-sm"
                                            data-testid="signed-upload-approve"
                                            data-confirm
                                            data-confirm-variant="statelocking"
                                            data-confirm-title="Ejecutar convenio"
                                            data-confirm-body="Esto ejecuta el convenio."
                                            data-confirm-label="Ejecutar">Aprobar</button>
                                </form>
                                <form method="post"
                                      action="@Url.Action("Reject", "FundingAgreement", new { applicationId = Model.ApplicationId })">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="signedUploadId" value="@Model.PendingUpload.SignedUploadId" />
                                    <textarea name="comment" class="form-control form-control-sm d-inline-block signed-comment-input"
                                              placeholder="Comentario de rechazo (obligatorio)" rows="1"
                                              data-testid="signed-upload-reject-comment"></textarea>
                                    @* Spec 027 / US2 / FR-003 — reject is consequential; confirm first.
                                       The mandatory comment stays enforced server-side (Reject action). *@
                                    <button type="submit" class="btn btn-outline-danger btn-sm"
                                            data-testid="signed-upload-reject"
                                            data-confirm
                                            data-confirm-variant="destructive"
                                            data-confirm-title="Rechazar carga"
                                            data-confirm-body="Esto rechaza la carga; el solicitante podrá enviar otra."
                                            data-confirm-label="Rechazar">Rechazar</button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (Model.CanApplicantUpload)
            {
                @if (Model.LastDecision is not null && Model.LastDecision.Outcome == SigningDecisionOutcome.Rejected)
                {
                    <div class="alert alert-warning" data-testid="signed-upload-last-rejection">
                        <strong>La última carga fue rechazada.</strong>
                        <span>@(string.IsNullOrWhiteSpace(Model.LastDecision.Comment) ? "(no se proporcionó comentario)" : Model.LastDecision.Comment)</span>
                    </div>
                }
                <form method="post"
                      enctype="multipart/form-data"
                      action="@Url.Action("Upload", "FundingAgreement", new { applicationId = Model.ApplicationId })">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="GeneratedVersion" value="@Model.GeneratedVersion" />
                    <div class="mb-2">
                        <label class="form-label">Cargar convenio firmado (PDF)</label>
                        <input type="file" name="File" accept="application/pdf" required
                               data-testid="signed-upload-file" />
                    </div>
                    <button type="submit" class="btn btn-success btn-sm"
                            data-testid="signed-upload-submit">Cargar convenio firmado</button>
                </form>
            }
            else
            {
                <p class="text-muted" data-testid="signed-upload-disabled">No hay cargas firmadas pendientes.</p>
            }
        }
        else
        {
            <p class="mb-2" data-testid="funding-agreement-empty">
                Aún no se ha generado ningún convenio.
            </p>

            @if (!Model.CanGenerate && !string.IsNullOrWhiteSpace(Model.DisabledReason))
            {
                <div class="alert alert-warning" data-testid="funding-agreement-disabled-reason">
                    @Model.DisabledReason
                </div>
            }

            @if (Model.ShowActions && Model.CanGenerate)
            {
                <form method="post"
                      action="@Url.RouteUrl(new { controller = "FundingAgreement", action = "Generate", applicationId = Model.ApplicationId })">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success"
                            data-testid="funding-agreement-generate">
                        Generar convenio
                    </button>
                </form>
            }
        }
    </div>
</div>
