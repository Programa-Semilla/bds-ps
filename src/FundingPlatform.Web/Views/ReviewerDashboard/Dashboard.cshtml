@using FundingPlatform.Web.ViewModels.Admin.Reports
@model int
@{
    ViewData["Title"] = "Panel del revisor";
}
@*
    Spec 021 / US6 / T138 / FR-033 / SC-010 — reviewer dashboard surface that
    hosts the *Cotizaciones pendientes* KPI tile. The tile moved here from
    the admin dashboard (R-12); admin no longer projects this counter.
*@

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: "Panel del revisor",
        Subtitle: "Indicadores rápidos para guiar su jornada de revisión."))

<div data-testid="reviewer-dashboard">
    <div class="row row-cards mt-3" data-testid="reviewer-kpi-strip">
        <div class="col-sm-6 col-lg-4">
            @await Html.PartialAsync("Components/_KpiTile",
                new KpiTileViewModel(
                    Label: "Cotizaciones pendientes",
                    NumericValue: Model,
                    Stack: null,
                    Href: Url.Action("Index", "Review"),
                    Slug: "pending-quotations"))
        </div>
    </div>

    <p class="mt-4">
        <a class="btn btn-outline-secondary" href="@Url.Action("Index", "Review")" data-testid="reviewer-go-to-queue">
            <i class="ti ti-clipboard-check me-1"></i>Ir a la cola de revisión
        </a>
    </p>
</div>
