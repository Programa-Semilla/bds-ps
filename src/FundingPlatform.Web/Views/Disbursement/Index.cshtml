@using FundingPlatform.Web.Resources
@model FundingPlatform.Web.ViewModels.Disbursements.DisbursementIndexViewModel
@{
    ViewData["Title"] = DisbursementResources.Title;
    var committedLines = Model.Composed is null
        ? new List<FundingPlatform.Application.Disbursements.BudgetLineBalance>()
        : Model.Composed.Tranches.SelectMany(t => t.Lines)
            .Where(l => l.CommitState == FundingPlatform.Domain.Enums.ItemCommitState.Committed)
            .ToList();
}

<div class="page-header d-print-none">
    <div class="container-xl">
        <h2 class="page-title">@DisbursementResources.Title</h2>
        <div class="text-secondary">@DisbursementResources.Subtitle</div>
    </div>
</div>

<div class="page-body">
    <div class="container-xl" data-testid="disbursement-surface">
        <partial name="_BalanceCard" model="Model.Balance" />

        @* Spec 046 — composed tranche → budget-line panel with per-line commit + filtering. *@
        <partial name="_TrancheBalancePanel" model="Model" />

        @if (Model.CanWrite)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="card-title">@DisbursementResources.Record_Heading</h3>
                    <form asp-controller="Disbursement" asp-action="Record" asp-route-applicationId="@Model.ApplicationId"
                          method="post" data-testid="disbursement-record-form">
                        <div class="row g-2">
                            <div class="col-md-3">
                                <label class="form-label">@DisbursementResources.Field_PaymentDate</label>
                                <input type="date" name="paymentDate" class="form-control" required
                                       data-testid="disbursement-payment-date" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@DisbursementResources.Field_Amount</label>
                                <input type="number" name="amount" class="form-control" min="0.01" step="0.01" required
                                       data-testid="disbursement-amount" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@DisbursementResources.Field_BankTransaction</label>
                                <input type="text" name="bankTransactionReference" class="form-control" maxlength="100" required
                                       data-testid="disbursement-bank-txn" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">@DisbursementResources.Field_BankAccount</label>
                                <input type="text" name="bankAccountReference" class="form-control" maxlength="100"
                                       data-testid="disbursement-bank-acct" />
                            </div>
                        </div>
                        @* Spec 046 / US3 — optional per-line split across committed budget-lines. *@
                        <partial name="_SplitEditor" model="committedLines" />
                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary" data-testid="disbursement-record-submit">
                                @DisbursementResources.Action_Record
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        <div class="card">
            <div class="table-responsive">
                <table class="table card-table table-vcenter" data-testid="disbursement-table">
                    <thead>
                        <tr>
                            <th>@DisbursementResources.Col_Date</th>
                            <th>@DisbursementResources.Col_Amount</th>
                            <th>@DisbursementResources.Col_State</th>
                            <th>@DisbursementResources.Col_Evidence</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-secondary" data-testid="disbursement-empty">
                                    @DisbursementResources.Empty
                                </td>
                            </tr>
                        }
                        @foreach (var item in Model.Items)
                        {
                            <partial name="_DisbursementRow" model="@((Model.ApplicationId, item))" />
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
