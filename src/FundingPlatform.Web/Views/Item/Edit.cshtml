@model FundingPlatform.Web.ViewModels.EditItemViewModel

@{
    ViewData["Title"] = "Editar ítem";
}

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: "Editar ítem",
        Breadcrumbs: new[]
        {
            new BreadcrumbItem("Mis solicitudes", Url.Action("Index", "Application")),
            new BreadcrumbItem($"Solicitud {Model.ApplicationId}", Url.Action("Edit", "Application", new { id = Model.ApplicationId })),
            new BreadcrumbItem("Editar ítem"),
        }))

<div class="card">
    <div class="card-body">
        <form asp-controller="Item" asp-action="Edit" asp-route-appId="@Model.ApplicationId" asp-route-itemId="@Model.Id" method="post"
              data-category-fields-url="@Url.Action("CategoryFields", "Item", new { appId = Model.ApplicationId, categoryId = "__CID__" })">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="ApplicationId" />
            <input type="hidden" asp-for="Id" />

            <div class="mb-3" data-testid="form-section" data-field="CategoryId">
                <label asp-for="CategoryId" class="form-label"></label> @await Html.PartialAsync("_RequiredMark") @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(ResourceKeyOverride: "Item.Category"))
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select" data-searchable
                        data-testid="item-category-select" id="item-category-select">
                    <option value="">-- Seleccione una categoría --</option>
                </select>
                <span asp-validation-for="CategoryId" class="invalid-feedback d-block"></span>
            </div>

            <div id="category-fields" data-testid="item-category-fields">
                <partial name="_DynamicFieldInputs" model="@((Model.CategoryFields, "CategoryFieldValues"))" />
            </div>

            <div class="mb-3" data-testid="form-section" data-field="ProductName">
                <label asp-for="ProductName" class="form-label"></label> @await Html.PartialAsync("_RequiredMark") @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(ResourceKeyOverride: "Item.ProductName"))
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="invalid-feedback d-block"></span>
            </div>

            <hr />

            @* Spec 035 (evolved) — attribution to the application's declared impacts + justification. *@
            <partial name="_ItemImpactAttribution" model="Model" />

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary" data-testid="item-save">Guardar cambios</button>
                <a asp-controller="Application" asp-action="Edit" asp-route-id="@Model.ApplicationId" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/dynamic-fields.js" asp-append-version="true"></script>
    <partial name="_DynamicFieldWiring" />
}
