@using FundingPlatform.Domain.Enums
@model FundingPlatform.Application.Applications.Queries.ApplicationReviewViewModel

@{
    // Spec 021 / T096 / FR-017 — read-only review surface before final submit.
    // FX disclaimer text mirrors the resx key Application.Disclaimer.Fx; the
    // project does not wire IStringLocalizer into views yet (see Edit.cshtml).
    const string FxDisclaimer = "El monto en colones puede variar según el tipo de cambio vigente en la fecha de compra.";
    const string ConfirmButtonText = "Confirmar y enviar";
    var publicCode = Model.PublicCode;
    ViewData["Title"] = $"Revisión — {publicCode}";
    var cultureCrc = new System.Globalization.CultureInfo("es-CR");
}

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: $"Revisión — {publicCode}",
        Subtitle: "Revise los detalles antes de enviar su solicitud.",
        Breadcrumbs: new[]
        {
            new BreadcrumbItem("Mis solicitudes", Url.Action("Index", "Application")),
            new BreadcrumbItem($"Solicitud {publicCode}", Url.Action("Details", "Application", new { id = Model.Id })),
            new BreadcrumbItem("Revisión"),
        }))

@* Spec 021 / T119 / FR-024 — stage countdown banner on /review surface (non-Draft read view). *@
@{
    var stageBanner = ViewData["StageBanner"] as FundingPlatform.Web.ViewModels.StageCountdownBannerViewModel;
    // Spec 044 / US3 — reception-window notice + timing gate on the Draft submit surface.
    var receptionNotice = ViewData["ReceptionNotice"] as FundingPlatform.Web.ViewModels.ReceptionWindowNoticeViewModel;
    var receptionCanSubmit = ViewData["ReceptionCanSubmit"] as bool? ?? true;
    // The applicant can only submit when fields are complete AND a window is open.
    var canSubmitNow = Model.CanSubmit && receptionCanSubmit;
}
@if (stageBanner is not null)
{
    @await Html.PartialAsync("_StageCountdownBanner", stageBanner)
}
@if (receptionNotice is not null)
{
    @await Html.PartialAsync("_ReceptionWindowNotice", receptionNotice)
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-6">
                <strong>Código:</strong>
                <code class="fl-public-code" data-testid="review-public-code">@publicCode</code>
            </div>
            <div class="col-md-6">
                <strong>Empresa:</strong> @Model.CompanyName
            </div>
        </div>
    </div>
</div>

@* Spec 035 (evolved 2026-06-16, D16) — the application's declared impacts (app level);
   per-line attribution + category fields render inside each item block below. *@
@if (Model.Impacts.Count > 0)
{
    <div class="card mb-4" data-testid="review-impacts-card">
        <div class="card-header"><h4 class="card-title">Impactos de la solicitud</h4></div>
        <div class="card-body">
            @foreach (var impact in Model.Impacts)
            {
                <div class="mb-2" data-testid="review-application-impact">
                    <strong>@impact.TemplateName</strong>
                    @if (impact.Parameters.Count > 0)
                    {
                        <dl class="row mb-0 mt-1 small">
                            @foreach (var p in impact.Parameters)
                            {
                                <dt class="col-sm-4 text-secondary">@p.Label</dt>
                                <dd class="col-sm-8">@p.Value</dd>
                            }
                        </dl>
                    }
                </div>
            }
        </div>
    </div>
}

<div class="card mb-4" data-testid="review-items-card">
    <div class="card-header">
        <h4 class="card-title">Ítems y cotizaciones</h4>
    </div>
    @if (Model.Items.Count == 0)
    {
        <div class="card-body">
            <p class="text-danger mb-0">
                <i class="ti ti-alert-triangle me-1"></i>
                Debe agregar al menos un ítem antes de enviar.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Categoría</th>
                        <th>Cotizaciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr data-testid="review-item-row">
                            <td>
                                @item.ProductName
                                @if (item.AttributedImpactNames.Count == 0)
                                {
                                    <span class="badge bg-warning-lt ms-1" data-testid="review-item-impact-missing-@item.Id">Impacto pendiente</span>
                                }
                            </td>
                            <td>@item.CategoryName</td>
                            <td>
                                <span class="badge bg-secondary">@item.Quotations.Count</span>
                                @if (item.Quotations.Count > 0)
                                {
                                    <ul class="list-unstyled mb-0 mt-2 small">
                                        @foreach (var q in item.Quotations)
                                        {
                                            <li>
                                                <span class="text-muted">@q.SupplierName:</span>
                                                @q.Price.ToString("N2") @q.Currency
                                                @if (q.ConvertedCrcAmount.HasValue
                                                    && !string.Equals(q.Currency, "CRC", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="text-muted">
                                                        (≈ @q.ConvertedCrcAmount.Value.ToString("C0", cultureCrc))
                                                    </span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </td>
                        </tr>
                        @if (item.CategoryFields.Count > 0 || item.AttributedImpactNames.Count > 0 || !string.IsNullOrWhiteSpace(item.ImpactJustification))
                        {
                            <tr data-testid="review-item-detail-@item.Id">
                                <td colspan="3" class="bg-light small">
                                    @if (item.CategoryFields.Count > 0)
                                    {
                                        <dl class="row mb-1">
                                            @foreach (var cf in item.CategoryFields)
                                            {
                                                <dt class="col-sm-4 text-secondary">@cf.Label</dt>
                                                <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(cf.Value) ? "—" : cf.Value)</dd>
                                            }
                                        </dl>
                                    }
                                    @if (item.AttributedImpactNames.Count > 0 || !string.IsNullOrWhiteSpace(item.ImpactJustification))
                                    {
                                        <div class="text-secondary"><strong>Impactos:</strong> @(item.AttributedImpactNames.Count > 0 ? string.Join(", ", item.AttributedImpactNames) : "—")</div>
                                        @if (!string.IsNullOrWhiteSpace(item.ImpactJustification))
                                        {
                                            <div><strong>Justificación:</strong> @item.ImpactJustification</div>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (Model.TotalCrc.HasValue)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-baseline">
                <div>
                    <strong>Total estimado (CRC)</strong>
                    <div class="text-secondary small">menor cotización por ítem</div>
                </div>
                <span data-testid="review-total-crc">
                    @Model.TotalCrc.Value.ToString("C0", cultureCrc)
                </span>
            </div>
            @if (Model.HasNonCrcQuotation)
            {
                @* Spec 021 / FR-022 — FX disclaimer below any CRC-converted total. *@
                <p class="text-secondary small mb-0 mt-1" data-testid="fx-disclaimer">
                    @FxDisclaimer
                </p>
            }
        </div>
    </div>
}

@if (Model.State == ApplicationState.Draft)
{
    @* Spec 021 — surface the missing-fields list ABOVE the submit button so
       the applicant sees the gating reasons before reaching the disabled
       control. Uses `alert-danger` (red) for blocking errors per the
       Tabler convention; `alert-warning` (pale yellow) is reserved for
       non-blocking advisories. *@
    @if (!canSubmitNow)
    {
        <div class="alert alert-danger" role="alert" data-testid="review-cannot-submit">
            <h4 class="alert-title">
                <i class="ti ti-alert-circle me-1" aria-hidden="true"></i>
                No se puede enviar todavía:
            </h4>
            <ul class="mb-0 mt-1">
                @* Spec 044 / FR-013 — the timing reason composes with the field reasons. *@
                @if (!receptionCanSubmit)
                {
                    <li data-testid="review-cannot-submit-timing">La recepción de solicitudes no está abierta en este momento.</li>
                }
                @if (Model.Items.Count == 0)
                {
                    <li>Al menos un ítem</li>
                }
                @if (Model.Impacts.Count == 0)
                {
                    <li>La solicitud debe declarar al menos un impacto</li>
                }
                @foreach (var item in Model.Items.Where(i => i.AttributedImpactNames.Count == 0))
                {
                    <li>Ítem "@item.ProductName" debe asociarse al menos a un impacto</li>
                }
                @foreach (var item in Model.Items.Where(i => i.Quotations.Count < Model.MinimumQuotationsPerItem))
                {
                    <li>Ítem "@item.ProductName" necesita al menos @Model.MinimumQuotationsPerItem cotizaciones</li>
                }
            </ul>
        </div>
    }

    <div class="d-flex justify-content-end gap-2 mb-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
            <i class="ti ti-arrow-left me-1"></i>Volver a editar
        </a>
        <form asp-action="SubmitByPublicCode" asp-route-publicCode="@publicCode" method="post">
            @Html.AntiForgeryToken()
            <button type="submit"
                    class="btn btn-success"
                    @(canSubmitNow ? "" : "disabled")
                    data-testid="review-confirm-submit"
                    title="@(canSubmitNow ? "Enviar definitivamente" : "Complete los campos faltantes o espere a que abra la recepción")">
                <i class="ti ti-send me-1"></i>@ConfirmButtonText
            </button>
        </form>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" asp-controller="Application" class="btn btn-link">&larr; Volver a solicitudes</a>
</div>

@section Scripts {
    <script type="module" src="~/js/public-code-banner.js" defer></script>
}
