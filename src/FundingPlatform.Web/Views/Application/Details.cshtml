@using FundingPlatform.Domain.Enums
@using FundingPlatform.Domain.ValueObjects
@model FundingPlatform.Web.ViewModels.ApplicationViewModel

@{
    ViewData["Title"] = $"Solicitud N.º {Model.Id}";
    var state = Enum.Parse<ApplicationState>(Model.State);
    var headerActions = new List<ActionItem>();
    if (Model.State == nameof(ApplicationState.Draft))
    {
        headerActions.Add(new ActionItem("Agregar ítem", ActionClass.Primary,
            Url: Url.Action("Add", "Item", new { appId = Model.Id }),
            Icon: "ti ti-plus"));
    }
    if (Model.State == nameof(ApplicationState.Resolved)
        || Model.State == nameof(ApplicationState.ResponseFinalized)
        || Model.State == nameof(ApplicationState.AppealOpen))
    {
        headerActions.Add(new ActionItem(
            Model.State == nameof(ApplicationState.Resolved) ? "Responder a la revisión" : "Ver respuesta",
            ActionClass.Primary,
            Url: Url.Action("Index", "ApplicantResponse", new { id = Model.Id }),
            Icon: "ti ti-message"));
    }
}

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: $"Solicitud N.º {Model.Id}",
        PrimaryActions: headerActions))

@if (TempData["ValidationErrors"] is string validationErrorsJson)
{
    var errors = System.Text.Json.JsonSerializer.Deserialize<List<string>>(validationErrorsJson);
    if (errors is not null && errors.Count > 0)
    {
        <div class="alert alert-danger" role="alert">
            <strong>No se puede enviar la solicitud:</strong>
            <ul class="mb-0 mt-1">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }
}

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-3">
                <strong>Estado:</strong>
                @await Html.PartialAsync("Components/_StatusPill", new StatusPillViewModel(state))
            </div>
            <div class="col-md-3">
                <strong>Creada:</strong> @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
            </div>
            <div class="col-md-3">
                <strong>Actualizada:</strong> @Model.UpdatedAt.ToString("dd/MM/yyyy HH:mm")
            </div>
            @if (Model.SubmittedAt.HasValue)
            {
                <div class="col-md-3">
                    <strong>Enviada:</strong> @Model.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm")
                </div>
            }
        </div>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Ítems</h4>
    @if (Model.TotalConvertedCrc.HasValue)
    {
        <div class="text-end" data-testid="application-total">
            <div class="text-muted small">Total estimado</div>
            <strong>
                @* Spec 015 / T413 — computed total summed in CRC across selected-supplier quotations.
                   originalCurrency = null routes the component to the CRC-only render path (no indicator). *@
                @await Component.InvokeAsync("MoneyDisplay", new
                {
                    original = Model.TotalConvertedCrc,
                    originalCurrency = (FundingPlatform.Domain.ValueObjects.CurrencyCode?)null,
                    convertedCrc = Model.TotalConvertedCrc,
                    snapshot = (FundingPlatform.Domain.ValueObjects.ExchangeRateSnapshot?)null
                })
            </strong>
            @if (Model.HasLegacyNeedsReview)
            {
                <div class="text-warning small" data-testid="application-total-legacy-note">
                    <i class="ti ti-alert-triangle"></i> El total excluye cotizaciones pendientes de revisión.
                </div>
            }
        </div>
    }
</div>

@if (Model.Items.Count == 0)
{
    @await Html.PartialAsync("Components/_EmptyState",
        new EmptyStateViewModel(
            Headline: "Aún no se han agregado ítems",
            Body: Model.State == nameof(ApplicationState.Draft)
                ? "Agregue al menos un ítem para enviar su solicitud."
                : "Esta solicitud no tiene ítems.",
            Icon: "ti ti-package",
            PrimaryAction: Model.State == nameof(ApplicationState.Draft)
                ? new ActionItem("Agregar ítem", ActionClass.Primary,
                    Url: Url.Action("Add", "Item", new { appId = Model.Id }),
                    Icon: "ti ti-plus")
                : null))
}
else
{
    <div class="card mb-4">
        <div class="table-responsive">
            <table class="table card-table table-vcenter">
                <thead>
                    <tr>
                        <th>Nombre del producto</th>
                        <th>Categoría</th>
                        <th>Cotizaciones</th>
                        <th>Impacto</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.ProductName</td>
                            <td>@item.CategoryName</td>
                            <td>
                                @* Spec 015 / T412 — per-Item quotation rows now render via the
                                   MoneyDisplayViewComponent, which delegates to the
                                   ConversionIndicatorViewComponent for non-CRC rows. The pre-T412
                                   rate-snapshot subblock is preserved (data-testid=quotation-rate-snapshot)
                                   so spec-015 US1 E2E selectors keep working. *@
                                <span class="badge bg-secondary">@item.QuotationCount</span>
                                @if (item.Quotations.Count > 0)
                                {
                                    <ul class="list-unstyled mb-0 mt-2 small" data-testid="quotation-list">
                                        @foreach (var q in item.Quotations)
                                        {
                                            ExchangeRateSnapshot? snapshot = null;
                                            if (q.SnapshotRateValue.HasValue
                                                && !string.IsNullOrEmpty(q.SnapshotRateType)
                                                && q.SnapshotEffectiveAtUtc.HasValue)
                                            {
                                                var rateType = Enum.Parse<RateType>(q.SnapshotRateType);
                                                snapshot = new ExchangeRateSnapshot(
                                                    Guid.Empty, q.SnapshotRateValue.Value, rateType,
                                                    q.SnapshotEffectiveAtUtc.Value);
                                            }
                                            CurrencyCode? originalCurrency = string.IsNullOrEmpty(q.Currency)
                                                ? null : CurrencyCode.From(q.Currency);
                                            <li class="mb-1" data-testid="quotation-row" data-quotation-id="@q.Id">
                                                <span class="text-muted">@q.SupplierName:</span>
                                                @await Component.InvokeAsync("MoneyDisplay", new
                                                {
                                                    original = (decimal?)q.Price,
                                                    originalCurrency = originalCurrency,
                                                    convertedCrc = q.ConvertedCrcAmount,
                                                    snapshot = snapshot
                                                })
                                                @if (q.SnapshotRateValue.HasValue && q.Currency != "CRC")
                                                {
                                                    <div class="text-muted small" data-testid="quotation-rate-snapshot">
                                                        Tipo de cambio: 1 @q.Currency = @q.SnapshotRateValue.Value.ToString("0.######") CRC
                                                        @if (q.SnapshotEffectiveAtUtc.HasValue)
                                                        {
                                                            <text>(vigente desde @q.SnapshotEffectiveAtUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</text>
                                                        }
                                                    </div>
                                                }
                                                @if (q.LegacyNeedsReview)
                                                {
                                                    <span class="badge bg-warning text-dark ms-1" data-testid="legacy-needs-review">Pendiente de revisión</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </td>
                            <td>
                                @if (item.HasImpact)
                                {
                                    <span class="status status-green"><i class="ti ti-check"></i> Completo</span>
                                }
                                else
                                {
                                    <span class="status status-yellow"><i class="ti ti-clock"></i> Pendiente</span>
                                }
                            </td>
                            <td>
                                @if (Model.State == nameof(ApplicationState.Draft))
                                {
                                    <a asp-controller="Supplier" asp-action="Add" asp-route-appId="@Model.Id" asp-route-itemId="@item.Id" class="btn btn-sm btn-outline-primary">Agregar proveedor</a>
                                    <a asp-controller="Item" asp-action="Edit" asp-route-appId="@Model.Id" asp-route-itemId="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                    <a asp-controller="Item" asp-action="Impact" asp-route-appId="@Model.Id" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Impacto</a>
                                    <form asp-controller="Item" asp-action="Delete" asp-route-appId="@Model.Id" asp-route-itemId="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de que desea eliminar este ítem?')">Eliminar</button>
                                    </form>
                                }
                            </td>
                        </tr>
                        @if (!string.IsNullOrEmpty(item.ReviewComment))
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="text-secondary small ps-2 border-start border-3 border-info py-1">
                                        <strong>Comentario del revisor:</strong> @item.ReviewComment
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.State == nameof(ApplicationState.Draft))
{
    <div class="d-flex justify-content-end mb-3">
        <form asp-controller="Application" asp-action="Submit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">
                <i class="ti ti-send me-1"></i>Enviar solicitud
            </button>
        </form>
    </div>
}

<div class="mt-3" id="funding-agreement-panel-container">
    <div data-async-panel-url="@Url.RouteUrl(new { controller = "FundingAgreement", action = "Panel", applicationId = Model.Id })">
        Cargando panel del convenio de financiamiento...
    </div>
</div>

<script>
(function () {
    var container = document.querySelector('#funding-agreement-panel-container > div[data-async-panel-url]');
    if (!container) return;
    var url = container.getAttribute('data-async-panel-url');
    fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'text/html' } })
        .then(function (r) { return r.ok ? r.text() : ''; })
        .then(function (html) {
            var target = document.getElementById('funding-agreement-panel-container');
            if (target) target.innerHTML = html;
        })
        .catch(function () { /* non-disclosing: silently drop on error */ });
})();
</script>

<div class="mt-3">
    <a asp-action="Index" asp-controller="Application" class="btn btn-link">&larr; Volver a solicitudes</a>
</div>
