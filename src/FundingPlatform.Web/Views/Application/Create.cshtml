@model FundingPlatform.Web.ViewModels.CreateApplicationViewModel

@{
    ViewData["Title"] = "Crear solicitud";
}

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: "Crear nueva solicitud",
        Subtitle: "Inicie un borrador de solicitud — puede agregar ítems y enviarla cuando esté lista.",
        Breadcrumbs: new[]
        {
            new BreadcrumbItem("Mis solicitudes", Url.Action("Index", "Application")),
            new BreadcrumbItem("Crear nueva"),
        }))

@* Spec 044 / US3 — reception-window timing notice for the selected/sole Process
   (renders nothing when unrestricted). *@
@{
    var receptionNotice = ViewData["ReceptionNotice"]
        as FundingPlatform.Web.ViewModels.ReceptionWindowNoticeViewModel;
}
@if (receptionNotice is not null)
{
    @await Html.PartialAsync("_ReceptionWindowNotice", receptionNotice)
}

<div class="card">
    <div class="card-body">
        @if (Model.HasNoEligibleGroups)
        {
            @* Spec 029 / FR-018 — no eligible Group under an Active Process + Fund: block creation. *@
            <div class="empty" data-testid="application-create-blocked">
                <div class="empty-icon"><i class="ti ti-lock"></i></div>
                <p class="empty-title">No está habilitado para postular en ningún proceso activo.</p>
                <p class="empty-subtitle text-secondary">
                    Comuníquese con la administración del Programa Semilla para que lo asignen a un proceso vigente.
                </p>
                <div class="empty-action">
                    <a asp-action="Index" asp-controller="Application" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Volver a mis solicitudes
                    </a>
                </div>
            </div>
        }
        else if (Model.HasNoCompanies)
        {
            @* Spec 037 / FR-014 — applicant has no active company: block creation. *@
            <div class="empty" data-testid="application-create-no-companies">
                <div class="empty-icon"><i class="ti ti-building-off"></i></div>
                <p class="empty-title">No tiene empresas asignadas.</p>
                <p class="empty-subtitle text-secondary">
                    No tiene empresas asignadas. Contacte a un administrador para continuar.
                </p>
                <div class="empty-action">
                    <a asp-action="Index" asp-controller="Application" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Volver a mis solicitudes
                    </a>
                </div>
            </div>
        }
        else
        {
            <p class="text-secondary">Seleccione la empresa solicitante y el proceso; podrá agregar ítems y enviarla cuando esté lista.</p>
            <form asp-action="Create" asp-controller="Application" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @* Spec 037 / FR-002 / FR-012–FR-013 — company selector (0/1/many). *@
                @if (Model.IsSingleCompany)
                {
                    <input type="hidden" asp-for="CompanyId" data-testid="application-create-company" />
                    <div class="mb-3">
                        <label class="form-label">@Html.DisplayNameFor(m => m.CompanyId)</label>
                        <input type="text" class="form-control" value="@Model.Companies.FirstOrDefault()?.Text"
                               disabled data-testid="application-create-company-readonly" />
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label asp-for="CompanyId" class="form-label"></label> @await Html.PartialAsync("_RequiredMark")
                        <select asp-for="CompanyId" asp-items="Model.Companies"
                                class="form-select" data-testid="application-create-company" data-searchable>
                            <option value="">— Seleccione una empresa —</option>
                        </select>
                        <span asp-validation-for="CompanyId" class="invalid-feedback d-block"
                              data-testid="application-create-company-error"></span>
                    </div>
                }

                @* Spec 029 / FR-018 — Process/convocatoria anchor. *@
                @if (Model.IsSingleEligibleGroup)
                {
                    <input type="hidden" asp-for="GroupId" data-testid="application-create-group" />
                    <div class="mb-3">
                        <label class="form-label">@Html.DisplayNameFor(m => m.GroupId)</label>
                        <input type="text" class="form-control" value="@Model.EligibleGroups.FirstOrDefault()?.Text"
                               disabled data-testid="application-create-group-readonly" />
                    </div>
                }
                else
                {
                    <div class="mb-3">
                        <label asp-for="GroupId" class="form-label"></label> @await Html.PartialAsync("_RequiredMark")
                        <select asp-for="GroupId" asp-items="Model.EligibleGroups"
                                class="form-select" data-testid="application-create-group" data-searchable>
                            <option value="">— Seleccione un proceso —</option>
                        </select>
                        <span asp-validation-for="GroupId" class="invalid-feedback d-block"
                              data-testid="application-create-group-error"></span>
                    </div>
                }

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" data-testid="application-create-submit">
                        <i class="ti ti-plus me-1"></i>Crear borrador de solicitud
                    </button>
                    <a asp-action="Index" asp-controller="Application" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-1"></i>Atrás
                    </a>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
