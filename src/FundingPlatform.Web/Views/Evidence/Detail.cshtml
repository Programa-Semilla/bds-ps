@using FundingPlatform.Web.Models
@using FundingPlatform.Web.Resources
@model FundingPlatform.Web.ViewModels.Evidence.EvidenceDetailViewModel
@{
    var d = Model.Detail;
    ViewData["Title"] = EvidenceResources.TypeLabel(d.Type);
    var esCr = System.Globalization.CultureInfo.GetCultureInfo("es-CR");
    var currentAllocations = d.Allocations.ToDictionary(a => a.ItemId, a => a.Amount);
}

<div data-testid="evidence-detail" data-evidence-id="@d.Id">
    @await Html.PartialAsync("Components/_PageHeader",
        new PageHeaderViewModel(
            Title: EvidenceResources.TypeLabel(d.Type),
            Subtitle: d.DocumentReferenceNumber,
            Breadcrumbs: new[]
            {
                new BreadcrumbItem(EvidenceResources.Title, Url.Action("Index", "Evidence", new { applicationId = Model.ApplicationId })),
                new BreadcrumbItem(EvidenceResources.TypeLabel(d.Type)),
            }))

    <div class="row">
        <div class="col-lg-5">
            <div class="card mb-4">
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-5">@EvidenceResources.Col_Type</dt>
                        <dd class="col-7"><span class="badge @EvidenceResources.TypeBadgeClass(d.Type)">@EvidenceResources.TypeLabel(d.Type)</span></dd>
                        <dt class="col-5">@EvidenceResources.Col_Amount</dt>
                        <dd class="col-7" data-testid="evidence-detail-amount">@d.Amount.ToString("N2", esCr) @d.Currency</dd>
                        <dt class="col-5">@EvidenceResources.Col_Reference</dt>
                        <dd class="col-7">@d.DocumentReferenceNumber</dd>
                        <dt class="col-5">@EvidenceResources.Col_Date</dt>
                        <dd class="col-7">@d.DocumentDate.ToString("dd/MM/yyyy")</dd>
                        @if (!string.IsNullOrWhiteSpace(d.SupplierName))
                        {
                            <dt class="col-5">@EvidenceResources.Col_Supplier</dt>
                            <dd class="col-7">@d.SupplierName</dd>
                        }
                        <dt class="col-5">@EvidenceResources.Col_UploadedBy</dt>
                        <dd class="col-7">@d.UploadedByDisplayName · @d.UploadedAtUtc.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                    <div class="mt-3">
                        <a asp-controller="Evidence" asp-action="Download"
                           asp-route-applicationId="@Model.ApplicationId" asp-route-evidenceId="@d.Id"
                           class="btn btn-outline-secondary" data-testid="evidence-detail-download">
                            <i class="ti ti-download"></i> @EvidenceResources.Action_Download
                        </a>
                        @if (Model.CanWrite)
                        {
                            <form method="post" asp-controller="Evidence" asp-action="Delete"
                                  asp-route-applicationId="@Model.ApplicationId" asp-route-evidenceId="@d.Id"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger" data-testid="evidence-delete"
                                        data-confirm data-confirm-variant="destructive"
                                        data-confirm-title="@EvidenceResources.Confirm_DeleteTitle"
                                        data-confirm-body="@EvidenceResources.Confirm_DeleteBody"
                                        data-confirm-label="@EvidenceResources.Confirm_DeleteLabel">
                                    <i class="ti ti-trash"></i> @EvidenceResources.Action_Delete
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>

            @if (Model.CanWrite)
            {
                <div class="card mb-4">
                    <div class="card-header"><h3 class="card-title">@EvidenceResources.Action_Allocate</h3></div>
                    <div class="card-body">
                        <form method="post" asp-controller="Evidence" asp-action="Allocate"
                              asp-route-applicationId="@Model.ApplicationId" asp-route-evidenceId="@d.Id"
                              data-testid="evidence-allocate-form">
                            @Html.AntiForgeryToken()
                            @await Html.PartialAsync("_AllocationEditor",
                                new FundingPlatform.Web.ViewModels.Evidence.AllocationEditorViewModel
                                {
                                    Lines = Model.Lines,
                                    Current = currentAllocations,
                                })
                            <button type="submit" class="btn btn-primary mt-2" data-testid="evidence-allocate-submit">
                                @EvidenceResources.Action_Allocate
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header"><h3 class="card-title">@EvidenceResources.Action_Replace</h3></div>
                    <div class="card-body">
                        <form method="post" asp-controller="Evidence" asp-action="Replace"
                              asp-route-applicationId="@Model.ApplicationId" asp-route-evidenceId="@d.Id"
                              enctype="multipart/form-data" data-testid="evidence-replace-form">
                            @Html.AntiForgeryToken()
                            <div class="mb-2">
                                <label class="form-label">@EvidenceResources.Field_Amount</label>
                                <input type="number" step="0.01" min="0" name="amount" class="form-control"
                                       value="@d.Amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                       data-testid="evidence-replace-amount" required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">@EvidenceResources.Field_Reference</label>
                                <input type="text" name="documentReferenceNumber" class="form-control" maxlength="100"
                                       value="@d.DocumentReferenceNumber" data-testid="evidence-replace-reference" required />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">@EvidenceResources.Field_DocumentDate</label>
                                <input type="date" name="documentDate" class="form-control"
                                       value="@d.DocumentDate.ToString("yyyy-MM-dd")" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">@EvidenceResources.Field_File</label>
                                <input type="file" name="file" class="form-control" accept="@Model.AcceptExtensions"
                                       data-testid="evidence-replace-file" />
                            </div>
                            <div class="mb-2">
                                <label class="form-label">@EvidenceResources.Field_Reason @await Html.PartialAsync("_RequiredMark")</label>
                                <input type="text" name="reason" class="form-control" maxlength="500"
                                       data-testid="evidence-replace-reason" required />
                                <div class="form-hint">@EvidenceResources.Field_ReasonHint</div>
                            </div>
                            <button type="submit" class="btn btn-outline-primary" data-testid="evidence-replace-submit">
                                @EvidenceResources.Action_Replace
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-7">
            <div class="card mb-4">
                <div class="card-header"><h3 class="card-title">@EvidenceResources.Col_Lines</h3></div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table" data-testid="evidence-allocations">
                        <thead><tr><th>@EvidenceResources.Alloc_Line</th><th class="text-end">@EvidenceResources.Alloc_Amount</th></tr></thead>
                        <tbody>
                            @if (d.Allocations.Count == 0)
                            {
                                <tr><td colspan="2" class="text-muted">@EvidenceResources.Alloc_None</td></tr>
                            }
                            @foreach (var a in d.Allocations)
                            {
                                <tr data-testid="evidence-allocation-row" data-item-id="@a.ItemId">
                                    <td>@a.LineLabel</td>
                                    <td class="text-end">@a.Amount.ToString("N2", esCr)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @await Html.PartialAsync("_VersionHistory", d.Versions)
        </div>
    </div>
</div>
