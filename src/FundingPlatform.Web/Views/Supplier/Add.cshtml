@using FundingPlatform.Application.Suppliers.DTOs
@using FundingPlatform.Domain.Enums
@using FundingPlatform.Web.Resources
@using FundingPlatform.Web.ViewModels
@model FundingPlatform.Web.ViewModels.AddSupplierViewModel

@{
    ViewData["Title"] = "Agregar proveedor con cotización";
    var convertUrl = Url.Action("Convert", "Quotation",
        new { appId = Model.ApplicationId, itemId = Model.ItemId });
}

<div class="row">
    <div class="col-md-10">
        <h2 class="mb-1">Agregar proveedor con cotización</h2>
        @if (!string.IsNullOrWhiteSpace(Model.ItemProductName))
        {
            <p class="text-muted mb-3" data-testid="supplier-add-item-name">
                Ítem: <strong>@Model.ItemProductName</strong>
            </p>
        }

        @if (Model.ShowConcurrentBanner)
        {
            <div class="alert alert-warning" role="alert" data-testid="supplier-concurrent-banner">
                @SuppliersResources.LookupConcurrentBanner
            </div>
        }

        <form asp-controller="Supplier" asp-action="Add"
              asp-route-appId="@Model.ApplicationId" asp-route-itemId="@Model.ItemId"
              method="post" enctype="multipart/form-data" id="add-supplier-form"
              data-quote-form
              data-convert-url="@convertUrl">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger" data-testid="supplier-validation-summary"></div>

            <input type="hidden" asp-for="ApplicationId" />
            <input type="hidden" asp-for="ItemId" />
            <input type="hidden" asp-for="SourceQuotationId" id="source-quotation-id" />

            @* Spec 035 / US3 — reuse an existing quotation from a sibling line item. *@
            @if (Model.ReusableQuotations.Count > 0)
            {
                <div class="card mb-3" data-testid="reuse-quotation-card">
                    <div class="card-body">
                        <h4 class="card-title">Reutilizar cotización existente</h4>
                        <p class="form-hint">
                            Use la misma cotización (proveedor y documento) de otra línea, con el precio propio de esta línea.
                        </p>
                        <select class="form-select" id="reuse-select" data-searchable data-testid="reuse-select">
                            <option value="">-- No reutilizar (agregar nueva) --</option>
                            @foreach (var r in Model.ReusableQuotations)
                            {
                                <option value="@r.SourceQuotationId">
                                    @r.SupplierName — @r.BranchName (@r.DocumentFileName, @r.Currency)
                                </option>
                            }
                        </select>
                    </div>
                </div>
            }

            <div id="add-new-supplier-sections">
            <div class="card mb-3">
                <div class="card-body">
                    <h4 class="card-title">Identificación del proveedor</h4>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            @* Spec 026 — type-aware masked supplier identification (Cédula jurídica / NITE).
                               The selector drives the mask on #supplier-legal-id-input; the 250 ms
                               debounce lookup below reads that same input. *@
                            @await Html.PartialAsync("_LegalIdField", new LegalIdFieldModel
                            {
                                TypeFieldName = nameof(Model.SupplierIdentificationType),
                                ValueFieldName = nameof(Model.SupplierLegalId),
                                SelectedType = Model.SupplierIdentificationType,
                                Value = Model.SupplierLegalId,
                                ValueLabel = "Identificación del proveedor",
                                AllowedTypes = new[]
                                {
                                    IdentificationType.CedulaJuridica,
                                    IdentificationType.Nite,
                                },
                                GroupId = "supplier-legal-id",
                                InputId = "supplier-legal-id-input",
                            })
                            <small class="form-hint">El sistema buscará al proveedor automáticamente.</small>
                        </div>
                    </div>
                </div>
            </div>

            <div id="lookup-result-region" data-testid="lookup-result-region">
                @if (Model.LookupResult is not null)
                {
                    @switch (Model.LookupResult.Outcome)
                    {
                        case SupplierLookupOutcome.Hit:
                            await Html.RenderPartialAsync("_LookupHit", Model.LookupResult.Supplier!);
                            break;
                        case SupplierLookupOutcome.Rejected:
                            await Html.RenderPartialAsync("_LookupRejected");
                            break;
                        case SupplierLookupOutcome.Empty:
                            await Html.RenderPartialAsync("_LookupEmpty",
                                Model.NewSupplier ?? new FundingPlatform.Web.ViewModels.NewSupplierInputViewModel
                                {
                                    Name = string.Empty,
                                    FirstBranch = new FundingPlatform.Web.ViewModels.AddBranchInputViewModel
                                    {
                                        BranchName = SuppliersResources.Branch_Default,
                                    },
                                });
                            break;
                    }
                }
            </div>
            </div>@* /add-new-supplier-sections *@

            <div class="card mb-3">
                <div class="card-body">
                    <h4 class="card-title">Detalles de la cotización</h4>
                    @* Spec 023 / FR-003 — shared Price / Currency / ValidUntil block plus
                       the conversion-preview alert. Same markup is reused by Quotation/Edit. *@
                    <partial name="_QuoteFields" model="@((FundingPlatform.Web.ViewModels.IQuoteFieldsModel)Model)" />

                    <div class="mb-3" id="quotation-file-section">
                        <label asp-for="QuotationFile" class="form-label"></label> @await Html.PartialAsync("_RequiredMark")
                        <input asp-for="QuotationFile" class="form-control" type="file" data-testid="quotation-file-input" />
                        <span asp-validation-for="QuotationFile" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary" data-testid="supplier-submit-button">
                Agregar proveedor y cotización
            </button>
            <a asp-controller="Application" asp-action="Details" asp-route-id="@Model.ApplicationId"
               class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* Spec 035 / US3 — reuse toggle: hide the add-new sections + upload when reusing. *@
    <script>
        (function () {
            var sel = document.getElementById('reuse-select');
            var hidden = document.getElementById('source-quotation-id');
            var addNew = document.getElementById('add-new-supplier-sections');
            var fileSection = document.getElementById('quotation-file-section');
            var submitBtn = document.querySelector('[data-testid="supplier-submit-button"]');
            if (!sel || !hidden) { return; }
            sel.addEventListener('change', function () {
                var reusing = !!this.value;
                hidden.value = reusing ? this.value : '';
                if (addNew) { addNew.style.display = reusing ? 'none' : ''; }
                if (fileSection) { fileSection.style.display = reusing ? 'none' : ''; }
                var fileInput = fileSection ? fileSection.querySelector('input[type=file]') : null;
                if (fileInput) { fileInput.disabled = reusing; }
                if (submitBtn) {
                    submitBtn.textContent = reusing ? 'Reutilizar cotización' : 'Agregar proveedor y cotización';
                }
            });
        })();
    </script>
    <script src="~/js/quote-conversion-preview.js" asp-append-version="true"></script>
    @* Spec 025 — Provincia → Cantón → Distrito cascade. Event-delegated, so it
       drives the AJAX-injected _LookupEmpty / _BranchPicker partials too. *@
    <script src="~/js/location-cascade.js" asp-append-version="true"></script>
    @* Spec 026 — masks (supplier identification + email/phone on injected partials),
       event-delegated so it covers the AJAX-injected _LookupEmpty / _BranchPicker. *@
    <script src="~/js/input-masks.js" asp-append-version="true" defer></script>
    <script>
        // Spec 013 NFR-004: 250ms-debounced legal-ID lookup. Calls the server-rendered
        // /Search partial and replaces the lookup-result region in the DOM. Vanilla JS,
        // no external dependencies.
        (function () {
            const input = document.getElementById('supplier-legal-id-input');
            const region = document.getElementById('lookup-result-region');
            if (!input || !region) return;

            const baseUrl = '@Url.Action("Search", "Supplier", new { appId = Model.ApplicationId, itemId = Model.ItemId })';
            let timer = null;

            function runLookup() {
                const legalId = input.value.trim();
                if (legalId.length === 0) {
                    region.innerHTML = '';
                    return;
                }
                const url = baseUrl + '?legalId=' + encodeURIComponent(legalId);
                fetch(url, { headers: { 'Accept': 'text/html' } })
                    .then(r => r.ok ? r.text() : Promise.reject(r.status))
                    .then(html => { region.innerHTML = html; })
                    .catch(() => { /* swallow — user can retry */ });
            }

            input.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(runLookup, 250);
            });
        })();
    </script>
}
