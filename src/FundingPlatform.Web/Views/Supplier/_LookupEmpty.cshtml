@using FundingPlatform.Web.Resources
@model FundingPlatform.Web.ViewModels.NewSupplierInputViewModel

<div class="card mb-3" data-testid="supplier-lookup-empty">
    <div class="card-body">
        <h4 class="card-title">Nuevo proveedor</h4>
        <p class="text-muted small">@SuppliersResources.NewSupplierForm_Hint</p>

        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label">Razón social del proveedor</label>
                <input name="NewSupplier.Name" class="form-control" required maxlength="300"
                       data-testid="new-supplier-name-input" />
            </div>
        </div>

        <h6 class="mt-3">Datos de la sucursal principal</h6>
        <div class="row">
            <div class="col-md-6 mb-2">
                <label class="form-label">Nombre de la sucursal</label>
                <input name="NewSupplier.FirstBranch.BranchName" class="form-control" required maxlength="200"
                       value="@SuppliersResources.Branch_Default"
                       data-testid="new-supplier-branch-name" />
            </div>
            <div class="col-md-6 mb-2">
                <label class="form-label">Persona de contacto</label>
                <input name="NewSupplier.FirstBranch.ContactName" class="form-control" maxlength="200"
                       data-testid="new-supplier-branch-contact" />
            </div>
            <div class="col-md-6 mb-2">
                <label class="form-label">Correo electrónico</label>
                <input name="NewSupplier.FirstBranch.Email" type="email" class="form-control" maxlength="256"
                       data-testid="new-supplier-branch-email" />
            </div>
            <div class="col-md-6 mb-2">
                <label class="form-label">Teléfono</label>
                <input name="NewSupplier.FirstBranch.Phone" type="tel" class="form-control" maxlength="20"
                       data-testid="new-supplier-branch-phone" />
            </div>
            <div class="col-md-8 mb-2">
                <label class="form-label">Dirección</label>
                <input name="NewSupplier.FirstBranch.AddressLine" class="form-control" maxlength="500"
                       data-testid="new-supplier-branch-address" />
            </div>
            <div class="col-md-4 mb-2">
                <label class="form-label">Provincia</label>
                <input name="NewSupplier.FirstBranch.Province" class="form-control" maxlength="100"
                       data-testid="new-supplier-branch-province" />
            </div>
            <div class="col-md-12 mb-2">
                <label class="form-label">Detalles de envío</label>
                <textarea name="NewSupplier.FirstBranch.ShippingDetails" class="form-control" rows="2" maxlength="500"
                          data-testid="new-supplier-branch-shipping"></textarea>
            </div>
            <div class="col-md-12 mb-2">
                <label class="form-label">Información de garantía</label>
                <textarea name="NewSupplier.FirstBranch.WarrantyInfo" class="form-control" rows="2" maxlength="500"
                          data-testid="new-supplier-branch-warranty"></textarea>
            </div>
        </div>
    </div>
</div>
