@model EmailRenderModel
@{
    ViewData["Title"] = Model.Subject;
}
@await Html.PartialAsync("~/Views/Emails/Shared/_Hero.cshtml", "Apelación concedida: solicitud reabierta")
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">Hola, @Model.Recipient.DisplayName:</p>
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
    Te informamos que se concedió la apelación de <strong>@Model.Payload.ApplicantDisplayName</strong> y la
    solicitud volvió a revisión en @EmailBrand.PlatformName.
</p>
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
    Podés ingresar a la plataforma para retomar el análisis del caso según corresponda a tu perfil.
</p>
@await Html.PartialAsync("~/Views/Emails/Shared/_StatusCard.cshtml", new StatusCardModel("Detalle de la solicitud", new List<DetailRow> { new("Solicitante", Model.Payload.ApplicantDisplayName), new("Número de solicitud", $"#{Model.Payload.ApplicationId}") }))
@await Html.PartialAsync("~/Views/Emails/Shared/_CtaButton.cshtml", new CtaButtonModel(Model.CtaUrl, "Revisar solicitud"))
