@model EmailRenderModel
@{
    ViewData["Title"] = Model.Subject;
}
@await Html.PartialAsync("~/Views/Emails/Shared/_Hero.cshtml", "Nuevo mensaje del revisor")
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">Hola, @Model.Recipient.DisplayName:</p>
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
    Te informamos que un revisor respondió en la apelación de tu solicitud
    <strong>#@Model.Payload.ApplicationId</strong> en @EmailBrand.PlatformName.
</p>
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
    Podés ingresar a la plataforma para leer el mensaje y continuar la conversación.
</p>
@await Html.PartialAsync("~/Views/Emails/Shared/_CtaButton.cshtml", new CtaButtonModel(Model.CtaUrl, "Ver mi apelación"))
