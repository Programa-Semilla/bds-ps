@{
    ViewData["Title"] = Model.Subject;
}
@await Html.PartialAsync("~/Views/Emails/Shared/_Hero.cshtml", "Necesitamos información adicional")
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">Hola, @Model.Recipient.DisplayName:</p>
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
    Te informamos que tu solicitud <strong>#@Model.Payload.ApplicationId</strong> requiere información adicional antes de continuar con el proceso de revisión.
</p>
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
    Podés ingresar a @EmailBrand.PlatformName para revisar los detalles, realizar los ajustes solicitados y reenviar tu solicitud.
</p>
@await Html.PartialAsync("~/Views/Emails/Shared/_CtaButton.cshtml", new CtaButtonModel(Model.CtaUrl, "Actualizar mi solicitud"))
