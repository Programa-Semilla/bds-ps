@{
    ViewData["Title"] = Model.Subject;
}
<h1>Acción requerida en tu solicitud</h1>
<p>Hola @Model.Recipient.DisplayName,</p>
<p>
    Tu solicitud <strong>#@Model.Payload.ApplicationId</strong> fue devuelta por el equipo
    revisor porque requiere actualizaciones de tu parte antes de continuar con el proceso.
    Revisa los detalles desde tu panel y realiza los cambios solicitados.
</p>
<p>
    <a class="cta" href="@Model.CtaUrl">Actualizar mi solicitud</a>
</p>
<p>Si el botón no funciona, copia y pega este enlace en tu navegador:<br />
    <span style="color:#6e6e73;font-size:13px;">@Model.CtaUrl</span></p>
