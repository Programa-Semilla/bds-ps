@model EmailRenderModel
@{
    ViewData["Title"] = Model.Subject;
}
@await Html.PartialAsync("~/Views/Emails/Shared/_Hero.cshtml", "Resolución de tu apelación")
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">Hola, @Model.Recipient.DisplayName:</p>
@switch (Model.Payload.OutcomeCode)
{
    case "AppealReopenedToDraft":
        <p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
            Te informamos que tu apelación sobre la solicitud <strong>#@Model.Payload.ApplicationId</strong> fue
            <strong>concedida</strong>. Tu solicitud se reabrió como borrador para que la actualices y la vuelvas a
            enviar en @EmailBrand.PlatformName.
        </p>
        break;
    case "AppealReopenedToReview":
        <p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
            Te informamos que tu apelación sobre la solicitud <strong>#@Model.Payload.ApplicationId</strong> fue
            <strong>concedida</strong>. Tu solicitud volvió a revisión; el equipo la analizará nuevamente y te
            informaremos del resultado.
        </p>
        break;
    default:
        <p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
            Te informamos que tu apelación sobre la solicitud <strong>#@Model.Payload.ApplicationId</strong> fue
            revisada y la resolución <strong>se mantuvo</strong>. Podés consultar los detalles desde tu panel.
        </p>
        break;
}
@await Html.PartialAsync("~/Views/Emails/Shared/_CtaButton.cshtml", new CtaButtonModel(Model.CtaUrl, "Ver mi solicitud"))
