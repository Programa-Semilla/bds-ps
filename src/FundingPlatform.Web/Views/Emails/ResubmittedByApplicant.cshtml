@{
    ViewData["Title"] = Model.Subject;
}
<h1>Solicitud reenviada para revisión</h1>
<p>Hola @Model.Recipient.DisplayName,</p>
<p>
    <strong>@Model.Payload.ApplicantDisplayName</strong> actualizó y reenvió su solicitud
    <strong>(#@Model.Payload.ApplicationId)</strong> después de los cambios solicitados. Está
    lista para una nueva revisión.
</p>
<p>
    <a class="cta" href="@Model.CtaUrl">Continuar revisión</a>
</p>
<p>Si el botón no funciona, copia y pega este enlace en tu navegador:<br />
    <span style="color:#6e6e73;font-size:13px;">@Model.CtaUrl</span></p>
