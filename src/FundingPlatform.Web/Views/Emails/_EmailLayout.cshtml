@{
    var subject = ViewData["Title"] as string ?? Model.Subject;
}<!DOCTYPE html>
<html lang="es-CR">
<head>
<meta charset="UTF-8" />
<title>@subject</title>
<style>
    body { margin: 0; padding: 0; background: #f5f5f7; font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif; color: #1d1d1f; }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; padding: 32px 40px; }
    .wordmark { font-family: 'Fraunces', Georgia, serif; font-size: 22px; font-weight: 600; letter-spacing: -0.01em; color: #1d1d1f; margin: 0 0 4px 0; }
    .sender-line { font-size: 13px; color: #6e6e73; margin: 0 0 28px 0; }
    h1 { font-family: 'Fraunces', Georgia, serif; font-size: 24px; font-weight: 600; margin: 0 0 16px 0; color: #1d1d1f; }
    p { line-height: 1.55; font-size: 15px; margin: 0 0 16px 0; color: #1d1d1f; }
    .cta { display: inline-block; padding: 12px 24px; background: #1d1d1f; color: #ffffff !important; text-decoration: none; border-radius: 8px; font-weight: 500; font-size: 15px; margin: 16px 0; }
    .signature { font-size: 14px; color: #1d1d1f; margin-top: 32px; }
    .signature .name { font-weight: 600; }
    hr.sep { border: 0; border-top: 1px solid #e5e5ea; margin: 28px 0; }
    .footer { font-size: 12px; color: #6e6e73; line-height: 1.5; }
    .footer a { color: #6e6e73; }
</style>
</head>
<body>
<div class="container">
    @* Spec 021 / FR-023 / NFR-001 — text-only wordmark; no inline <img>. *@
    <p class="wordmark">Programa Semilla</p>
    <p class="sender-line">Sistema de Banca para el Desarrollo</p>
    @RenderBody()
    <div class="signature">
        <p style="margin: 0 0 4px 0;">Saludos cordiales,</p>
        <p class="name" style="margin: 0;">Programa Semilla</p>
        <p style="margin: 4px 0 0 0; color: #6e6e73;">Sistema de Banca para el Desarrollo</p>
    </div>
    <hr class="sep" />
    @await Html.PartialAsync("_SupportFooter")
</div>
</body>
</html>
