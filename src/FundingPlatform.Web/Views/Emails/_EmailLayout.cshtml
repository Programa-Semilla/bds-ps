@model FundingPlatform.Application.Notifications.Email.IBrandedEmailModel
@{
    // Spec 041 — branded shell shared by EVERY in-scope email (outbox + direct-send).
    // Table-based, inline-CSS, ≤600px, no flexbox/grid, no external CSS (NFR-001/002).
    // Palette mirrors Web.Services.Emails.EmailBrand (teal #008a9e / #42afa8, orange
    // #f9a61c, yellow #ffc729); hex is inlined here for email-client reliability.
    var subject = ViewData["Title"] as string ?? Model.Subject;
}<!DOCTYPE html>
<html lang="es-CR" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="color-scheme" content="light only" />
    <meta name="supported-color-schemes" content="light only" />
    <title>@subject</title>
    <!--[if mso]>
    <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
    <![endif]-->
</head>
<body style="margin:0;padding:0;background:#f4f6f7;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;">
    @* Preheader — pulled from the subject; hidden but read by inbox previews. *@
    <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:#f4f6f7;opacity:0;">@subject</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#f4f6f7;width:100%;border-collapse:collapse;">
        <tr>
            <td align="center" style="padding:24px 12px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px;max-width:600px;background:#ffffff;border:1px solid #dbe3e4;border-radius:14px;border-collapse:separate;overflow:hidden;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;color:#243b40;">
                    <tr>
                        <td>@await Html.PartialAsync("~/Views/Emails/Shared/_BrandHeader.cshtml", Model.LogoUrl)</td>
                    </tr>
                    <tr>
                        <td style="padding:28px 36px 4px 36px;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
                            @RenderBody()
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:18px 36px 30px 36px;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
                            <p style="margin:0 0 2px 0;">@FundingPlatform.Web.Services.Emails.EmailBrand.SignOffClosing</p>
                            <p style="margin:0;font-weight:600;color:#008a9e;">@FundingPlatform.Web.Services.Emails.EmailBrand.SignOff</p>
                        </td>
                    </tr>
                    <tr>
                        <td>@await Html.PartialAsync("~/Views/Emails/Shared/_PartnerFooter.cshtml", Model.PartnerStripUrl)</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>
