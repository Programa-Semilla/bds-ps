@{
    ViewData["Title"] = Model.Subject;
}
<h1>Convenio firmado reemplazado</h1>
<p>Hola @Model.Recipient.DisplayName,</p>
<p>
    El solicitante <strong>@Model.Payload.ApplicantDisplayName</strong> reemplazó el convenio
    firmado pendiente de la solicitud <strong>#@Model.Payload.ApplicationId</strong>. La nueva
    versión está lista para tu revisión en la bandeja de firmas.
</p>
<p>
    <a class="cta" href="@Model.CtaUrl">Ir a la bandeja de firmas</a>
</p>
<p>Si el botón no funciona, copiá y pegá este enlace en tu navegador:<br />
    <span style="color:#6e6e73;font-size:13px;">@Model.CtaUrl</span></p>
