@{
    ViewData["Title"] = Model.Subject;
}
<h1>Solicitud retirada</h1>
<p>Hola @Model.Recipient.DisplayName,</p>
<p>
    <strong>@Model.Payload.ApplicantDisplayName</strong> retiró su solicitud
    <strong>(#@Model.Payload.ApplicationId)</strong> mientras estaba en revisión.
    Ya no aparece en tu cola de revisión y no requiere ninguna acción de tu parte.
</p>
<p>
    <a class="cta" href="@Model.CtaUrl">Ver la cola de revisión</a>
</p>
<p>Si el botón no funciona, copia y pega este enlace en tu navegador:<br />
    <span style="color:#6e6e73;font-size:13px;">@Model.CtaUrl</span></p>
