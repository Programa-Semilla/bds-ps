@*
    Spec 021 / T118 / FR-025 — T-24h stage-expiry reminder email body.
    See T72ReminderEmail.cshtml for the token-substitution contract.
*@
<!DOCTYPE html>
<html lang="es-CR">
<head>
    <meta charset="utf-8" />
    <title>Su solicitud {{PublicCode}} cierra en 24 horas</title>
</head>
<body style="font-family: 'Inter', Arial, sans-serif; color: #232323; background: #F7F5F0; margin: 0; padding: 24px;">
    <div style="max-width: 600px; margin: 0 auto; background: #FFFFFF; border-radius: 8px; padding: 32px; border: 1px solid #E5E1D8;">
        <h2 style="color: #B45309; margin-top: 0;">Su solicitud cierra en 24 horas</h2>
        <p>Hola {{ApplicantName}},</p>
        <p>
            Quedan menos de 24 horas para que la etapa <strong>{{StageName}}</strong>
            de su solicitud <strong>{{PublicCode}}</strong> cierre.
        </p>
        <p>
            Cierre programado: <strong>{{ClosesAtLocal}}</strong>.
        </p>
        <p style="color: #B45309;">
            Si la ventana se cumple sin acción, la solicitud quedará bloqueada y
            cualquier intento de envío será rechazado por el sistema (HTTP 422).
        </p>
        <p style="color: #666; font-size: 0.85rem; margin-top: 32px;">
            Programa Semilla — Sistema de Banca para el Desarrollo
        </p>
    </div>
</body>
</html>
