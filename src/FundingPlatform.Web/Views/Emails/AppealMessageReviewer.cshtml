@{
    ViewData["Title"] = Model.Subject;
}
<h1>Nuevo mensaje en la apelación</h1>
<p>Hola @Model.Recipient.DisplayName,</p>
<p>
    El solicitante <strong>@Model.Payload.ApplicantDisplayName</strong> escribió un nuevo
    mensaje en la apelación de la solicitud <strong>#@Model.Payload.ApplicationId</strong>.
    Ingresá a la apelación para leerlo y responder.
</p>
<p>
    <a class="cta" href="@Model.CtaUrl">Ver la apelación</a>
</p>
<p>Si el botón no funciona, copiá y pegá este enlace en tu navegador:<br />
    <span style="color:#6e6e73;font-size:13px;">@Model.CtaUrl</span></p>
