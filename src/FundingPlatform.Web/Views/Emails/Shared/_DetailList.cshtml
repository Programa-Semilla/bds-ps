@model IReadOnlyList<FundingPlatform.Application.Notifications.Email.DetailRow>
@* Spec 041 / T010 — key/value rows used inside _StatusCard. Long values wrap
   (word-break) so the card never overflows the 600px shell. *@
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;">
    @foreach (var row in Model)
    {
        <tr>
            <td style="padding:3px 14px 3px 0;font-family:'Inter',Arial,sans-serif;font-size:14px;line-height:1.5;color:#5b6b6e;vertical-align:top;">@row.Label</td>
            <td style="padding:3px 0;font-family:'Inter',Arial,sans-serif;font-size:14px;line-height:1.5;color:#243b40;font-weight:600;word-break:break-word;vertical-align:top;">@row.Value</td>
        </tr>
    }
</table>
