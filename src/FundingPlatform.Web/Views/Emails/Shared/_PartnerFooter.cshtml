@model string
@* Spec 041 / T007 / FR-006 — partner-logo strip + support line (email AND phone)
   + automatic-message note. Present on EVERY email. Replaces _SupportFooter. *@
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;background:#eef6f7;border-top:1px solid #dbe3e4;border-collapse:collapse;">
    <tr>
        <td align="center" style="padding:22px 24px 12px 24px;">
            <img src="@Model"
                 alt="Aliados: Banca para el Desarrollo, CROCUS, nexo, De la Mano con su PYME, Programa Semilla"
                 width="520"
                 style="display:block;border:0;outline:none;text-decoration:none;height:auto;width:100%;max-width:520px;" />
        </td>
    </tr>
    <tr>
        <td align="center" style="padding:6px 28px 22px 28px;font-family:'Inter',Arial,sans-serif;font-size:12px;line-height:1.6;color:#5b6b6e;">
            <p style="margin:0 0 4px 0;">Para consultas: <a href="mailto:soporte@@programa-semilla.cr" style="color:#008a9e;text-decoration:none;">@EmailBrand.SupportEmail</a> &nbsp;·&nbsp; @EmailBrand.SupportPhone</p>
            <p style="margin:0;">@EmailBrand.AutomaticMessageNote</p>
        </td>
    </tr>
</table>
