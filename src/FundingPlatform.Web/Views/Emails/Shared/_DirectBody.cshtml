@model DirectEmailModel
@* Spec 041 / Decision 1 — shared HTML body for every direct-send / notifier email
   (identity, stage, supplier, company), composed of the same partials as the outbox
   bodies so all emails share one design system. *@
@{
    var greeting = string.IsNullOrWhiteSpace(Model.DisplayName) ? "Hola:" : $"Hola, {Model.DisplayName}:";
}
@await Html.PartialAsync("~/Views/Emails/Shared/_Hero.cshtml", Model.HeroTitle)
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">@greeting</p>
@foreach (var para in Model.Paragraphs)
{
    <p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">@para</p>
}
@if (Model.CardHeading is { } cardHeading && Model.CardRows is { } cardRows)
{
    @await Html.PartialAsync("~/Views/Emails/Shared/_StatusCard.cshtml", new StatusCardModel(cardHeading, cardRows))
}
@await Html.PartialAsync("~/Views/Emails/Shared/_CtaButton.cshtml", new CtaButtonModel(Model.CtaUrl, Model.CtaLabel ?? string.Empty))
@if (!string.IsNullOrWhiteSpace(Model.FooterNote))
{
    <p style="margin:8px 0 0 0;font-family:'Inter',Arial,sans-serif;font-size:13px;line-height:1.6;color:#5b6b6e;">@Model.FooterNote</p>
}
