@{
    ViewData["Title"] = Model.Subject;
}
@await Html.PartialAsync("~/Views/Emails/Shared/_Hero.cshtml", "Tu convenio fue ejecutado")
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">Hola, @Model.Recipient.DisplayName:</p>
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
    ¡Felicitaciones! El convenio firmado de tu solicitud <strong>#@Model.Payload.ApplicationId</strong> fue aprobado y
    quedó <strong>ejecutado</strong> en @EmailBrand.PlatformName.
</p>
<p style="margin:0 0 16px 0;font-family:'Inter',Arial,sans-serif;font-size:15px;line-height:1.6;color:#243b40;">
    Podés ingresar a la plataforma para consultar el documento final y los pasos correspondientes.
</p>
@await Html.PartialAsync("~/Views/Emails/Shared/_CtaButton.cshtml", new CtaButtonModel(Model.CtaUrl, "Ver mi convenio"))
