@using FundingPlatform.Web.Localization
@model FundingPlatform.Web.ViewModels.FundingAgreementDetailsViewModel

@* Spec 021 / US7 / T149 / FR-029 — "Convenio de financiamiento" is the legal
   entity name of the Funding Agreement document. FR-029 carves out the
   Funding Agreement PDF for the legal term; this Details surface is the HTML
   counterpart of that PDF and lives under /FundingAgreement/* — the
   ForbiddenStringsCrawler exempts that URL prefix in US7, so the legal name
   is preserved here intentionally. *@
@{
    ViewData["Title"] = $"Convenio de financiamiento — Solicitud {Model.Panel.ApplicationId}";
}

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: $"Solicitud {Model.Panel.ApplicationId} — Convenio de financiamiento",
        Breadcrumbs: new[]
        {
            new BreadcrumbItem("Inicio", Url.Action("Index", "Home")),
            new BreadcrumbItem("Convenio de financiamiento"),
        }))

@if (!string.IsNullOrWhiteSpace(Model.MissingConversionInlineError))
{
    @* Spec 015 / US5 / T512 / FR-027 — inline error baked directly into the view
       (no TempData redirect) so a hard reload that re-issues the failed POST
       keeps the message until an admin attaches a historical rate (US6). *@
    <div class="alert alert-danger" role="alert"
         data-testid="funding-agreement-missing-conversion-error">
        @Model.MissingConversionInlineError
    </div>
}

@* Spec 027 / US3 — richer applicant detail (screen-only; the PDF document body
   is unchanged per FR-009). Empty optional fields render the neutral "—". *@
@if (Model.ApplicantBlock is { } applicant)
{
    var identificationLabel = applicant.IdentificationType is { } idType
        ? FundingPlatform.Web.ViewModels.LegalIdFieldModel.Label(idType)
        : null;
    string OrDash(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v!;
    <div class="card mb-4" data-testid="fa-applicant-block">
        <div class="card-header">
            <strong>Datos del solicitante</strong>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Empresa solicitante</dt>
                <dd class="col-sm-9" data-testid="fa-applicant-company">@applicant.CompanyName</dd>

                <dt class="col-sm-3 text-muted">Representante</dt>
                <dd class="col-sm-9" data-testid="fa-applicant-representative">@applicant.RepresentativeName</dd>

                <dt class="col-sm-3 text-muted">Identificación</dt>
                <dd class="col-sm-9" data-testid="fa-applicant-legalid">
                    @if (string.IsNullOrWhiteSpace(applicant.LegalId))
                    {
                        <text>—</text>
                    }
                    else
                    {
                        @applicant.LegalId
                        @if (identificationLabel is not null)
                        {
                            <span class="text-muted"> &middot; @identificationLabel</span>
                        }
                    }
                </dd>

                <dt class="col-sm-3 text-muted">Correo electrónico</dt>
                <dd class="col-sm-9" data-testid="fa-applicant-email">@OrDash(applicant.Email)</dd>

                <dt class="col-sm-3 text-muted">Teléfono</dt>
                <dd class="col-sm-9" data-testid="fa-applicant-phone">@OrDash(applicant.Phone)</dd>

                <dt class="col-sm-3 text-muted">Código del solicitante</dt>
                <dd class="col-sm-9" data-testid="fa-applicant-codigo">@OrDash(applicant.CodigoPersonal)</dd>

                <dt class="col-sm-3 text-muted">Grupo</dt>
                <dd class="col-sm-9" data-testid="fa-applicant-group">@applicant.Group</dd>

                <dt class="col-sm-3 text-muted">Fecha de envío</dt>
                <dd class="col-sm-9" data-testid="fa-applicant-submitted">
                    @(applicant.SubmittedAt.HasValue ? applicant.SubmittedAt.Value.ToString("dd/MM/yyyy HH:mm") : "—")
                </dd>
            </dl>
        </div>
    </div>
}

@* Spec 027 / US4 — the approved-only preview table is replaced by the shared
   read-only decision summary (line code, product, category, technical specs,
   supplier, amount + CRC note, status; rejected lines also show the reason and
   every quoted supplier). The PDF document body is unchanged (FR-009). *@
<div class="card mb-4" data-testid="funding-agreement-preview">
    <div class="card-header">
        <strong>Resumen de la solicitud</strong>
        <span class="text-muted ms-2 small">Detalle por línea revisada. El documento PDF conserva su propio formato.</span>
    </div>
    <div class="card-body">
        @if (!Model.HasApplicantResponse)
        {
            <p class="text-muted" data-testid="funding-agreement-preview-awaiting-response">
                A la espera de la respuesta del solicitante. Una vez que el solicitante acepte o rechace los ítems aprobados, aquí se reflejará su decisión por línea.
            </p>
        }

        @await Html.PartialAsync("_DecisionSummary", Model.DecisionSummary)
    </div>
</div>

@await Html.PartialAsync("~/Views/Applications/_FundingAgreementPanel.cshtml", Model.Panel)

<div class="mt-3">
    <a class="btn btn-link" asp-controller="Home" asp-action="Index">&larr; Atrás</a>
</div>
