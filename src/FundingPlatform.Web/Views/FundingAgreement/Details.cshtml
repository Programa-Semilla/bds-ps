@using FundingPlatform.Web.Localization
@model FundingPlatform.Web.ViewModels.FundingAgreementDetailsViewModel

@{
    ViewData["Title"] = $"Convenio de financiamiento — Solicitud N.º {Model.Panel.ApplicationId}";
    var preview = Model.Preview;
    var culture = EsCrCultureFactory.Build();
    string Money(decimal value) => $"₡{value.ToString("N2", culture)}";
}

@await Html.PartialAsync("Components/_PageHeader",
    new PageHeaderViewModel(
        Title: $"Solicitud N.º {Model.Panel.ApplicationId} — Convenio de financiamiento",
        Breadcrumbs: new[]
        {
            new BreadcrumbItem("Inicio", Url.Action("Index", "Home")),
            new BreadcrumbItem("Convenio de financiamiento"),
        }))

@if (!string.IsNullOrWhiteSpace(Model.MissingConversionInlineError))
{
    @* Spec 015 / US5 / T512 / FR-027 — inline error baked directly into the view
       (no TempData redirect) so a hard reload that re-issues the failed POST
       keeps the message until an admin attaches a historical rate (US6). *@
    <div class="alert alert-danger" role="alert"
         data-testid="funding-agreement-missing-conversion-error">
        @Model.MissingConversionInlineError
    </div>
}

<div class="card mb-4" data-testid="funding-agreement-preview">
    <div class="card-header">
        <strong>Resumen del convenio</strong>
        <span class="text-muted ms-2 small">Vista previa de los ítems aprobados que se incluirán en el documento.</span>
    </div>
    <div class="card-body">
        @if (preview is null)
        {
            <p class="text-muted mb-0" data-testid="funding-agreement-preview-unavailable">
                No se pudo cargar el detalle de la solicitud.
            </p>
        }
        else if (!Model.HasApplicantResponse)
        {
            <p class="text-muted mb-0" data-testid="funding-agreement-preview-awaiting-response">
                A la espera de la respuesta del solicitante. Una vez que el solicitante acepte o rechace los ítems aprobados, aquí aparecerá el detalle final del convenio.
            </p>
        }
        else if (preview.ApprovedLines.Count == 0)
        {
            <p class="text-muted mb-0" data-testid="funding-agreement-preview-no-accepted-items">
                El solicitante no aceptó ningún ítem. No hay nada por incluir en el convenio.
            </p>
        }
        else
        {
            <dl class="row mb-3">
                <dt class="col-sm-3">Empresa solicitante</dt>
                <dd class="col-sm-9" data-testid="funding-agreement-preview-company-name">@preview.CompanyName</dd>

                <dt class="col-sm-3">Representante</dt>
                <dd class="col-sm-9" data-testid="funding-agreement-preview-applicant-name">@preview.ApplicantRepresentativeName</dd>
            </dl>

            <div class="table-responsive">
                <table class="table table-vcenter card-table" data-testid="funding-agreement-preview-items">
                    <thead>
                        <tr>
                            <th>Variable</th>
                            <th>Tipo</th>
                            <th>Empresa proveedora</th>
                            <th class="text-end">Desembolso</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in preview.ApprovedLines)
                        {
                            <tr>
                                <td>@line.LineCode</td>
                                <td>@line.ProductName</td>
                                <td>@line.SelectedSupplierName</td>
                                <td class="text-end">@Money(line.Disbursement)</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold" data-testid="funding-agreement-preview-total" data-currency="CRC">
                            <td colspan="3" class="text-end">Total</td>
                            <td class="text-end">@Money(preview.ApprovedDisbursementTotal)</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>
</div>

@await Html.PartialAsync("~/Views/Applications/_FundingAgreementPanel.cshtml", Model.Panel)

<div class="mt-3">
    <a class="btn btn-link" asp-controller="Home" asp-action="Index">&larr; Atrás</a>
</div>
