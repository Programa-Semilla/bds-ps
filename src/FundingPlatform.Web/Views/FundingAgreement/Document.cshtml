@model FundingPlatform.Web.ViewModels.FundingAgreementDocumentViewModel
@{
    Layout = "_FundingAgreementLayout";
}

@*
    Spec 018 — branded "Informe de evaluación de solicitudes de desembolso" PDF.
    The seedling header (FR-001) and partner-strip footer (FR-002) are drawn
    at the renderer level via Syncfusion's PdfPageTemplateElement (R-001-revised
    — `position: fixed` did not repeat across pages in Blink HTML→PDF, so the
    chrome moved out of the HTML body). Section partials below are composed in
    narrative order: cover → intro → recursos → resultados → proveedores →
    declaración jurada. Each section partial owns its own page-break-before
    to keep the structure flat.
*@

@await Html.PartialAsync("Partials/_CoverPage", Model)
@await Html.PartialAsync("Partials/_IntroPage", Model)
@await Html.PartialAsync("Partials/_RequestedResourcesPage", Model)
@await Html.PartialAsync("Partials/_CommitteeResultsPage", Model)
@await Html.PartialAsync("Partials/_SupplierVerificationPage", Model)
@await Html.PartialAsync("Partials/_SwornDeclarationPage", Model)
