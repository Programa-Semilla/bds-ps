@{
    // NFR-001: data-testid slugs MUST stay stable English identifiers even
    // when the visible label is Spanish. Tests assert via testid (e.g.
    // [data-testid="sidebar-entry-review-queue"]); the user-facing label is
    // free to change with localization.
    // Spec 017 / US4 — sidebar entries split into top-level + admin section.
    // The admin section header reuses the legacy slug for back-compat (`admin`)
    // AND publishes the new section testid (`admin-section` per FR-016).
    //
    // Spec 021 / US3 / T111 / FR-007 — SupplierAdmin-only callers see a
    // narrowed sidebar containing just the *Empresas proveedoras* entry (no
    // top-level entries, no admin section header, no other admin children).
    // The role-only check explicitly excludes users who ALSO hold Admin so
    // dual-role platform admins keep the full sidebar.
    var isSupplierAdminOnly = User?.Identity?.IsAuthenticated == true
        && User.IsInRole("Auditor")
        && !User.IsInRole("Admin");

    var topLevelEntries = new List<SidebarEntry>
    {
        new("home", "Inicio", Url.Action("Index", "Home") ?? "/", "ti ti-home", Array.Empty<string>()),
        new("my-applications", "Mis solicitudes", Url.Action("Index", "Application") ?? "/Application", "ti ti-files", new[] { "Applicant" }),
    };

    // Operational queues. Reviewers (non-admin) see these flat at the top level,
    // exactly as before. Admins get them grouped under a collapsible "Operativo"
    // accordion section (rendered below) to keep the admin sidebar shallow. Same
    // slugs in both layouts, so the data-testids stay stable for E2E.
    var operativoEntries = new List<SidebarEntry>
    {
        new("review-queue", "Cola de revisión", Url.Action("Index", "Review") ?? "/Review", "ti ti-clipboard-check", new[] { "Reviewer", "Admin" }),
        // Spec 021 / US6 — the "Generar convenio" queue (Review/GenerateAgreement)
        // had a tab (_ReviewTabs) but no top-level nav, so a reviewer could only
        // reach it by first landing on another Review surface. Icon mirrors the tab.
        new("generate-agreement", "Generar convenio", Url.Action("GenerateAgreement", "Review") ?? "/Review/GenerateAgreement", "ti ti-file-text", new[] { "Reviewer", "Admin" }),
        new("signing-inbox", "Bandeja de firmas", Url.Action("SigningInbox", "Review") ?? "/Review/SigningInbox", "ti ti-signature", new[] { "Reviewer", "Admin" }),
        // Spec 040 / US1 — group-scoped auditor inbox.
        new("audit-inbox", "Auditoría", Url.Action("Index", "Audit") ?? "/Audit", "ti ti-shield-check", new[] { "Auditor", "Admin" }),
    };

    // "Operativo" is a grouping-only header (no landing page of its own); like
    // Administración/Proceso it is an accordion toggle. Admin-only.
    var operativoSectionHeader = new SidebarEntry(
        "operativo", "Operativo", string.Empty, "ti ti-briefcase", new[] { "Admin" });

    var adminSectionHeader = new SidebarEntry(
        "admin", "Administración", Url.Action("Index", "Admin") ?? "/Admin", "ti ti-settings", new[] { "Admin" });

    // Spec 027 / US8 (FR-022/FR-023) — admin nav regrouped into Administración
    // (cross-process admin surfaces) and a new Proceso section. Every prior
    // destination is preserved exactly once; AllowedRoles unchanged. The
    // standalone "Procesos" child is folded into the Proceso section header,
    // which links to /Admin/Processes (so the destination stays reachable).
    var adminEntries = new List<SidebarEntry>
    {
        new("suppliers", "Empresas proveedoras", "/Admin/Suppliers", "ti ti-building-store", new[] { "Admin" }),
        new("plantillas", "Plantillas base", "/Admin/Plantillas", "ti ti-template", new[] { "Admin" }),
        new("reports", "Reportes", "/Admin/Reports", "ti ti-chart-line", new[] { "Admin" }),
        new("currencies", "Monedas", "/Admin/Currencies", "ti ti-coin", new[] { "Admin" }),
        new("exchange-rates", "Tipos de Cambio", "/Admin/ExchangeRates", "ti ti-arrows-exchange", new[] { "Admin" }),
        new("users", "Usuarios", "/Admin/Users", "ti ti-users", new[] { "Admin" }),
        new("system-config", "Configuración del sistema", "/Admin/Configuration", "ti ti-adjustments", new[] { "Admin" }),
    };

    var procesoSectionHeader = new SidebarEntry(
        "proceso", "Proceso", "/Admin/Processes", "ti ti-calendar-event", new[] { "Admin" });

    var procesoEntries = new List<SidebarEntry>
    {
        // Spec 029 — Fondos sit above Procesos in the hierarchy (Fondo → Proceso).
        new("funds", "Fondos", "/Admin/Funds", "ti ti-building-bank", new[] { "Admin" }),
        new("groups", "Grupos", "/Admin/Groups", "ti ti-users-group", new[] { "Admin" }),
        // Spec 027 / US8 — "Starters" surfaces the existing applications listing
        // (Reports → Applications); process-scoped pre-filtering is deferred with
        // the rest of process-scoped Reportes/Plantillas (plan decision #2).
        new("starters", "Starters", "/Admin/Reports/Applications", "ti ti-rocket", new[] { "Admin" }),
        new("impact-templates", "Plantillas de impacto", "/Admin/ImpactTemplates", "ti ti-clipboard-data", new[] { "Admin" }),
        new("categories", "Plantillas de Categorías", "/Admin/Categories", "ti ti-category", new[] { "Admin" }),
        // Spec 040 / US4 — per-stage checklist templates (Revisión / Auditoría / Ambas).
        new("checklists", "Plantillas de checklist", "/Admin/Checklists", "ti ti-checklist", new[] { "Admin" }),
        new("legacy-quotations", "Cotizaciones Pendientes", "/Admin/LegacyQuotations", "ti ti-history", new[] { "Admin" }),
    };

    // Spec 021 / US3 / T111 — for the SupplierAdmin-only path we render a
    // single nav entry (*Empresas proveedoras*) at the top level and no admin
    // section at all. The variant uses its own testid so E2E tests can assert
    // the narrowed sidebar deterministically.
    var supplierAdminEntries = new List<SidebarEntry>
    {
        // Spec 040 / US1 — the auditor's group-scoped audit inbox. The Auditor role now
        // carries workflow duties, so the narrowed (Auditor-only) sidebar surfaces the
        // Auditoría inbox alongside Empresas proveedoras.
        new("audit-inbox", "Auditoría", Url.Action("Index", "Audit") ?? "/Audit", "ti ti-shield-check", new[] { "Auditor", "Admin" }),
        new("supplier-admin-suppliers", "Empresas proveedoras", "/Admin/Suppliers", "ti ti-building-store", new[] { "Auditor", "Admin" }),
    };

    bool IsEntryVisible(SidebarEntry entry)
    {
        if (User?.Identity?.IsAuthenticated != true) return false;
        if (entry.AllowedRoles.Length == 0) return true;
        // Suppress Applicant-only entries when the user is also a Reviewer or Admin —
        // every registered user implicitly holds the Applicant role on signup, so a
        // single role-array check would otherwise show "My Applications" to staff
        // (per contracts/README.md §3 "Reviewer ... does NOT see My Applications").
        if (entry.AllowedRoles.Length == 1
            && entry.AllowedRoles[0] == "Applicant"
            && (User.IsInRole("Reviewer") || User.IsInRole("Admin")))
        {
            return false;
        }
        return entry.AllowedRoles.Any(r => User.IsInRole(r));
    }

    var currentPath = Context.Request.Path.Value ?? "/";
    bool IsActive(string url)
    {
        if (string.Equals(url, "/", StringComparison.OrdinalIgnoreCase))
            return string.Equals(currentPath, "/", StringComparison.OrdinalIgnoreCase);
        return currentPath.StartsWith(url, StringComparison.OrdinalIgnoreCase);
    }
    bool IsActiveExact(string url) => string.Equals(currentPath, url, StringComparison.OrdinalIgnoreCase);

    // Sidebar sections are accordion toggles (no navigation). On load, expand the
    // section that owns the current page; everything else stays collapsed. Proceso
    // is the more specific match (its URLs nest under /Admin), so it wins ties.
    var operativoExpanded = operativoEntries.Any(e => IsActive(e.Url));
    var procesoExpanded = !operativoExpanded
        && (IsActive(procesoSectionHeader.Url) || procesoEntries.Any(e => IsActive(e.Url)));
    var adminExpanded = !operativoExpanded && !procesoExpanded
        && (IsActiveExact(adminSectionHeader.Url) || adminEntries.Any(e => IsActive(e.Url)));
}
<!DOCTYPE html>
<html lang="es-CR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Programa Semilla</title>
    <link rel="icon" type="image/png" href="~/lib/brand/favicons/favicon.png" />
    @* tokens.css MUST load BEFORE Tabler so the --tblr-* bridge in tokens.css applies (spec 019 FR-015). *@
    @* Cache-bust query string from per-build hash (research R12). *@
    <link rel="stylesheet" href="~/css/tokens.css?v=@FundingPlatform.Web.FundingPlatformBuildInfo.Hash" />
    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@* Spec 031 — es-CR defaults for the searchable-dropdown enhancer, surfaced via
   markup so searchable-select.js carries no Spanish literals (FR-010). *@
<body data-searchable-placeholder="@FundingPlatform.Web.Resources.SearchableDropdownResources.SearchPlaceholder"
      data-searchable-empty="@FundingPlatform.Web.Resources.SearchableDropdownResources.NoMatchMessage">
    <div class="page">
        @if (User?.Identity?.IsAuthenticated == true)
        {
            <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark" data-bs-theme="dark" data-testid="sidebar">
                <div class="container-fluid">
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Mostrar u ocultar la navegación">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <h1 class="navbar-brand navbar-brand-autodark">
                        @await Html.PartialAsync("_BrandSidebarHeader")
                    </h1>
                    <div class="collapse navbar-collapse" id="sidebar-menu" data-supplier-admin-only="@(isSupplierAdminOnly ? "true" : "false")">
                        <ul class="navbar-nav pt-lg-3" id="sidebar-accordion">
                            @if (isSupplierAdminOnly)
                            {
                                @* Spec 021 / US3 / T111 / FR-007 — SupplierAdmin sidebar variant.
                                   Only the *Empresas proveedoras* entry is rendered; no admin
                                   section header, no Inicio, no Mis solicitudes. *@
                                foreach (var entry in supplierAdminEntries)
                                {
                                    var active = IsActive(entry.Url) ? " active" : string.Empty;
                                    <li class="nav-item@active" data-testid="sidebar-supplier-admin-variant">
                                        <a class="nav-link" href="@entry.Url" data-testid="sidebar-entry-@entry.Slug">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@entry.Icon"></i></span>
                                            <span class="nav-link-title">@entry.Label</span>
                                        </a>
                                    </li>
                                }
                            }
                            else
                            {
                                foreach (var entry in topLevelEntries.Where(IsEntryVisible))
                                {
                                    var active = IsActive(entry.Url) ? " active" : string.Empty;
                                    <li class="nav-item@active">
                                        <a class="nav-link" href="@entry.Url" data-testid="sidebar-entry-@entry.Slug">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@entry.Icon"></i></span>
                                            <span class="nav-link-title">@entry.Label</span>
                                        </a>
                                    </li>
                                }
                                @* Operativo — admin-only accordion grouping for the operational
                                   queues (Cola de revisión / Generar convenio / Bandeja de firmas).
                                   Reviewers (non-admin) see the very same entries flat at the top
                                   level — the else branch below preserves the legacy layout exactly.
                                   The header is toggle-only (no landing page); accordion behaviour
                                   is shared via #sidebar-accordion in site.js. *@
                                if (User.IsInRole("Admin"))
                                {
                                    <li class="nav-item nav-item-section-header@(operativoExpanded ? " active" : "")">
                                        <a class="nav-link fl-sidebar-section-header@(operativoExpanded ? "" : " collapsed")"
                                           href="#sidebar-section-operativo"
                                           role="button"
                                           data-bs-toggle="collapse"
                                           aria-expanded="@(operativoExpanded ? "true" : "false")"
                                           aria-controls="sidebar-section-operativo"
                                           data-testid="sidebar-entry-@operativoSectionHeader.Slug"
                                           data-section-testid="operativo-section">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@operativoSectionHeader.Icon"></i></span>
                                            <span class="nav-link-title fl-font-display">@operativoSectionHeader.Label</span>
                                            <span class="fl-sidebar-section-caret"><i class="ti ti-chevron-down"></i></span>
                                        </a>
                                    </li>
                                    <li class="nav-item p-0">
                                        <div class="collapse@(operativoExpanded ? " show" : "")" id="sidebar-section-operativo">
                                            <ul class="navbar-nav">
                                                @foreach (var entry in operativoEntries.Where(IsEntryVisible))
                                                {
                                                    var active = IsActive(entry.Url) ? " active" : string.Empty;
                                                    <li class="nav-item nav-item-admin-child@active">
                                                        <a class="nav-link ps-4" href="@entry.Url" data-testid="sidebar-entry-@entry.Slug">
                                                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@entry.Icon"></i></span>
                                                            <span class="nav-link-title">@entry.Label</span>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </li>
                                }
                                else
                                {
                                    @foreach (var entry in operativoEntries.Where(IsEntryVisible))
                                    {
                                        var active = IsActive(entry.Url) ? " active" : string.Empty;
                                        <li class="nav-item@active">
                                            <a class="nav-link" href="@entry.Url" data-testid="sidebar-entry-@entry.Slug">
                                                <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@entry.Icon"></i></span>
                                                <span class="nav-link-title">@entry.Label</span>
                                            </a>
                                        </li>
                                    }
                                }
                                @* Administración — accordion section. The header is a collapse
                                   toggle (no navigation); the section landing (/Admin) is re-added
                                   as the first child so the dashboard stays reachable. Accordion
                                   behaviour (one section open at a time) is enforced in site.js,
                                   scoped to #sidebar-accordion. *@
                                if (IsEntryVisible(adminSectionHeader))
                                {
                                    <li class="nav-item nav-item-section-header@(adminExpanded ? " active" : "")">
                                        <a class="nav-link fl-sidebar-section-header@(adminExpanded ? "" : " collapsed")"
                                           href="#sidebar-section-admin"
                                           role="button"
                                           data-bs-toggle="collapse"
                                           aria-expanded="@(adminExpanded ? "true" : "false")"
                                           aria-controls="sidebar-section-admin"
                                           data-testid="sidebar-entry-@adminSectionHeader.Slug"
                                           data-section-testid="admin-section">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@adminSectionHeader.Icon"></i></span>
                                            <span class="nav-link-title fl-font-display">@adminSectionHeader.Label</span>
                                            <span class="fl-sidebar-section-caret"><i class="ti ti-chevron-down"></i></span>
                                        </a>
                                    </li>
                                    <li class="nav-item p-0">
                                        <div class="collapse@(adminExpanded ? " show" : "")" id="sidebar-section-admin">
                                            <ul class="navbar-nav">
                                                <li class="nav-item nav-item-admin-child@(IsActiveExact(adminSectionHeader.Url) ? " active" : "")">
                                                    <a class="nav-link ps-4" href="@adminSectionHeader.Url" data-testid="sidebar-entry-admin-home">
                                                        <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="ti ti-layout-dashboard"></i></span>
                                                        <span class="nav-link-title">Panel</span>
                                                    </a>
                                                </li>
                                                @foreach (var entry in adminEntries.Where(IsEntryVisible))
                                                {
                                                    var active = IsActive(entry.Url) ? " active" : string.Empty;
                                                    <li class="nav-item nav-item-admin-child@active">
                                                        <a class="nav-link ps-4" href="@entry.Url" data-testid="sidebar-entry-@entry.Slug">
                                                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@entry.Icon"></i></span>
                                                            <span class="nav-link-title">@entry.Label</span>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </li>
                                }
                                @* Spec 027 / US8 — Proceso section (Admin only). Accordion toggle;
                                   the /Admin/Processes landing is re-added as the first child. *@
                                if (IsEntryVisible(procesoSectionHeader))
                                {
                                    <li class="nav-item nav-item-section-header@(procesoExpanded ? " active" : "")">
                                        <a class="nav-link fl-sidebar-section-header@(procesoExpanded ? "" : " collapsed")"
                                           href="#sidebar-section-proceso"
                                           role="button"
                                           data-bs-toggle="collapse"
                                           aria-expanded="@(procesoExpanded ? "true" : "false")"
                                           aria-controls="sidebar-section-proceso"
                                           data-testid="sidebar-entry-@procesoSectionHeader.Slug"
                                           data-section-testid="proceso-section">
                                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@procesoSectionHeader.Icon"></i></span>
                                            <span class="nav-link-title fl-font-display">@procesoSectionHeader.Label</span>
                                            <span class="fl-sidebar-section-caret"><i class="ti ti-chevron-down"></i></span>
                                        </a>
                                    </li>
                                    <li class="nav-item p-0">
                                        <div class="collapse@(procesoExpanded ? " show" : "")" id="sidebar-section-proceso">
                                            <ul class="navbar-nav">
                                                <li class="nav-item nav-item-admin-child@(IsActive(procesoSectionHeader.Url) ? " active" : "")">
                                                    <a class="nav-link ps-4" href="@procesoSectionHeader.Url" data-testid="sidebar-entry-processes">
                                                        <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@procesoSectionHeader.Icon"></i></span>
                                                        <span class="nav-link-title">Procesos</span>
                                                    </a>
                                                </li>
                                                @foreach (var entry in procesoEntries.Where(IsEntryVisible))
                                                {
                                                    var active = IsActive(entry.Url) ? " active" : string.Empty;
                                                    <li class="nav-item nav-item-admin-child@active">
                                                        <a class="nav-link ps-4" href="@entry.Url" data-testid="sidebar-entry-@entry.Slug">
                                                            <span class="nav-link-icon d-md-none d-lg-inline-block"><i class="@entry.Icon"></i></span>
                                                            <span class="nav-link-title">@entry.Label</span>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </li>
                                }
                            }
                        </ul>
                    </div>
                </div>
            </aside>
        }
        <header class="navbar navbar-expand-md d-print-none" data-testid="topbar">
            <div class="container-xl">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @* data-testid is "topbar-title" — the canonical page-title testid
                   belongs to the _PageHeader h2 (the semantic page heading). Two
                   elements sharing data-testid="page-title" tripped Playwright
                   strict-mode in the E2E suite. *@
                <div class="page-title mb-0 fs-3" data-testid="topbar-title">@ViewData["Title"]</div>
                <div class="navbar-nav flex-row order-md-last">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <div class="nav-item d-flex align-items-center px-2">
                            <span class="text-secondary">@User.Identity.Name</span>
                        </div>
                        <div class="nav-item d-flex align-items-center">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-link nav-link">
                                    <i class="ti ti-logout me-1"></i> Cerrar sesión
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                        </div>
                        @* Spec 032 — public self-registration removed; no "Crear cuenta" nav link. *@
                    }
                </div>
            </div>
        </header>
        <div class="page-wrapper">
            <div class="container-xl py-3" data-testid="breadcrumbs">
                @await RenderSectionAsync("Breadcrumbs", required: false)
            </div>
            <div class="page-body">
                <div class="container-xl">
                    @* Spec 024 — result messages now surface as toasts via _ToastContainer (top-right), not banner alerts. *@
                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
            </div>
            @* Spec 019 FR-003 — sponsor partner-logo strip above the legal/copyright line. *@
            @await Html.PartialAsync("_SponsorStrip")
            <footer class="footer footer-transparent">
                <div class="container-xl">
                    <div class="text-secondary text-center py-3 fl-type-meta">&copy; 2026 Programa Semilla &middot; Sistema de Banca para el Desarrollo</div>
                </div>
            </footer>
        </div>
    </div>
    @* Spec 024 — unified notifications + confirmation surfaces (rendered once per layout). *@
    @await Html.PartialAsync("_ToastContainer")
    @await Html.PartialAsync("Components/_SharedConfirmModal")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/tabler/dist/js/tabler.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/confirm-dialog.js" asp-append-version="true"></script>
    <script src="~/js/hint-tooltip.js" asp-append-version="true"></script>
    @* Spec 031 — global searchable-dropdown enhancer; opt-in per <select data-searchable>. *@
    <script src="~/js/searchable-select.js" asp-append-version="true" defer></script>
    <script src="~/lib/canvas-confetti/canvas-confetti.min.js" defer></script>
    <script src="~/js/motion.js" asp-append-version="true" defer></script>
    <script src="~/js/facelift-init.js" asp-append-version="true" defer></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
