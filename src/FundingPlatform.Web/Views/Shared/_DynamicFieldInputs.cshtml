@* Spec 035 / US2 — server-renders pre-filled dynamic field inputs (Edit pre-fill
   + validation-error re-render). Naming matches dynamic-fields.js so posts bind to
   the same Dictionary<int,string?>. *@
@model (List<FundingPlatform.Web.ViewModels.DynamicFieldInput> Fields, string NamePrefix)

@foreach (var field in Model.Fields)
{
    var name = $"{Model.NamePrefix}[{field.FieldId}]";
    var (type, step) = field.DataType switch
    {
        1 => ("number", "0.01"),
        2 => ("number", "1"),
        3 => ("date", (string?)null),
        _ => ("text", (string?)null),
    };
    <div class="mb-3">
        <label class="form-label">
            @field.DisplayLabel
            @if (field.IsRequired)
            {
                <span class="text-danger">*</span>
            }
        </label>
        <input type="@type" name="@name" value="@field.Value" class="form-control"
               data-dynamic-field="1" step="@step" required="@field.IsRequired" />
    </div>
}
