@using FundingPlatform.Application.DTOs
@model ApplicationCardDto
@{
    var primaryClass = Model.PrimaryAction.Style == ContextualActionStyle.Primary ? "btn btn-primary" : "btn btn-outline-secondary";
    // Derive the pill tone from the current journey node's color token so the
    // card mirrors the canonical stage-mapping (FR-036), not a hard-coded value.
    var currentNode = Model.JourneyMini?.Mainline?.FirstOrDefault(n => n.State == JourneyNodeState.Current);
    string stageTone = currentNode?.ColorToken switch
    {
        "--color-success" => "success",
        "--color-warning" => "warning",
        "--color-danger"  => "danger",
        "--color-info"    => "info",
        "--color-text-secondary" => "muted",
        _                 => "primary",
    };
}
<article class="fl-app-card" data-testid="application-card" data-application-number="@Model.ApplicationNumber">
    <header class="d-flex justify-content-between align-items-start mb-3 flex-wrap fl-gap-2">
        <div>
            <div class="fl-app-card-mono fl-type-meta" data-testid="application-number">@Model.ApplicationNumber</div>
            <h3 class="fl-app-card-title" data-testid="application-card-title">@Model.ProjectName</h3>
        </div>
        <span class="fl-status-pill" data-tone="@stageTone" data-testid="application-card-stage">@Model.CurrentStageLabel</span>
    </header>

    <div class="mb-3">
        @await Html.PartialAsync("Components/_ApplicationJourney", Model.JourneyMini)
    </div>

    <div class="d-flex justify-content-between align-items-center flex-wrap fl-gap-3">
        <div class="fl-app-card-meta" data-testid="application-card-meta">
            <span data-testid="days-in-state">@Model.DaysInCurrentState días en el estado actual</span>
            <span class="mx-2">&middot;</span>
            <span data-testid="last-activity">Última actividad @Model.LastActivity.LocalDateTime.ToString("dd/MM/yyyy")</span>
            @if (Model.TotalConvertedCrc.HasValue)
            {
                <span class="mx-2">&middot;</span>
                @* Spec 015 / T414 — application-level CRC total summed via the multi-currency
                   rollup. originalCurrency = null routes the component into the CRC-only path. *@
                <span data-testid="application-card-total">
                    Total
                    @await Component.InvokeAsync("MoneyDisplay", new
                    {
                        original = Model.TotalConvertedCrc,
                        originalCurrency = (FundingPlatform.Domain.ValueObjects.CurrencyCode?)null,
                        convertedCrc = Model.TotalConvertedCrc,
                        snapshot = (FundingPlatform.Domain.ValueObjects.ExchangeRateSnapshot?)null
                    })
                    @if (Model.HasNonCrcQuotation)
                    {
                        <span class="badge bg-info-lt ms-1" data-testid="application-card-multicurrency-badge">multimoneda</span>
                    }
                </span>
            }
        </div>
        <a class="@primaryClass" href="@Model.PrimaryAction.Href" data-testid="application-card-action">@Model.PrimaryAction.Label</a>
    </div>
</article>
