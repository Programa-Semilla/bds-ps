@*
    _PasswordStrengthLegend.cshtml — Spec 021 / T057 / FR-027.

    Renders the four password rules as a checklist. Each <li> carries
    `data-rule="..."` so `password-strength-legend.js` can toggle the
    `.ok` class as the user types into the bound input.

    The host page passes the legend's id (or any selector) to the bound
    input via `data-strength-legend="#legend-id"` so the script can find
    this element from the input.
*@
@{
    var legendId = ViewData["LegendId"] as string ?? "password-strength-legend";
}
<ul id="@legendId" class="list-unstyled fl-password-strength-legend" data-testid="password-strength-legend">
    <li data-rule="min8">
        <i class="ti ti-circle me-1" aria-hidden="true"></i>
        Mínimo 8 caracteres
    </li>
    <li data-rule="upper">
        <i class="ti ti-circle me-1" aria-hidden="true"></i>
        Una mayúscula
    </li>
    <li data-rule="digit">
        <i class="ti ti-circle me-1" aria-hidden="true"></i>
        Un número
    </li>
    <li data-rule="special">
        <i class="ti ti-circle me-1" aria-hidden="true"></i>
        Un carácter especial
    </li>
</ul>
