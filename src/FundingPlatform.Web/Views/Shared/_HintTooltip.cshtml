@*
    Spec 021 / FR-020 + Spec 027 / US7 — `_HintTooltip` partial.

    Renders an info icon (`ti ti-info-circle`) beside a form field. Hovering or
    focusing the icon shows an HTML-capable bubble driven by `hint-tooltip.js`
    (own JS, no `window.bootstrap`). The copy is resolved from the static es-CR
    `HintCopy` provider (NOT `IStringLocalizer` — unwired per NFR-003), keyed by
    either the `[Hint("<key>")]` attribute on the bound property or an explicit
    `ResourceKeyOverride`. When no copy exists for the key, the partial renders
    nothing (the field stays clean).

    Usage:
        @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(
            ResourceKeyOverride: "Register.Email"))
      or, resolving via the property's [Hint] attribute:
        @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(
            typeof(MyViewModel), nameof(MyViewModel.ProductName)))
*@

@using System.Reflection
@using FundingPlatform.Domain.Attributes
@using FundingPlatform.Web.Resources
@model FundingPlatform.Web.ViewModels.HintTooltipModel

@functions {
    static string? ResolveResourceKey(FundingPlatform.Web.ViewModels.HintTooltipModel m)
    {
        if (!string.IsNullOrWhiteSpace(m.ResourceKeyOverride))
        {
            return m.ResourceKeyOverride;
        }
        if (m.ContainerType is null || string.IsNullOrWhiteSpace(m.PropertyName))
        {
            return null;
        }
        var prop = m.ContainerType.GetProperty(
            m.PropertyName!,
            BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic);
        var hint = prop?.GetCustomAttribute<HintAttribute>();
        return hint?.ResourceKey;
    }
}

@{
    var key = ResolveResourceKey(Model);
    // Spec 027 / US7 — resolve from the static es-CR copy provider. Curated HTML,
    // never user input, so it is safe to render as HTML in the tooltip bubble.
    var copy = HintCopy.Get(key);
}

@if (!string.IsNullOrWhiteSpace(copy))
{
    <span class="form-hint-icon ms-1" data-hint="@copy" data-hint-key="@key"
          tabindex="0" role="button" aria-label="Más información">
        <i class="ti ti-info-circle text-muted"></i>
    </span>
}
