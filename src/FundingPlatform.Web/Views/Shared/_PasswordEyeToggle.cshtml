@*
    _PasswordEyeToggle.cshtml — Spec 021 / T058 / FR-026.

    Inline eye-toggle button for every password input on the platform
    (Login, Register, Profile/ChangePassword, ResetPassword).

    Host code passes the target input's id via `ViewData["EyeTarget"]`,
    e.g. `@await Html.PartialAsync("_PasswordEyeToggle", new ViewDataDictionary(ViewData) { { "EyeTarget", "#password" } })`.

    `password-eye-toggle.js` listens on `.password-eye-toggle` clicks,
    swaps the target input's `type` between `password` and `text`, and
    toggles the Tabler eye / eye-off icons.
*@
@{
    var target = ViewData["EyeTarget"] as string ?? "#password";
}
<button type="button"
        class="btn btn-link password-eye-toggle p-1 text-muted"
        data-target="@target"
        aria-label="Mostrar u ocultar contraseña">
    <i class="ti ti-eye" aria-hidden="true" data-eye-icon></i>
</button>
