@*
    _BrandSidebarHeader.cshtml — sidebar brand header.

    Spec 037: renders the OFFICIAL Programa Semilla horizontal logo inside a
    white rounded container (.fl-sidebar-brand styled in site.css) for contrast
    on the dark-teal sidebar. The logo art already includes the wordmark, so the
    "Programa Semilla" text node is retained but visually hidden — it remains the
    FR-033 brand-presence assertion target ([data-testid="sidebar-brand"] must
    contain text "Programa Semilla"). title + data-testid preserved.
*@
<a class="fl-sidebar-brand"
   href="@(Url.Action("Index", "Home") ?? "/")"
   title="Programa Semilla"
   data-testid="sidebar-brand">
    <img src="~/lib/brand/programa-semilla-horizontal.png" class="fl-sidebar-brand-logo" alt="Programa Semilla" />
    <span class="fl-sidebar-brand-wordmark visually-hidden">Programa Semilla</span>
</a>
