@using FundingPlatform.Web.Helpers
@model FundingPlatform.Web.ViewModels.IQuoteFieldsModel

@* Spec 023 / FR-003 — shared Price / Currency / ValidUntil block. Consumed by
   Supplier/Add.cshtml (create flow) and Quotation/Edit.cshtml (edit flow). The
   conversion-preview alert below uses the same data-* contract as Supplier/Add,
   so quote-conversion-preview.js wires up the live preview unchanged. *@
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Price" class="form-label"></label> @await Html.PartialAsync("_RequiredMark") @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(ResourceKeyOverride: "Supplier.Price"))
        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01"
               data-testid="quotation-price-input" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3" data-testid="form-section" data-field="Currency">
        <label asp-for="Currency" class="form-label"></label> @await Html.PartialAsync("_RequiredMark") @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(ResourceKeyOverride: "Supplier.Currency"))
        @if (Model.EnabledCurrencies.Count > 0)
        {
            <select asp-for="Currency" class="form-select" data-testid="quotation-currency-input" data-searchable>
                @foreach (var option in Model.EnabledCurrencies)
                {
                    <option value="@option.Code">@option.Symbol @option.DisplayName (@option.Code)</option>
                }
            </select>
        }
        else
        {
            @* Defensive fallback when the catalog has not been seeded yet. *@
            <input asp-for="Currency" class="form-control" maxlength="3" data-testid="quotation-currency-input" />
            <small class="form-hint">ISO 4217 (p. ej., CRC, USD)</small>
        }
        <span asp-validation-for="Currency" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="ValidUntil" class="form-label"></label> @await Html.PartialAsync("_RequiredMark") @await Html.PartialAsync("_HintTooltip", new HintTooltipModel(ResourceKeyOverride: "Supplier.ValidUntil"))
        <input asp-for="ValidUntil" class="form-control" type="date" data-testid="quotation-validuntil-input" />
        <span asp-validation-for="ValidUntil" class="text-danger"></span>
    </div>
</div>

@* Spec 039 — required delivery lead time + warranty time (value + unit días/meses). *@
<div class="row">
    <div class="col-md-6 mb-3" data-testid="form-section" data-field="DeliveryLeadTime">
        <label asp-for="DeliveryLeadTimeValue" class="form-label"></label> @await Html.PartialAsync("_RequiredMark")
        <div class="input-group">
            @* No HTML5 min so a 0/blank value reaches the server, which is the
               authoritative es-CR validator (FR-026); the domain also rejects ≤0. *@
            <input asp-for="DeliveryLeadTimeValue" class="form-control" type="number" step="1"
                   data-testid="quotation-delivery-value-input" />
            <select asp-for="DeliveryLeadTimeUnit" class="form-select"
                    asp-items="DurationUnitLabels.Items(Model.DeliveryLeadTimeUnit)"
                    data-testid="quotation-delivery-unit-input"></select>
        </div>
        <span asp-validation-for="DeliveryLeadTimeValue" class="text-danger"></span>
    </div>
    <div class="col-md-6 mb-3" data-testid="form-section" data-field="Warranty">
        <label asp-for="WarrantyValue" class="form-label"></label> @await Html.PartialAsync("_RequiredMark")
        <div class="input-group">
            <input asp-for="WarrantyValue" class="form-control" type="number" step="1"
                   data-testid="quotation-warranty-value-input" />
            <select asp-for="WarrantyUnit" class="form-select"
                    asp-items="DurationUnitLabels.Items(Model.WarrantyUnit)"
                    data-testid="quotation-warranty-unit-input"></select>
        </div>
        <span asp-validation-for="WarrantyValue" class="text-danger"></span>
    </div>
</div>

@* Spec 015 / FR-019 — server-rendered conversion preview. Hidden for CRC and
   on missing/zero price; populated by quote-conversion-preview.js via
   POST /Quotation/Convert. *@
<div class="mb-3 alert alert-info d-none" data-quote-preview hidden>
    <div class="fw-semibold">Conversión a colones</div>
    <div data-preview-amount class="fs-4"></div>
    <div data-preview-rate class="text-muted small"></div>
    <div data-preview-status class="small"></div>
</div>
