@*
    _AuthLayout — auth-shell layout for Login / Register / Reset Password / Confirm Email.
    Spec 019 FR-004: hero left-rail (mark + Programa Semilla wordmark + tagline) on left,
    auth card on right, sponsor strip in footer. Below 768 px, columns stack to a single
    column with the hero on top.
*@
<!DOCTYPE html>
<html lang="es-CR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Programa Semilla</title>
    <link rel="icon" type="image/png" href="~/lib/brand/favicons/favicon.png" />
    @* tokens.css MUST load BEFORE Tabler so the --tblr-* bridge applies. *@
    <link rel="stylesheet" href="~/css/tokens.css?v=@FundingPlatform.Web.FundingPlatformBuildInfo.Hash" />
    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="~/lib/tabler/dist/css/tabler-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column">
    <div class="fl-auth-shell" data-testid="auth-shell">
        <aside class="fl-auth-hero" data-testid="auth-hero" aria-label="Programa Semilla">
            @* Spec 037 — official vertical logo (disc + wordmark lockup). *@
            <img src="~/lib/brand/programa-semilla-vertical.png" class="fl-auth-hero-logo" alt="Programa Semilla" />
            @* Spec 021 / FR-029 — replaced "Financiamiento" with "Acompañamiento". *@
            <p class="fl-auth-hero-tagline">
                Acompañamiento para emprendedores en Costa Rica.<br />
                <em>Sistema de Banca para el Desarrollo</em>
            </p>
        </aside>
        <section class="fl-auth-content">
            <div class="fl-auth-card">
                @* Spec 024 — result messages surface as toasts via _ToastContainer (top-right), not inline alerts. *@
                <main role="main">
                    @RenderBody()
                </main>
            </div>
        </section>
    </div>
    @* Spec 019 FR-004 — sponsor strip on auth surfaces (low cost, high brand introduction). *@
    @await Html.PartialAsync("_SponsorStrip")
    @* Spec 024 — unified notifications + confirmation surfaces (rendered once per layout). *@
    @await Html.PartialAsync("_ToastContainer")
    @await Html.PartialAsync("Components/_SharedConfirmModal")
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/tabler/dist/js/tabler.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/confirm-dialog.js" asp-append-version="true"></script>
    @* Spec 027 / US7 — Register (and other auth pages) carry applicant-field
       tooltips; the hint module must load here too, not only in _Layout. *@
    <script src="~/js/hint-tooltip.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
