{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Syncfusion": {
    "LicenseKey": ""
  },
  "FundingAgreement": {
    "LocaleCode": "es-CR",
    "CurrencyIsoCode": "CRC",
    "Funder": {
      "LegalName": "Funder Legal Name (Dev)",
      "TaxId": "000000000-0",
      "Address": "Funder address placeholder (Dev)",
      "ContactEmail": "contact@funder.example",
      "ContactPhone": "+00 000 000 0000"
    }
  },
  "AdminReports": {
    "DefaultCurrency": "CRC",
    "CsvRowLimit": 50000
  },
  "Notifications": {
    "Provider": "Mailtrap",
    "BaseUrl": "http://localhost:5000",
    "NonProdAllowlist": [ "@programa-semilla.test" ],
    "Mailtrap": {
      "Host": "localhost",
      "Port": 25
    },
    "Worker": {
      "PollIntervalSeconds": 5,
      "MaxAttempts": 3,
      "BatchSize": 25
    },
    "Sender": {
      "Name": "Programa Semilla / Sistema de Banca para el Desarrollo",
      "Email": "no-reply@programa-semilla.test"
    }
  }
}
