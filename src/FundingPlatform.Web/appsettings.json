{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FundingPlatform.Infrastructure.Notifications": "Debug",
      "FundingPlatform.Application.Services": "Information"
    }
  },
  "AllowedHosts": "*",
  "Syncfusion": {
    "LicenseKey": ""
  },
  "FundingAgreement": {
    "LocaleCode": "es-CR",
    "CurrencyIsoCode": "CRC",
    "Funder": {
      "LegalName": "Funder Legal Name",
      "TaxId": "000000000-0",
      "Address": "Funder address placeholder",
      "ContactEmail": "contact@funder.example",
      "ContactPhone": "+00 000 000 0000"
    }
  },
  "SignedUpload": {
    "MaxSizeBytes": 20971520
  },
  "AdminReports": {
    "DefaultCurrency": "CRC",
    "CsvRowLimit": 50000
  },
  "Storage": {
    "Categories": {
      "PublicLandingFile": {
        "MaxSizeBytes": 10485760,
        "UrlExpirySeconds": 300,
        "RetentionPolicy": "none"
      }
    }
  },
  "Notifications": {
    "Provider": "Mailtrap",
    "BaseUrl": "https://localhost:5001",
    "NonProdAllowlist": [ "@programa-semilla.test" ],
    "Mailgun": {
      "ApiKey": "",
      "Domain": "",
      "BaseUrl": "https://api.mailgun.net/v3"
    },
    "Mailtrap": {
      "Host": "localhost",
      "Port": 25,
      "Username": "",
      "Password": ""
    },
    "Worker": {
      "PollIntervalSeconds": 5,
      "MaxAttempts": 3,
      "BatchSize": 25
    },
    "Sender": {
      "Name": "Programa Semilla / Sistema de Banca para el Desarrollo",
      "Email": "no-reply@programa-semilla.cr"
    }
  }
}
