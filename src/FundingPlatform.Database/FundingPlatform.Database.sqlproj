<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build">
  <Sdk Name="Microsoft.Build.Sql" Version="2.1.0" />
  <PropertyGroup>
    <Name>FundingPlatform.Database</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.Sql160DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <ProjectGuid>F6F85550-AAEB-405C-920A-DF2C68F25170</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="PostDeployment\SeedData.sql" />
    <PostDeploy Include="PostDeployment\SeedData.sql" />
    <!-- Spec 021 — additional post-deploy seed scripts included via SqlCmd :r
         from SeedData.sql (the single PostDeploy script supported by
         Microsoft.Build.Sql 2.1.0). Each file is removed from the default
         Build glob (it is seed data, not schema), and re-added as a None item
         so the dacpac packs it alongside SeedData.sql for the :r directive to
         resolve at deploy time. -->
    <Build Remove="PostDeployment\01_SeedProvincesCantons.sql" />
    <Build Remove="PostDeployment\02_SeedMigracionInicialProcess.sql" />
    <Build Remove="PostDeployment\03_SeedSupplierAdminRole.sql" />
    <!-- Spec 025 — distrito catalog seed (third cascade tier), :r-included from SeedData.sql. -->
    <Build Remove="PostDeployment\04_SeedDistricts.sql" />
    <!-- Spec 038 — guarded drop of the four legacy BIT compliance columns (prod no-drop publish). -->
    <Build Remove="PostDeployment\06_DropLegacySupplierComplianceColumns.sql" />
    <!-- Spec 040 — default checklist template + items seed, :r-included from SeedData.sql. -->
    <Build Remove="PostDeployment\07_SeedChecklistTemplates.sql" />
    <!-- Sample suppliers with specific regulatory profiles, :r-included from SeedData.sql. -->
    <Build Remove="PostDeployment\08_SeedSuppliers.sql" />
    <!-- Spec 045 — group-scoped Financial Operator role seed, :r-included from SeedData.sql. -->
    <Build Remove="PostDeployment\10_SeedFinancialOperatorRole.sql" />
    <!-- Spec 047 — global-default required-document rule set seed, :r-included from SeedData.sql. -->
    <Build Remove="PostDeployment\11_SeedDocumentRules.sql" />
    <None Include="PostDeployment\01_SeedProvincesCantons.sql" />
    <None Include="PostDeployment\02_SeedMigracionInicialProcess.sql" />
    <None Include="PostDeployment\03_SeedSupplierAdminRole.sql" />
    <None Include="PostDeployment\04_SeedDistricts.sql" />
    <None Include="PostDeployment\06_DropLegacySupplierComplianceColumns.sql" />
    <None Include="PostDeployment\07_SeedChecklistTemplates.sql" />
    <None Include="PostDeployment\08_SeedSuppliers.sql" />
    <None Include="PostDeployment\10_SeedFinancialOperatorRole.sql" />
    <None Include="PostDeployment\11_SeedDocumentRules.sql" />
  </ItemGroup>
  <ItemGroup>
    <SqlCmdVariable Include="DefaultCurrency">
      <DefaultValue>COP</DefaultValue>
      <Value>$(SqlCmdVar__DefaultCurrency)</Value>
    </SqlCmdVariable>
  </ItemGroup>
</Project>